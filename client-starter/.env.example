# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables.
# Só é necessário quando contact.form.provider é 'resend' ou 'webhook'
# (src/pages/api/lead.ts). Para 'whatsapp' | 'formspree' | 'web3forms' nada aqui é usado.

# --- provider 'resend': e-mail via https://resend.com ---
RESEND_API_KEY=
# caixa que recebe os leads (vários separados por vírgula)
LEAD_TO=
# remetente verificado no Resend, ex.: Site <leads@__DOMAIN__>
LEAD_FROM=
# prefixo do assunto do e-mail (padrão: Site)
SITE_NAME=__CLIENT__

# --- provider 'webhook': quando definido, o lead é POSTado aqui e nenhum e-mail é enviado ---
LEAD_WEBHOOK_URL=

# --- opcional: sobrescreve `site` em astro.config.mjs (padrão https://__DOMAIN__) ---
SITE_URL=https://__DOMAIN__
