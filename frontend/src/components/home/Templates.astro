---
/**
 * Home band — "Templates · sites prontos em dias".
 * One list of cards: a two-column grid from 900px up (with an odd count the
 * first card goes wide, so none is left alone), a snap scroller below that
 * (touch scrolls natively, mouse can drag, prev/next buttons for everyone).
 * Cards reveal with a stagger (.reveal .d1–.d3 from site.css).
 */
import { scoresFor } from '../../data/lighthouse';
import { SITE } from '../../data/site';
import { formatBRL, templates } from '../../data/templates';
import { fmt, localeOf, localePath, pick, useT } from '../../i18n';
import TemplateCard from '../templates/TemplateCard.astro';

const locale = localeOf(Astro);
const t = useT(locale);

const n = templates.length;
const nWord = t.templates.numberWords[n] ?? String(n);
const NWord = nWord.charAt(0).toUpperCase() + nWord.slice(1);
const prices = templates.map((tpl) => tpl.priceFrom);
const lead = fmt(t.templates.band.lead, {
	N: NWord,
	n: nWord,
	days: pick(SITE.promises.templateDays, locale),
	min: formatBRL(Math.min(...prices)),
	max: formatBRL(Math.max(...prices)),
});

// Proof line: only when every template has a measured score and the lowest is green.
const mobileScores = templates.map((tpl) => scoresFor(tpl.slug)?.mobile);
const minScore = mobileScores.every((s) => s !== undefined) ? Math.min(...(mobileScores as number[])) : 0;
const scoreLine = minScore >= 90 ? fmt(t.templates.band.scoreLine, { min: minScore }) : null;
---

<section class='tpl-band' id='templates' aria-labelledby='templates-title'>
	<div class='inner'>
		<div class='sec-head reveal'>
			<span class='eyebrow accent'><i class='live-dot' aria-hidden='true'></i>{t.templates.band.eyebrow}</span>
			<h2 id='templates-title'>
				{t.templates.band.head} <span class='hl'>{t.templates.band.headAccent}</span>
			</h2>
			<p>{lead}</p>
			{
				scoreLine && (
					<p class='lh-proof'>
						<i aria-hidden='true' />
						{scoreLine}
					</p>
				)
			}
		</div>

		<ul class='scroller' id='tpl-scroller' role='list' aria-label={t.templates.band.listLabel}>
			{
				templates.map((tpl, i) => (
					<li class:list={['tpl-item', 'reveal', i > 0 && `d${Math.min(i, 3)}`, i === 0 && n % 2 === 1 && 'is-wide']}>
						<TemplateCard tpl={tpl} locale={locale} heading='h3' wide={i === 0 && n % 2 === 1} />
					</li>
				))
			}
		</ul>

		<div class='band-foot reveal d1'>
			<a href={localePath(locale, '/templates')} class='btn-link'>{t.templates.band.viewAll}</a>
			<div class='scroller-nav'>
				<button type='button' data-scroll='prev' data-for='#tpl-scroller' aria-label={t.templates.band.scrollPrev}>
					<span aria-hidden='true'>←</span>
				</button>
				<button type='button' data-scroll='next' data-for='#tpl-scroller' aria-label={t.templates.band.scrollNext}>
					<span aria-hidden='true'>→</span>
				</button>
			</div>
		</div>
	</div>
</section>

<style>
	.tpl-band {
		padding: 120px 0;
		/* very light band tint so the row reads as its own stage */
		background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 60%);
	}
	.inner {
		max-width: var(--maxw);
		margin: 0 auto;
	}
	.sec-head {
		padding: 0 32px;
	}

	/* Live dot in the eyebrow */
	.live-dot {
		position: relative;
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-right: 9px;
		border-radius: 50%;
		background: var(--accent);
		vertical-align: 1px;
	}
	.live-dot::after {
		content: '';
		position: absolute;
		inset: -3px;
		border-radius: 50%;
		border: 1.5px solid var(--accent);
		opacity: 0;
		animation: live-ping 2.2s var(--ease-out-expo) infinite;
	}
	@keyframes live-ping {
		0% {
			transform: scale(0.4);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.8);
			opacity: 0;
		}
	}

	/* Measured Lighthouse floor under the lead */
	.sec-head .lh-proof {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin-top: 18px;
		max-width: 100%;
		padding: 7px 14px 7px 11px;
		border-radius: 999px;
		background: var(--bg-3);
		border: 1px solid var(--rule-2);
		font-family: var(--mono);
		font-size: 12px;
		line-height: 1.4;
		color: var(--ink-2);
	}
	.lh-proof i {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #0cce6b;
		box-shadow: 0 0 0 3px rgba(12, 206, 107, 0.18);
	}

	/* Mobile / tablet: snap scroller */
	.scroller {
		list-style: none;
		display: flex;
		gap: 20px;
		padding: 12px 32px 32px;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 32px;
		-webkit-overflow-scrolling: touch;
		touch-action: pan-x pan-y;
		scrollbar-width: none;
		cursor: grab;
		user-select: none;
	}
	.scroller.is-dragging {
		cursor: grabbing;
		scroll-snap-type: none;
	}
	.scroller::-webkit-scrollbar {
		display: none;
	}
	.tpl-item {
		display: flex;
		flex: 0 0 min(84vw, 420px);
		scroll-snap-align: start;
	}
	.tpl-item > :global(.tpl-card) {
		width: 100%;
	}

	.band-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 8px 32px 0;
	}
	.scroller-nav {
		display: flex;
		gap: 10px;
	}
	.scroller-nav button {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--rule-2);
		background: var(--bg-3);
		color: var(--ink);
		font-size: 18px;
		line-height: 1;
		display: grid;
		place-items: center;
		transition:
			background 0.25s,
			border-color 0.25s,
			color 0.25s,
			transform 0.3s var(--ease-out-expo);
	}
	.scroller-nav button span {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-expo);
	}
	.scroller-nav button:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
		transform: translateY(-2px);
	}
	.scroller-nav button:hover[data-scroll='prev'] span {
		transform: translateX(-3px);
	}
	.scroller-nav button:hover[data-scroll='next'] span {
		transform: translateX(3px);
	}
	.scroller-nav button:active {
		transform: translateY(0) scale(0.96);
	}

	/* Desktop: 2×2 grid, no scrolling */
	@media (min-width: 900px) {
		.scroller {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 28px;
			padding: 8px 32px 0;
			overflow: visible;
			scroll-snap-type: none;
			cursor: default;
			user-select: auto;
		}
		.tpl-item {
			flex: initial;
		}
		/* odd count: the first (newest) card takes the whole row */
		.tpl-item.is-wide {
			grid-column: 1 / -1;
		}
		.scroller-nav {
			display: none;
		}
		.band-foot {
			padding-top: 40px;
		}
	}

	@media (max-width: 600px) {
		.tpl-band {
			padding: 96px 0;
		}
		.sec-head,
		.band-foot {
			padding-left: 20px;
			padding-right: 20px;
		}
		.scroller {
			padding-left: 20px;
			padding-right: 20px;
			scroll-padding-inline: 20px;
		}
	}
</style>
