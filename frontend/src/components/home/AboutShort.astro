---
/**
 * #sobre — one human paragraph + availability + link to /about.
 * The long story (career, hobbies) lives in /about, not here.
 */
import { SITE } from '../../data/site';
import { localeOf, localePath, pick, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
---

<section class='about-band' id='sobre' aria-labelledby='about-short-title'>
	<div class='about-inner'>
		<div class='about-quote-col reveal'>
			<h2 class='eyebrow accent' id='about-short-title'>{t.aboutShort.eyebrow}</h2>
			<blockquote class='about-quote'>
				<p>{t.aboutShort.quote}</p>
			</blockquote>
		</div>
		<div class='about-text reveal d2'>
			<p>{t.aboutShort.p1}</p>
			<p class='about-avail'>
				<span class='dot' aria-hidden='true'></span>
				{pick(SITE.availability, locale)}
			</p>
			<a href={localePath(locale, '/about')} class='btn-link'>{t.aboutShort.more}</a>
		</div>
	</div>
</section>

<style>
	.about-band {
		background: var(--bg-2);
		padding: 120px 32px;
	}
	.about-inner {
		max-width: var(--maxw);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 80px;
		align-items: center;
	}
	.about-quote-col h2 {
		display: block;
		margin-bottom: 20px;
	}
	.about-quote {
		font-size: var(--fs-h3);
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: balance;
	}
	.about-quote::before {
		content: '\201C';
		display: block;
		color: var(--accent);
		font-size: 1.6em;
		line-height: 0.6;
		margin-bottom: 8px;
	}
	.about-text p {
		font-size: 17px;
		line-height: 1.65;
		color: var(--ink-2);
		margin-bottom: 18px;
	}
	.about-avail {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--mono);
		font-size: 13px;
		letter-spacing: 0.02em;
		color: var(--ink-3);
	}
	.about-avail .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}
	.about-text .btn-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 15px;
	}

	@media (max-width: 900px) {
		.about-band {
			padding: 88px 24px;
		}
		.about-inner {
			grid-template-columns: minmax(0, 1fr);
			gap: 40px;
		}
	}
	@media (max-width: 600px) {
		.about-band {
			padding: 72px 20px;
		}
	}
</style>
