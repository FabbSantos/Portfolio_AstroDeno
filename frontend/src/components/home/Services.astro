---
/**
 * #servicos — five compact service cards in one row + a preview panel that
 * shows the template/product solving the hovered (or tapped / focused) service.
 *
 * - Card copy comes from src/data/services.ts (title, short, chips, hue, icon).
 * - The long `outcome` / `timeline` text only appears in the panel.
 * - Each "Pedir orçamento" link carries ?servico=<id> so the contact form can
 *   preselect the service.
 * - ≥ 1100px: 5 columns · 780–1100px: 3 columns · < 780px: snap scroller with
 *   prev/next buttons (data-scroll / data-for, wired by src/scripts/site.ts).
 * - All five previews are in the DOM (stacked); only the active one is visible,
 *   the others are aria-hidden + inert so the crossfade is instant.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { SERVICES, type PreviewImage, type ServiceIcon } from '../../data/services';
import { SITE } from '../../data/site';
import { demoPath, formatBRL, getTemplate } from '../../data/templates';
import { fmt, localeOf, localePath, pick, useT } from '../../i18n';
import shotPulsar from '../../assets/featured/pulsar_dash.png';
import shotQuasar from '../../assets/featured/quasar_dash.png';
import shotNexus from '../../assets/featured/nexus.png';

const locale = localeOf(Astro);
const t = useT(locale);

const home = localePath(locale, '/');
const quoteHref = (id: string) => `${home}?servico=${encodeURIComponent(id)}#contato`;
const host = new URL(SITE.url).host;

// Template screenshots are generated by scripts/shots.mjs (src/assets/templates/[slug].*)
// and may be missing/regenerated — resolve them by slug, any extension, like TemplateCard.
type Shot = { default: ImageMetadata };
const templateShots = import.meta.glob('../../assets/templates/*.{png,jpg,jpeg,webp}', { eager: true }) as Record<string, Shot>;
const SHOT_EXT = ['png', 'webp', 'jpg', 'jpeg'] as const;
const templateShot = (slug: string): ImageMetadata | undefined => {
	for (const ext of SHOT_EXT) {
		const hit = Object.entries(templateShots).find(([path]) => path.endsWith(`/${slug}.${ext}`));
		if (hit) return hit[1].default;
	}
	return undefined;
};

const SHOTS: Record<PreviewImage, ImageMetadata | undefined> = {
	mirante: templateShot('mirante'),
	stratus: templateShot('stratus'),
	atelier: templateShot('atelier'),
	brava: templateShot('brava'),
	pulsar: shotPulsar,
	quasar: shotQuasar,
	nexus: shotNexus,
};

/** Lucide-style 24px outlines (stroke 2, round caps) — inner markup only. */
const ICONS: Record<ServiceIcon, string> = {
	rocket:
		'<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
	layout:
		'<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/>',
	server:
		'<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
	sparkles:
		'<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>',
	'shield-check':
		'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};
---

<section class='section' id='servicos' aria-labelledby='servicos-title'>
	<div class='sec-head reveal'>
		<span class='eyebrow accent'>{t.services.eyebrow}</span>
		<h2 id='servicos-title'>
			{t.services.head1}{' '}
			<span class='hl'>{t.services.head2}</span>
		</h2>
		<p>{t.services.lead}</p>
	</div>

	<ul class='svc-row scroller' id='svc-scroller' role='list' aria-label={t.services.listLabel}>
		{
			SERVICES.map((s, i) => (
				<li class:list={['svc-item', 'reveal', `d${i + 1}`]}>
					<article
						class:list={['svc-card', { 'is-active': i === 0 }]}
						id={`servico-${s.id}`}
						data-card
						data-svc-card={s.id}
						style={`--hue:${s.hue}`}
					>
						<span class='svc-icon' aria-hidden='true'>
							<svg
								viewBox='0 0 24 24'
								width='20'
								height='20'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								set:html={ICONS[s.icon]}
							/>
						</span>
						<h3 class='svc-name'>{pick(s.title, locale)}</h3>
						<p class='svc-short'>{pick(s.short, locale)}</p>
						<p class='svc-chips'>
							<span class='svc-chip'>{pick(s.timelineShort, locale)}</span>
							{s.priceFrom > 0 && (
								<span class='svc-chip'>
									{t.common.from} {formatBRL(s.priceFrom)}
								</span>
							)}
						</p>
						<a class='svc-cta' href={quoteHref(s.id)}>
							{t.common.ctaContact}
							<span class='arr' aria-hidden='true'>
								→
							</span>
						</a>
					</article>
				</li>
			))
		}
	</ul>

	<div class='svc-nav'>
		<button type='button' data-scroll='prev' data-for='#svc-scroller' aria-label={t.services.scrollPrev}>
			←
		</button>
		<button type='button' data-scroll='next' data-for='#svc-scroller' aria-label={t.services.scrollNext}>
			→
		</button>
	</div>

	<div class='svc-panel reveal d2' role='region' aria-live='polite' aria-label={t.services.panelLabel}>
		{
			SERVICES.map((s, i) => {
				const label = pick(s.preview.label, locale);
				const isTemplate = s.preview.href.startsWith('/templates/');
				const alt = fmt(t.services.previewAlt, { label });
				const shot = SHOTS[s.preview.image];
				// No screenshot yet → the live demo, scaled down and inert (templates only).
				const tpl = !shot && isTemplate ? getTemplate(s.preview.image) : undefined;
				return (
					<div
						class:list={['svc-view', { 'is-active': i === 0 }]}
						data-svc-view={s.id}
						style={`--hue:${s.hue}`}
						aria-hidden={i === 0 ? undefined : 'true'}
						inert={i !== 0}
					>
						<div class='svc-browser'>
							<div class='svc-chrome' aria-hidden='true'>
								<i />
								<i />
								<i />
								<span class='svc-url'>{`${host}${s.preview.href}`}</span>
							</div>
							<div class='svc-shot' style={tpl ? `background:${tpl.grad}` : undefined}>
								{shot ? (
									<Image
										src={shot}
										widths={[720, 1200]}
										sizes='(max-width: 1100px) 100vw, 680px'
										format='webp'
										alt={alt}
										loading='lazy'
										decoding='async'
									/>
								) : tpl ? (
									<iframe src={demoPath(tpl.slug)} title={alt} loading='lazy' tabindex='-1' aria-hidden='true' />
								) : (
									<span class='svc-shot-ph' aria-hidden='true' />
								)}
							</div>
						</div>

						<div class='svc-side'>
							<p class='svc-solves'>
								<span class='dot' aria-hidden='true' />
								<span>
									{t.services.solvesWith} <b>{label}</b>
								</span>
							</p>
							<span class='eyebrow'>{t.services.outcome}</span>
							<p class='svc-outcome'>{pick(s.outcome, locale)}</p>
							<p class='svc-eta'>
								<span>{t.services.timeline}</span> · {pick(s.timeline, locale)}
							</p>
							<a class='btn-link svc-more' href={localePath(locale, s.preview.href)}>
								{isTemplate ? t.services.viewTemplate : t.services.viewProduct}
							</a>
						</div>
					</div>
				);
			})
		}
	</div>
</section>

<style>
	/* ---------- Row of cards (desktop: 5 columns) ---------- */
	.svc-row {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 16px;
	}
	.svc-item {
		display: flex;
		min-width: 0;
	}
	:global(.js) .reveal.d4 {
		transition-delay: 0.2s;
	}
	:global(.js) .reveal.d5 {
		transition-delay: 0.25s;
	}

	.svc-card {
		--hue: var(--accent);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: 100%;
		padding: 22px 20px 16px;
		border: 1px solid var(--rule-2);
		border-radius: 18px;
		background: var(--bg-3);
		overflow: hidden;
		transition:
			border-color 0.3s,
			background 0.3s,
			box-shadow 0.45s var(--ease-out-expo),
			transform 0.45s var(--ease-out-expo);
	}
	/* 2px gradient sweep along the top edge */
	.svc-card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 2px;
		background: linear-gradient(90deg, var(--hue), color-mix(in srgb, var(--hue) 35%, var(--accent-2)));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.5s var(--ease-out-expo);
	}
	.svc-card:hover::before,
	.svc-card.is-active::before {
		transform: scaleX(1);
	}
	.svc-card:hover,
	.svc-card.is-active {
		border-color: color-mix(in srgb, var(--hue) 55%, transparent);
		box-shadow:
			0 22px 44px -24px color-mix(in srgb, var(--hue) 55%, transparent),
			0 0 0 1px color-mix(in srgb, var(--hue) 22%, transparent);
	}
	.svc-card.is-active {
		background: linear-gradient(180deg, color-mix(in srgb, var(--hue) 7%, var(--bg-3)), var(--bg-3) 62%);
	}

	.svc-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: color-mix(in srgb, var(--hue) 12%, transparent);
		color: var(--hue);
		transition:
			background 0.3s,
			color 0.3s,
			transform 0.45s var(--ease-out-expo);
	}
	.svc-card.is-active .svc-icon {
		background: var(--hue);
		color: #fff;
	}
	.svc-name {
		font-size: 18px;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: var(--ink);
	}
	.svc-short {
		font-size: 14px;
		line-height: 1.45;
		color: var(--ink-2);
	}
	.svc-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.svc-chip {
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 4px 9px;
		border-radius: 999px;
		background: var(--bg-2);
		color: var(--ink-2);
		white-space: nowrap;
		transition:
			background 0.3s,
			color 0.3s;
	}
	.svc-card.is-active .svc-chip {
		background: color-mix(in srgb, var(--hue) 14%, transparent);
		color: var(--ink);
	}
	.svc-cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		align-self: flex-start;
		min-height: 44px;
		margin-top: auto;
		font-size: 14px;
		font-weight: 600;
		color: var(--accent-text);
	}
	.svc-cta .arr {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-expo);
	}

	/* prev/next — only for the mobile scroller */
	.svc-nav {
		display: none;
		justify-content: flex-end;
		gap: 10px;
	}
	.svc-nav button {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--rule-2);
		background: var(--bg-3);
		color: var(--ink);
		font-size: 18px;
		line-height: 1;
		transition:
			background 0.25s,
			border-color 0.25s,
			transform 0.25s;
	}
	.svc-nav button:hover {
		background: var(--ink);
		border-color: var(--ink);
		color: #fff;
		transform: translateY(-1px);
	}

	/* ---------- Preview panel ---------- */
	.svc-panel {
		display: grid; /* all views share cell 1/1 → panel height = tallest view, no jumps */
		margin-top: 28px;
		border: 1px solid var(--rule);
		border-radius: 24px;
		background: var(--bg-3);
		overflow: hidden;
	}
	.svc-view {
		--hue: var(--accent);
		grid-area: 1 / 1;
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 36px;
		align-items: center;
		padding: 28px;
		opacity: 0;
		transform: translateY(10px);
		pointer-events: none;
		transition:
			opacity 0.35s var(--ease-out-expo),
			transform 0.35s var(--ease-out-expo);
	}
	/* hue wash behind the browser frame */
	.svc-view::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(70% 90% at 18% 12%, color-mix(in srgb, var(--hue) 16%, transparent), transparent 70%);
		pointer-events: none;
	}
	.svc-view.is-active {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}

	.svc-browser {
		position: relative;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--rule-2);
		background: var(--bg-2);
		box-shadow: 0 34px 64px -34px color-mix(in srgb, var(--hue) 50%, rgba(0, 0, 0, 0.35));
	}
	.svc-chrome {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 12px;
		border-bottom: 1px solid var(--rule);
	}
	.svc-chrome i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #ff5f57;
	}
	.svc-chrome i:nth-child(2) {
		background: #febc2e;
	}
	.svc-chrome i:nth-child(3) {
		background: #28c840;
	}
	.svc-url {
		max-width: 62%;
		margin-inline: auto;
		padding: 4px 12px;
		border-radius: 999px;
		background: var(--bg-3);
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-2);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.svc-shot {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #fff;
	}
	.svc-shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transform-origin: 50% 30%;
	}
	/* Fallbacks: scaled live demo (no screenshot yet) or a soft tint. */
	.svc-shot {
		position: relative;
	}
	.svc-shot iframe {
		position: absolute;
		inset: 0;
		width: 200%;
		height: 200%;
		transform: scale(0.5);
		transform-origin: top left;
		border: 0;
		pointer-events: none;
		background: #fff;
	}
	.svc-shot-ph {
		display: block;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, color-mix(in srgb, var(--hue) 16%, #fff), color-mix(in srgb, var(--hue) 5%, #fff));
	}

	.svc-side {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
	}
	.svc-solves {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.svc-solves b {
		font-size: 17px;
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.svc-solves .dot {
		flex: 0 0 auto;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--hue);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--hue) 18%, transparent);
	}
	.svc-side .eyebrow {
		margin-top: 6px;
	}
	.svc-outcome {
		font-size: 15px;
		line-height: 1.55;
		color: var(--ink-2);
	}
	.svc-eta {
		font-family: var(--mono);
		font-size: 12px;
		line-height: 1.5;
		color: var(--ink-2);
	}
	.svc-eta span {
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.svc-more {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		min-height: 44px;
		margin-top: 4px;
		font-size: 15px;
	}

	/* ---------- Motion (transforms only when the visitor is fine with it) ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.svc-card:hover,
		.svc-card.is-active {
			transform: translateY(-4px);
		}
		.svc-card:hover .svc-icon,
		.svc-card.is-active .svc-icon {
			transform: rotate(6deg) scale(1.08);
		}
		.svc-card:hover .arr,
		.svc-card.is-active .arr {
			transform: translateX(4px);
		}
		.svc-view.is-active .svc-shot img {
			animation: svc-kb 6s var(--ease-out-expo) forwards;
		}
		@keyframes svc-kb {
			from {
				transform: scale(1);
			}
			to {
				transform: scale(1.03);
			}
		}
	}

	/* ---------- Tablet: 3 columns, stacked panel ---------- */
	@media (max-width: 1100px) {
		.svc-row {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.svc-view {
			grid-template-columns: minmax(0, 1fr);
			gap: 22px;
			padding: 22px;
		}
	}

	/* ---------- Mobile: snap scroller + prev/next ---------- */
	@media (max-width: 780px) {
		.svc-row {
			display: flex;
			gap: 14px;
			margin: 0 -32px;
			padding: 8px 32px 28px;
			overflow-x: auto;
			overflow-y: hidden;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: 32px;
			-webkit-overflow-scrolling: touch;
			touch-action: pan-x pan-y;
			scrollbar-width: none;
			cursor: grab;
			user-select: none;
		}
		.svc-row.is-dragging {
			cursor: grabbing;
			scroll-snap-type: none;
		}
		.svc-row::-webkit-scrollbar {
			display: none;
		}
		.svc-item {
			flex: 0 0 min(78vw, 300px);
			scroll-snap-align: start;
		}
		.svc-nav {
			display: flex;
		}
		.svc-panel {
			margin-top: 20px;
			border-radius: 20px;
		}
		.svc-view {
			padding: 16px;
			gap: 18px;
		}
		.svc-chrome {
			height: 32px;
			padding: 0 10px;
		}
		.svc-url {
			max-width: 72%;
		}
	}
</style>

<script>
	const root = document.getElementById('servicos');
	if (root) {
		const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-card]'));
		const views = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-view]'));
		const panel = root.querySelector<HTMLElement>('.svc-panel');
		const noHover = window.matchMedia('(hover: none)');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = cards.find((c) => c.classList.contains('is-active'))?.dataset.svcCard ?? '';

		const activate = (id: string) => {
			if (!id || id === current) return;
			current = id;
			cards.forEach((c) => c.classList.toggle('is-active', c.dataset.svcCard === id));
			views.forEach((v) => {
				const on = v.dataset.svcView === id;
				v.classList.toggle('is-active', on);
				v.toggleAttribute('inert', !on);
				if (on) v.removeAttribute('aria-hidden');
				else v.setAttribute('aria-hidden', 'true');
			});
		};

		cards.forEach((card) => {
			const id = card.dataset.svcCard ?? '';
			// Mouse / pen: hover previews. Touch is handled by the tap below so a
			// finger swiping across the scroller doesn't flip the panel.
			card.addEventListener('pointerenter', (e) => {
				if (e.pointerType !== 'touch') activate(id);
			});
			// Keyboard: tabbing onto the card's link previews it.
			card.addEventListener('focusin', () => activate(id));
			// Tap / click on the card body switches the panel; the CTA link still navigates.
			card.addEventListener('click', (e) => {
				if ((e.target as Element).closest('a')) return;
				activate(id);
				if (noHover.matches && panel) {
					const r = panel.getBoundingClientRect();
					if (r.top > window.innerHeight - 160) {
						panel.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'nearest' });
					}
				}
			});
		});
	}
</script>
