---
/**
 * Featured-projects panel for the home hero (after 21st.dev 13448 "Preview
 * Switch Hero", 9309 "Feature Showcase", 5131 "FeaturesDetail" and 12246
 * "Tilt Card"): an ink panel that bleeds to the right edge of the viewport,
 * a vertical rail listing the six projects (index, name, category) and one
 * big screenshot beside it, tilted in 3D and straightening on hover.
 *
 * Autoplay: the active rail item has a bar that fills in 6 s (CSS animation);
 * its `animationend` advances to the next project, so pausing is just
 * `animation-play-state`. It pauses on hover, focus, a hidden tab, reduced
 * motion, and with the visible pause/play control.
 *
 * Scene 0 is the LCP image and the only one rendered eagerly; the other five
 * sit inside a <template> and are mounted after `load` (they would otherwise
 * compete with the LCP even with loading=lazy, since they are in-viewport).
 */
import { Image } from 'astro:assets';
import { featured } from '../../data/featured';
import { fmt, localeOf, localePath, pick, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);

const scenes = featured.slice(0, 6);
const total = scenes.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class='pv' id='showcase' role='region' aria-roledescription='carousel' aria-label={t.hero.showcase.label}>
	<ol class='pv-rail' role='tablist' aria-label={t.hero.showcase.label}>
		{
			scenes.map((s, i) => (
				<li>
					<button
						type='button'
						role='tab'
						id={`pv-tab-${i}`}
						class:list={['pv-item', { 'is-active': i === 0 }]}
						data-pv-go={i}
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-controls={`pv-scene-${i}`}
						tabindex={i === 0 ? 0 : -1}
					>
						<span class='pv-i' aria-hidden='true'>{pad(i + 1)}</span>
						<span class='pv-name'>{s.title}</span>
						<span class='pv-badge'>{pick(s.badge, locale)}</span>
						<span class='pv-bar' aria-hidden='true' />
					</button>
				</li>
			))
		}
	</ol>

	<div class='pv-stage'>
		<div class='pv-frame' aria-live='polite'>
			{
				scenes.map((s, i) => {
					const active = i === 0;
					const shot = (
						<figure
							id={`pv-scene-${i}`}
							class:list={['pv-scene', { 'is-active': active }]}
							role='tabpanel'
							aria-labelledby={`pv-tab-${i}`}
							aria-hidden={active ? undefined : 'true'}
							inert={!active}
						>
							<Image
								class='pv-img'
								src={s.image}
								alt={pick(s.alt, locale)}
								widths={[640, 960, 1280, 1600]}
								sizes='(max-width: 1024px) 100vw, 44vw'
								format='webp'
								quality='high'
								loading='eager'
								fetchpriority={active ? 'high' : 'low'}
								decoding='async'
							/>
						</figure>
					);
					return active ? shot : <template data-pv-deferred>{shot}</template>;
				})
			}
		</div>

		<div class='pv-caps'>
			{
				scenes.map((s, i) => {
					const active = i === 0;
					const external = !!s.href && /^https?:\/\//.test(s.href);
					const href = s.href ? (external ? s.href : localePath(locale, s.href)) : undefined;
					return (
						<div class:list={['pv-cap', { 'is-active': active }]} data-pv-cap={i} aria-hidden={active ? undefined : 'true'} inert={!active}>
							<p class='pv-url'>{pick(s.urlLabel, locale)}</p>
							<p class='pv-desc'>{pick(s.desc, locale)}</p>
							{href && (
								<a class='pv-link' href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
									{t.common.viewProject}
									<span aria-hidden='true'>{external ? '↗' : '→'}</span>
									{external && <span class='sr-only'>({t.common.openInNewTab})</span>}
								</a>
							)}
						</div>
					);
				})
			}
		</div>
	</div>

	{
		total > 1 && (
			<button
				type='button'
				class='pv-toggle'
				data-pv-toggle
				data-label-pause={t.hero.showcase.pause}
				data-label-play={t.hero.showcase.play}
				aria-label={t.hero.showcase.pause}
				aria-pressed='false'
			>
				<svg class='ic-pause' width='14' height='14' viewBox='0 0 18 18' aria-hidden='true' focusable='false'>
					<rect x='4' y='3' width='3.5' height='12' rx='1' fill='currentColor' />
					<rect x='10.5' y='3' width='3.5' height='12' rx='1' fill='currentColor' />
				</svg>
				<svg class='ic-play' width='14' height='14' viewBox='0 0 18 18' aria-hidden='true' focusable='false'>
					<path d='M5 3.5v11l9-5.5z' fill='currentColor' />
				</svg>
				<span class='pv-count' aria-hidden='true'>
					<b data-pv-cur>01</b> / {pad(total)}
				</span>
			</button>
		)
	}
	<p class='sr-only' data-pv-status data-tpl={t.hero.showcase.slide.replace('{total}', String(total))} aria-live='polite'>
		{fmt(t.hero.showcase.slide, { n: 1, total })}
	</p>
</div>

<style>
	.pv {
		--pv-bg: #121212;
		--pv-paper: #f3f1ea;
		--pv-dim: rgba(243, 241, 234, 0.5);
		--pv-rule: rgba(243, 241, 234, 0.14);
		--pv-t: 6s;
		/* Distance from the column's right edge to the viewport's: the panel grows
		   into it (body clips overflow-x, so the scrollbar width is harmless). */
		--pv-bleed: calc(max(0px, (100vw - var(--maxw)) / 2) + 32px);
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(168px, 0.38fr) minmax(0, 1fr);
		gap: 32px;
		margin-right: calc(-1 * var(--pv-bleed));
		padding: 40px 48px 40px 36px;
		background: var(--pv-bg);
		color: var(--pv-paper);
		/* Slides in from the right; no opacity, the LCP image is inside. */
		animation: pvIn 1.1s var(--ease-out-expo) 0.15s both;
	}
	@keyframes pvIn {
		from {
			transform: translateX(48px);
		}
	}

	/* ---- rail ---- */
	.pv-rail {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		align-content: start;
		align-self: center;
	}
	.pv-item {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 12px;
		align-items: baseline;
		width: 100%;
		padding: 12px 0 13px;
		border: 0;
		border-top: 1px solid var(--pv-rule);
		background: none;
		color: var(--pv-dim);
		text-align: left;
		font: inherit;
		cursor: pointer;
		transition: color 0.25s;
	}
	.pv-rail li:last-child .pv-item {
		border-bottom: 1px solid var(--pv-rule);
	}
	.pv-item:hover,
	.pv-item:focus-visible {
		color: var(--pv-paper);
	}
	.pv-item:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.pv-item.is-active {
		color: var(--pv-paper);
	}
	.pv-i {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		color: var(--pv-dim);
	}
	.pv-item.is-active .pv-i {
		color: var(--accent);
	}
	.pv-name {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.2;
	}
	.pv-badge {
		grid-column: 2;
		margin-top: 3px;
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.04em;
		line-height: 1.4;
		color: var(--pv-dim);
	}
	/* Progress bar: a 2 px line on the top rule; fills over --pv-t, then the
	   script advances on animationend. Only transform animates. */
	.pv-bar {
		position: absolute;
		left: 0;
		right: 0;
		top: -1px;
		height: 2px;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		transform: scaleX(0);
		transform-origin: left;
	}
	.pv-item.is-active .pv-bar {
		animation: pvFill var(--pv-t) linear both;
	}
	.pv.is-held .pv-item.is-active .pv-bar,
	.pv.is-paused .pv-item.is-active .pv-bar {
		animation-play-state: paused;
	}
	@keyframes pvFill {
		to {
			transform: scaleX(1);
		}
	}

	/* ---- screen ---- */
	.pv-stage {
		display: grid;
		gap: 22px;
		align-content: center;
		min-width: 0;
		max-width: 680px;
		perspective: 1400px;
	}
	.pv-frame {
		position: relative;
		aspect-ratio: 4 / 3;
		background: #1c1c1c;
		border: 1px solid rgba(243, 241, 234, 0.12);
		overflow: hidden;
		transform: rotateY(-8deg) rotateX(3deg);
		transform-origin: 40% 50%;
		box-shadow:
			32px 48px 100px -36px rgba(0, 0, 0, 0.85),
			0 0 0 1px rgba(0, 0, 0, 0.6);
		transition: transform 0.9s var(--ease-out-expo);
	}
	.pv:hover .pv-frame,
	.pv:focus-within .pv-frame {
		transform: none;
	}
	.pv-scene {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.55s ease,
			visibility 0s linear 0.55s;
	}
	.pv-scene.is-active {
		opacity: 1;
		visibility: visible;
		z-index: 1;
		transition:
			opacity 0.55s ease,
			visibility 0s;
	}
	.pv-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
		/* Incoming scene settles from a slight zoom while it fades in. */
		transform: scale(1.03);
		transition: transform 1.2s var(--ease-out-expo);
	}
	.pv-scene.is-active .pv-img {
		transform: none;
	}

	/* ---- caption (stacked, same toggle as the scenes) ---- */
	.pv-caps {
		position: relative;
		min-height: 108px;
	}
	.pv-cap {
		position: absolute;
		inset: 0;
		display: grid;
		gap: 8px;
		align-content: start;
		justify-items: start;
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition:
			opacity 0.45s ease,
			transform 0.7s var(--ease-out-expo),
			visibility 0s linear 0.45s;
	}
	.pv-cap.is-active {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 0.45s ease 0.1s,
			transform 0.7s var(--ease-out-expo) 0.1s,
			visibility 0s;
	}
	.pv-url {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.05em;
		color: var(--pv-dim);
	}
	.pv-desc {
		font-size: 14.5px;
		line-height: 1.5;
		max-width: 46ch;
		color: rgba(243, 241, 234, 0.82);
	}
	.pv-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 32px;
		font-size: 13.5px;
		font-weight: 600;
		color: var(--pv-paper);
		border-bottom: 1px solid rgba(243, 241, 234, 0.4);
		transition: border-color 0.2s;
	}
	.pv-link:hover {
		border-color: var(--accent);
	}
	.pv-link span[aria-hidden] {
		display: inline-block;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.pv-link:hover span[aria-hidden] {
		transform: translate(2px, -1px);
	}

	/* ---- pause / play + index ---- */
	.pv-toggle {
		position: absolute;
		top: 12px;
		right: 40px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 32px;
		padding: 0 10px;
		border: 0;
		background: none;
		color: var(--pv-dim);
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		cursor: pointer;
		transition: color 0.2s;
	}
	.pv-toggle:hover,
	.pv-toggle:focus-visible {
		color: var(--pv-paper);
	}
	.pv-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.pv-count b {
		font-weight: 600;
		color: var(--pv-paper);
	}
	.ic-play {
		display: none;
	}
	.pv.is-paused .ic-pause {
		display: none;
	}
	.pv.is-paused .ic-play {
		display: block;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ---- narrow desktop (≤ 1200px): tighter rail so the screen keeps its size ---- */
	@media (max-width: 1200px) and (min-width: 1025px) {
		.pv {
			grid-template-columns: minmax(140px, 0.3fr) minmax(0, 1fr);
			gap: 24px;
			padding: 32px 36px 32px 28px;
		}
		.pv-badge {
			display: none;
		}
		.pv-name {
			font-size: 15px;
		}
		.pv-item {
			padding: 11px 0 12px;
		}
		.pv-stage {
			padding-top: 30px;
		}
		.pv-toggle {
			top: 8px;
			right: 28px;
		}
	}

	/* ---- stacked (≤ 1024px): full-width panel, screen on top, rail as chips ---- */
	@media (max-width: 1024px) {
		.pv {
			grid-template-columns: minmax(0, 1fr);
			gap: 20px;
			margin: 0 -24px;
			padding: 52px 24px 32px;
		}
		.pv-stage {
			max-width: none;
		}
		.pv-stage {
			order: -1;
			perspective: none;
		}
		.pv-frame {
			aspect-ratio: 16 / 10;
			transform: none;
			box-shadow: none;
		}
		.pv-rail {
			display: flex;
			gap: 8px;
			overflow-x: auto;
			scroll-snap-type: x proximity;
			scrollbar-width: none;
			margin: 0 -24px;
			padding: 2px 24px;
		}
		.pv-rail::-webkit-scrollbar {
			display: none;
		}
		.pv-rail li {
			flex: none;
			scroll-snap-align: start;
		}
		.pv-item {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 2px;
			min-width: 150px;
			padding: 12px 14px 12px;
			border: 1px solid var(--pv-rule);
		}
		.pv-rail li:last-child .pv-item {
			border-bottom: 1px solid var(--pv-rule);
		}
		.pv-item.is-active {
			border-color: rgba(243, 241, 234, 0.4);
		}
		.pv-bar {
			top: auto;
			bottom: -1px;
		}
		.pv-i {
			font-size: 10px;
		}
		.pv-name {
			font-size: 15px;
		}
		.pv-badge {
			display: none;
		}
		.pv-caps {
			min-height: 96px;
		}
		.pv-toggle {
			top: 10px;
			right: 24px;
		}
	}
	@media (max-width: 600px) {
		.pv {
			margin: 0 -20px;
			padding: 50px 20px 32px;
		}
		.pv-toggle {
			right: 20px;
		}
		.pv-rail {
			margin: 0 -20px;
			padding: 2px 20px;
		}
		.pv-desc {
			font-size: 14px;
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pv {
			animation: none;
		}
		.pv-frame {
			transform: none;
			transition: none;
		}
		.pv-img,
		.pv-cap,
		.pv-scene {
			transition: none;
			transform: none;
		}
		/* No autoplay: the bar never runs, so animationend never fires. */
		.pv-item.is-active .pv-bar {
			animation: none;
			transform: scaleX(1);
		}
	}
</style>

<script>
	const root = document.getElementById('showcase');
	if (root) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pv-go]'));
		const caps = Array.from(root.querySelectorAll<HTMLElement>('[data-pv-cap]'));
		const toggle = root.querySelector<HTMLButtonElement>('[data-pv-toggle]');
		const cur = root.querySelector<HTMLElement>('[data-pv-cur]');
		const status = root.querySelector<HTMLElement>('[data-pv-status]');
		const total = tabs.length;
		const statusTpl = status?.dataset.tpl ?? '';
		let scenes: HTMLElement[] = Array.from(root.querySelectorAll<HTMLElement>('.pv-scene'));
		let idx = 0;
		let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Scenes 1… are mounted after load so they never compete with the LCP photo.
		const mountDeferred = () => {
			root.querySelectorAll<HTMLTemplateElement>('template[data-pv-deferred]').forEach((tpl) => tpl.replaceWith(tpl.content));
			scenes = Array.from(root.querySelectorAll<HTMLElement>('.pv-scene'));
		};
		if (document.readyState === 'complete') mountDeferred();
		else window.addEventListener('load', mountDeferred, { once: true });

		const setOn = (el: HTMLElement | undefined, on: boolean) => {
			if (!el) return;
			el.classList.toggle('is-active', on);
			el.toggleAttribute('inert', !on);
			if (on) el.removeAttribute('aria-hidden');
			else el.setAttribute('aria-hidden', 'true');
		};

		const show = (i: number, focus = false) => {
			const next = ((i % total) + total) % total;
			if (next === idx && !focus) return;
			if (next !== idx) {
				if (scenes.length < total) mountDeferred();
				const prevTab = tabs[idx];
				if (prevTab) {
					prevTab.classList.remove('is-active');
					prevTab.setAttribute('aria-selected', 'false');
					prevTab.tabIndex = -1;
				}
				setOn(scenes[idx], false);
				setOn(caps[idx], false);
				idx = next;
				const tab = tabs[idx];
				if (tab) {
					tab.classList.add('is-active');
					tab.setAttribute('aria-selected', 'true');
					tab.tabIndex = 0;
				}
				setOn(scenes[idx], true);
				setOn(caps[idx], true);
				if (cur) cur.textContent = String(idx + 1).padStart(2, '0');
				if (status) status.textContent = statusTpl.replace('{n}', String(idx + 1));
			}
			if (focus) tabs[idx]?.focus();
		};

		// The bar's animation ends → next project (unless paused: the animation is paused too).
		root.addEventListener('animationend', (e) => {
			if ((e.target as HTMLElement).classList.contains('pv-bar')) show(idx + 1);
		});

		const setPaused = (p: boolean) => {
			paused = p;
			root.classList.toggle('is-paused', p);
			if (toggle) {
				toggle.setAttribute('aria-pressed', String(p));
				toggle.setAttribute('aria-label', (p ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
			}
		};
		toggle?.addEventListener('click', () => setPaused(!paused));

		// Hover / focus inside the panel or a hidden tab hold the bar in place.
		const hold = (on: boolean) => root.classList.toggle('is-held', on);
		root.addEventListener('mouseenter', () => hold(true));
		root.addEventListener('mouseleave', () => hold(!!document.hidden || root.matches(':focus-within')));
		root.addEventListener('focusin', () => hold(true));
		root.addEventListener('focusout', (e) => {
			if (!root.contains(e.relatedTarget as Node | null)) hold(!!document.hidden || root.matches(':hover'));
		});
		document.addEventListener('visibilitychange', () => hold(document.hidden || root.matches(':hover') || root.matches(':focus-within')));

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => show(i));
			tab.addEventListener('mouseenter', () => show(i));
			tab.addEventListener('focus', () => show(i));
		});
		root.addEventListener('keydown', (e) => {
			if (!(e.target as HTMLElement).closest('[data-pv-go]')) return;
			if (e.key === 'ArrowDown' || e.key === 'ArrowRight') show(idx + 1, true);
			else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') show(idx - 1, true);
			else if (e.key === 'Home') show(0, true);
			else if (e.key === 'End') show(total - 1, true);
			else return;
			e.preventDefault();
		});

		// Reduced motion keeps the bar static, so the control reads "paused".
		setPaused(paused);
	}
</script>
