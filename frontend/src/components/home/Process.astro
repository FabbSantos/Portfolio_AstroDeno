---
/**
 * #processo — "Como eu trabalho": four numbered steps (a real sequence, so
 * numbering is right) plus the "Você recebe" checklist.
 *
 * Motion: steps reveal in a stagger and highlight on hover (tinted panel +
 * number chip); checklist ticks draw themselves (stroke-dashoffset) once the
 * card scrolls in. All transform/opacity/stroke — no layout shift.
 */
import { localeOf, localePath, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
const contactHref = `${localePath(locale, '/')}#contato`;
---

<section class='section' id='processo'>
	<div class='sec-head reveal'>
		<span class='eyebrow accent'>{t.process.eyebrow}</span>
		<h2>
			{t.process.head1}{' '}
			<span class='hl'>{t.process.head2}</span>
		</h2>
		<p>{t.process.lead}</p>
	</div>

	<div class='process-grid'>
		<ol class='steps'>
			{
				t.process.steps.map((s, i) => (
					<li class={`step reveal d${i + 1}`}>
						<span class='step-num' aria-hidden='true'>
							{String(i + 1).padStart(2, '0')}
						</span>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</li>
				))
			}
		</ol>

		<div class='deliver reveal d2'>
			<h3 class='eyebrow accent'>{t.process.deliverTitle}</h3>
			<ul class='deliver-list'>
				{
					t.process.deliverables.map((d, i) => (
						<li style={`--i:${i}`}>
							<svg class='check' viewBox='0 0 16 16' aria-hidden='true' focusable='false'>
								<path d='M3 8.5l3.2 3L13 4.5' />
							</svg>
							<span>{d}</span>
						</li>
					))
				}
			</ul>
			<a href={contactHref} class='btn btn-primary'>{t.common.ctaContact}</a>
		</div>
	</div>
</section>

<style>
	.process-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 64px;
		align-items: start;
	}
	.steps {
		list-style: none;
		border-top: 1px solid var(--rule);
	}
	.step {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		column-gap: 24px;
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
	}
	/* Hover panel (bleeds 16px past the text column). */
	.step::before {
		content: '';
		position: absolute;
		inset: 0 -16px;
		z-index: -1;
		border-radius: 14px;
		background: var(--bg-2);
		opacity: 0;
		transform: scale(0.985);
		transition:
			opacity 0.3s,
			transform 0.45s var(--ease-out-expo);
	}
	.step:hover::before {
		opacity: 1;
		transform: none;
	}
	.step-num {
		grid-row: 1 / 3;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 40px;
		height: 28px;
		padding: 0 8px;
		border-radius: 8px;
		background: var(--accent-soft);
		font-family: var(--mono);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--accent-text);
		transition:
			background 0.3s,
			color 0.3s,
			transform 0.45s var(--ease-out-expo);
	}
	.step:hover .step-num {
		/* --accent-text on white = 4.6:1 → AA for the 13px number */
		background: var(--accent-text);
		color: #fff;
		transform: translateY(-2px);
	}
	.step h3 {
		font-size: 24px;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.1;
		transition: transform 0.45s var(--ease-out-expo);
	}
	.step:hover h3 {
		transform: translateX(4px);
	}
	.step p {
		grid-column: 2;
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 58ch;
	}

	.deliver {
		position: sticky;
		top: 96px;
		padding: 28px;
		border-radius: 20px;
		background: var(--bg-2);
	}
	.deliver h3 {
		display: block;
		margin-bottom: 16px;
	}
	.deliver-list {
		list-style: none;
		display: grid;
		gap: 10px;
		margin-bottom: 24px;
	}
	.deliver-list li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 15px;
		font-weight: 500;
		line-height: 1.45;
	}
	.check {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		margin-top: 2px;
		fill: none;
		stroke: var(--accent-text);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* Check-draw: the path is fully drawn by default (no-JS); with JS it stays
	   undrawn until the card gets `.in`, then draws with a per-item delay. */
	.check path {
		stroke-dasharray: 16;
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 0.55s var(--ease-out-expo);
		transition-delay: calc(0.2s + var(--i, 0) * 0.09s);
	}
	:global(.js) .deliver:not(.in) .check path {
		stroke-dashoffset: 16;
		transition: none;
	}
	.deliver .btn {
		width: 100%;
	}

	@media (max-width: 1024px) {
		.process-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 40px;
		}
		.deliver {
			position: static;
		}
		.deliver .btn {
			width: auto;
		}
	}
	@media (max-width: 600px) {
		.step {
			grid-template-columns: 44px minmax(0, 1fr);
			column-gap: 14px;
			padding: 22px 0;
		}
		.step::before {
			inset: 0 -12px;
		}
		.step-num {
			min-width: 36px;
			height: 26px;
			padding: 0 6px;
			font-size: 12px;
		}
		.step h3 {
			font-size: 21px;
		}
		.step p {
			font-size: 15px;
		}
		.deliver {
			padding: 22px 20px;
			border-radius: 16px;
		}
		.deliver .btn {
			width: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.step:hover .step-num,
		.step:hover h3 {
			transform: none;
		}
		.check path {
			transition: none;
		}
	}
</style>
