---
/**
 * Home hero — copy on the left, DeviceShowcase on the right; stacked and
 * centered below 1024px. This component OWNS the two-column layout, so no
 * page-level :global overrides are needed.
 *
 * The h1 is the sales headline (not the name); the name lives in the sub.
 */
import DeviceShowcase from './DeviceShowcase.astro';
import { SITE, whatsappUrl } from '../../data/site';
import { fmt, localeOf, localePath, pick, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);

const contactHref = `${localePath(locale, '/')}#contato`;
const wa = whatsappUrl(locale);

const credential = fmt(t.hero.credential, {
	role: pick(SITE.role, locale),
	location: pick(SITE.location, locale),
	since: SITE.since,
});
const proof = fmt(t.hero.proof, {
	years: SITE.stats.years,
	products: SITE.stats.products,
	time: pick(SITE.responseTime, locale),
});
---

<section class='hero-stage' aria-labelledby='hero-title'>
	<!-- Easter egg: the Astro rocket from the 2024 hero, still hovering. -->
	<svg class='astro-rocket' viewBox='0 0 495 623' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'>
		<path
			fill-rule='evenodd'
			clip-rule='evenodd'
			d='M167.19 364.254C83.4786 364.254 0 404.819 0 404.819C0 404.819 141.781 19.4876 142.087 18.7291C146.434 7.33701 153.027 0 162.289 0H332.441C341.703 0 348.574 7.33701 352.643 18.7291C352.92 19.5022 494.716 404.819 494.716 404.819C494.716 404.819 426.67 364.254 327.525 364.254L264.41 169.408C262.047 159.985 255.147 153.581 247.358 153.581C239.569 153.581 232.669 159.985 230.306 169.408L167.19 364.254ZM136.218 411.348C124.476 450.467 132.698 504.458 160.869 530.172C160.997 529.696 161.125 529.242 161.248 528.804C161.502 527.907 161.737 527.073 161.917 526.233C165.446 509.895 178.754 499.52 195.577 500.01C211.969 500.487 220.67 508.765 223.202 527.254C224.141 534.12 224.23 541.131 224.319 548.105C224.328 548.834 224.337 549.563 224.347 550.291C224.563 566.098 228.657 580.707 237.264 593.914C245.413 606.426 256.108 615.943 270.749 622.478C270.593 621.952 270.463 621.508 270.35 621.126C270.045 620.086 269.872 619.499 269.685 618.911C258.909 585.935 266.668 563.266 295.344 543.933C298.254 541.971 301.187 540.041 304.12 538.112C310.591 533.854 317.059 529.599 323.279 525.007C345.88 508.329 360.09 486.327 363.431 457.844C364.805 446.148 363.781 434.657 359.848 423.275C358.176 424.287 356.587 425.295 355.042 426.275C351.744 428.366 348.647 430.33 345.382 431.934C303.466 452.507 259.152 455.053 214.03 448.245C184.802 443.834 156.584 436.019 136.218 411.348Z'
			fill='url(#rkt-grad)'></path>
		<defs>
			<linearGradient id='rkt-grad' x1='247.358' y1='0' x2='247.358' y2='622.479' gradientUnits='userSpaceOnUse'>
				<stop stop-opacity='0.9'></stop>
				<stop offset='1' stop-opacity='0.2'></stop>
			</linearGradient>
		</defs>
	</svg>

	<div class='hero-copy'>
		<p class='eyebrow accent hero-eyebrow'>
			<span class='dot' aria-hidden='true'></span>
			{pick(SITE.availability, locale)}
		</p>
		<h1 class='hero-title' id='hero-title'>
			{t.hero.headline}
			<span class='hl'>{t.hero.headlineAccent}</span>
		</h1>
		<p class='hero-sub'>{t.hero.sub}</p>
		<p class='hero-cred'>{credential}</p>
		<div class='hero-actions'>
			<a href={contactHref} class='btn btn-primary'>{t.common.ctaContact}</a>
			<a href={localePath(locale, '/work')} class='btn btn-ghost'>{t.common.ctaWork}</a>
			{
				wa && (
					<a href={wa} class='btn btn-whatsapp' target='_blank' rel='noopener'>
						{t.common.ctaWhatsapp}
					</a>
				)
			}
		</div>
		<p class='hero-proof'>{proof}</p>
	</div>

	<div class='hero-showcase'>
		<DeviceShowcase />
	</div>
</section>

<style>
	.hero-stage {
		position: relative;
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 64px 32px 32px;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 56px;
		align-items: center;
	}
	.hero-copy {
		min-width: 0;
		text-align: left;
	}
	.hero-showcase {
		min-width: 0;
	}

	/* ---- copy ---- */
	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 24px;
		opacity: 0;
		transform: translateY(20px);
		animation: enter 0.8s var(--ease-out-expo) 0.1s both;
	}
	.hero-eyebrow .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 2s infinite;
	}
	.hero-title {
		/* Sentence headline in a half-width column: h2 scale when stacked,
		   a notch above h3 scale when side by side. */
		font-size: var(--fs-h2);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.02;
		color: var(--ink);
		text-wrap: balance;
		opacity: 0;
		transform: translateY(30px);
		animation: enter 1s var(--ease-out-expo) 0.2s both;
	}
	.hero-sub {
		margin-top: 24px;
		max-width: 54ch;
		font-size: var(--fs-lead);
		line-height: 1.55;
		color: var(--ink-2);
		opacity: 0;
		transform: translateY(20px);
		animation: enter 0.9s var(--ease-out-expo) 0.35s both;
	}
	.hero-cred {
		margin-top: 20px;
		font-family: var(--mono);
		font-size: 13px;
		letter-spacing: 0.02em;
		color: var(--ink-3);
		opacity: 0;
		transform: translateY(20px);
		animation: enter 0.9s var(--ease-out-expo) 0.45s both;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 28px;
		opacity: 0;
		transform: translateY(20px);
		animation: enter 0.9s var(--ease-out-expo) 0.55s both;
	}
	.hero-proof {
		margin-top: 18px;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.02em;
		color: var(--ink-3);
		opacity: 0;
		transform: translateY(20px);
		animation: enter 0.9s var(--ease-out-expo) 0.65s both;
	}

	/* ---- rocket ---- */
	.astro-rocket {
		position: absolute;
		top: 28px;
		left: -8px;
		width: 64px;
		height: auto;
		z-index: 0;
		opacity: 0.18;
		pointer-events: none;
		animation: rocketFloat 4s infinite ease-in-out;
	}

	@keyframes enter {
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes pulse {
		50% {
			opacity: 0.4;
		}
	}
	@keyframes rocketFloat {
		0%,
		100% {
			transform: translateY(0) rotate(-3deg);
		}
		50% {
			transform: translateY(-12px) rotate(2deg);
		}
	}

	@media (min-width: 1025px) {
		.hero-title {
			font-size: calc(var(--fs-h3) * 1.15);
		}
	}

	@media (max-width: 1024px) {
		.hero-stage {
			grid-template-columns: minmax(0, 1fr);
			gap: 48px;
			padding: 72px 24px 0;
		}
		.hero-copy {
			text-align: center;
		}
		.hero-title {
			max-width: 24ch;
			margin: 0 auto;
		}
		.hero-sub {
			margin-left: auto;
			margin-right: auto;
		}
		.hero-actions {
			justify-content: center;
		}
		.astro-rocket {
			display: none;
		}
	}
	@media (max-width: 600px) {
		.hero-stage {
			padding: 56px 20px 0;
			gap: 40px;
		}
		.hero-actions .btn {
			flex: 1 1 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-eyebrow,
		.hero-title,
		.hero-sub,
		.hero-cred,
		.hero-actions,
		.hero-proof {
			opacity: 1;
			transform: none;
			animation: none;
		}
		.hero-eyebrow .dot,
		.astro-rocket {
			animation: none;
		}
	}
</style>
