---
/**
 * Client-logo marquee. Used inside ProofBand — no heading of its own.
 *
 * All logos are normalised to grayscale + 75% opacity and get their colour
 * back on hover. `silhouette: true` flattens pure-white-on-transparent logos
 * to black (brightness(0)) so they show on the light bg; those stay black.
 */
import { Image } from 'astro:assets';
import ancora from '../ClientsSection/assets/ancora.png';
import conx from '../ClientsSection/assets/conx.png';
import toledoFerrari from '../ClientsSection/assets/toledo-ferrari.png';
import mkt from '../ClientsSection/assets/mkt.png';
import afya from '../ClientsSection/assets/afya.png';
import desco from '../ClientsSection/assets/desco.png';
import bjConsulting from '../ClientsSection/assets/bj-consulting.png';
import nexus from '../ClientsSection/assets/nexus.svg';
import { localeOf, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);

const clients = [
	{ src: bjConsulting, alt: 'BJ Consulting' },
	{ src: ancora, alt: 'Âncora', silhouette: true },
	{ src: conx, alt: 'Conx' },
	{ src: toledoFerrari, alt: 'Toledo Ferrari' },
	{ src: afya, alt: 'Afya' },
	{ src: desco, alt: 'Descomplica' },
	{ src: mkt, alt: 'Mkt4Edu / 4RevOps', silhouette: true },
	{ src: nexus, alt: 'Nexus Comunicação' },
];
---

<div class='marquee' aria-label={t.clients.logosLabel}>
	<div class='marquee-track'>
		<ul class='marquee-row'>
			{
				clients.map((c) => (
					<li class:list={[{ silhouette: !!c.silhouette }]}>
						<Image src={c.src} alt={c.alt} height={48} loading='lazy' />
					</li>
				))
			}
		</ul>
		<ul class='marquee-row' aria-hidden='true'>
			{
				clients.map((c) => (
					<li class:list={[{ silhouette: !!c.silhouette }]}>
						<Image src={c.src} alt='' height={48} loading='lazy' />
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.marquee {
		--gap: 4rem;
		--duration: 28s;
		position: relative;
		overflow: hidden;
		user-select: none;
	}
	.marquee::before,
	.marquee::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 90px;
		z-index: 2;
		pointer-events: none;
	}
	.marquee::before {
		left: 0;
		background: linear-gradient(to right, var(--bg), transparent);
	}
	.marquee::after {
		right: 0;
		background: linear-gradient(to left, var(--bg), transparent);
	}
	.marquee-track {
		display: flex;
		gap: var(--gap);
		width: max-content;
	}
	.marquee-row {
		list-style: none;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: var(--gap);
		animation: marquee var(--duration) linear infinite;
	}
	.marquee:hover .marquee-row {
		animation-play-state: paused;
	}
	.marquee-row li {
		padding-block: 1rem;
	}
	/* <Image> renders the <img> outside this component's scope → :global */
	.marquee-row :global(img) {
		width: auto;
		height: 44px;
		max-width: 160px;
		object-fit: contain;
		filter: grayscale(1);
		opacity: 0.75;
		transition:
			filter 0.4s var(--ease-out-expo),
			opacity 0.4s var(--ease-out-expo);
	}
	.marquee-row li:hover :global(img) {
		filter: none;
		opacity: 1;
	}
	.marquee-row li.silhouette :global(img),
	.marquee-row li.silhouette:hover :global(img) {
		filter: brightness(0);
	}

	@keyframes marquee {
		to {
			transform: translateX(calc(-100% - var(--gap)));
		}
	}

	@media (max-width: 768px) {
		.marquee {
			--gap: 2.5rem;
			--duration: 22s;
		}
		.marquee::before,
		.marquee::after {
			width: 48px;
		}
		.marquee-row :global(img) {
			height: 36px;
			max-width: 120px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-row {
			animation: none;
		}
		.marquee-track {
			width: auto;
		}
		.marquee-row {
			flex-wrap: wrap;
			justify-content: center;
			gap: 2.5rem;
		}
		.marquee-row[aria-hidden='true'] {
			display: none;
		}
	}
</style>
