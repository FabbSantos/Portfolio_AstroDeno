---
/**
 * #trabalhos — flagships + client cases from src/data/works.ts (no lab).
 * Each row is one link: the public URL when there is one, otherwise the
 * contact form with ?assunto=acesso-<id>.
 */
import { Image } from 'astro:assets';
import { homeWorks } from '../../data/works';
import { localeOf, localePath, pick, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);

const rows = homeWorks(6);
const home = localePath(locale, '/');
const accessHref = (id: string) => `${home}?assunto=${encodeURIComponent(`acesso-${id}`)}#contato`;
---

<section class='section' id='trabalhos'>
	<div class='sec-head reveal'>
		<span class='eyebrow accent'>{t.works.eyebrow}</span>
		<h2>
			{t.works.head1}
			<span class='hl'>{t.works.head2}</span>
		</h2>
		<p>{t.works.lead}</p>
	</div>

	<ol class='works-list reveal d1' aria-label={t.works.listLabel}>
		{
			rows.map((w, i) => {
				const external = !!w.href;
				return (
					<li>
						<a
							class='work-row'
							href={external ? w.href : accessHref(w.id)}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener' : undefined}
						>
							<span class='work-num' aria-hidden='true'>
								{String(i + 1).padStart(2, '0')}
							</span>
							<span class='work-thumb'>
								{w.image ? (
									<Image class='work-thumb-img' src={w.image} alt='' width={144} height={96} format='webp' loading='lazy' />
								) : (
									<span class='work-thumb-ph' aria-hidden='true' />
								)}
							</span>
							<span class='work-title'>{w.title}</span>
							<span class='work-desc'>{pick(w.desc, locale)}</span>
							{w.role && <span class='work-role'>{pick(w.role, locale)}</span>}
							<span class:list={['pill', 'work-status', w.status]}>{t.common[w.status]}</span>
							<span class='work-action'>
								{external ? (
									<>
										{t.common.viewProject} <span class='arr' aria-hidden='true'>↗</span>
										<span class='sr-only'>({t.common.openInNewTab})</span>
									</>
								) : (
									<>
										{t.common.requestAccess} <span class='arr' aria-hidden='true'>→</span>
									</>
								)}
							</span>
						</a>
					</li>
				);
			})
		}
	</ol>

	<div class='works-all'>
		<a href={localePath(locale, '/work')} class='btn-link'>{t.works.all}</a>
	</div>
</section>

<style>
	.works-list {
		list-style: none;
		border-top: 1px solid var(--rule);
	}
	.work-row {
		display: grid;
		grid-template-columns: 40px 72px minmax(0, 1fr) auto auto;
		grid-template-areas:
			'num thumb title status action'
			'num thumb desc status action'
			'num thumb role status action';
		column-gap: 24px;
		row-gap: 6px;
		align-items: center;
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
		transition:
			padding-left 0.4s cubic-bezier(0.7, 0, 0.3, 1),
			background 0.25s;
	}
	.work-row:hover {
		padding-left: 16px;
		background: var(--bg-2);
	}
	.work-num {
		grid-area: num;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
	}
	.work-thumb {
		grid-area: thumb;
		display: block;
		width: 72px;
		height: 48px;
		border-radius: 8px;
		overflow: hidden;
		background: var(--bg-2);
		box-shadow: 0 0 0 1px var(--rule-2);
	}
	.work-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}
	.work-thumb-ph {
		display: block;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--accent-soft), rgba(124, 58, 237, 0.12));
	}
	.work-title {
		grid-area: title;
		font-size: var(--fs-h3);
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.02;
		color: var(--ink);
	}
	.work-desc {
		grid-area: desc;
		font-size: 15px;
		line-height: 1.5;
		color: var(--ink-2);
		max-width: 64ch;
	}
	.work-role {
		grid-area: role;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.02em;
		color: var(--ink-3);
	}
	.work-status {
		grid-area: status;
		justify-self: start;
	}
	.work-action {
		grid-area: action;
		justify-self: end;
		font-size: 14px;
		font-weight: 600;
		color: var(--accent-text);
		white-space: nowrap;
	}
	.work-action .arr {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-expo);
	}
	.work-row:hover .work-action .arr {
		transform: translate(3px, -2px);
	}
	.works-all {
		margin-top: 48px;
		text-align: center;
	}
	.works-all .btn-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Stacked rows: description stays visible under the title — never hidden. */
	@media (max-width: 900px) {
		.work-row {
			grid-template-columns: 28px 72px minmax(0, 1fr);
			grid-template-areas:
				'num thumb title'
				'desc desc desc'
				'role role role'
				'status status action';
			column-gap: 14px;
			row-gap: 10px;
			padding: 22px 0;
		}
		.work-row:hover {
			padding-left: 0;
			background: transparent;
		}
		.work-desc {
			max-width: none;
		}
		.work-action {
			justify-self: end;
		}
	}
	@media (max-width: 600px) {
		.work-title {
			font-size: 24px;
		}
		.work-desc {
			font-size: 14px;
		}
	}
</style>
