---
/**
 * #trabalhos — flagships + client cases from src/data/works.ts (no lab).
 * Each row is one link: the public URL when there is one, otherwise the
 * contact form with ?assunto=acesso-<id>.
 */
import { Image } from 'astro:assets';
import { homeWorks } from '../../data/works';
import { localeOf, localePath, pick, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);

const rows = homeWorks(6);
const home = localePath(locale, '/');
const accessHref = (id: string) => `${home}?assunto=${encodeURIComponent(`acesso-${id}`)}#contato`;
---

<section class='section' id='trabalhos'>
	<div class='sec-head reveal'>
		<span class='eyebrow accent'>{t.works.eyebrow}</span>
		<h2>
			{t.works.head1}
			<span class='hl'>{t.works.head2}</span>
		</h2>
		<p>{t.works.lead}</p>
	</div>

	<ol class='works-list reveal d1' aria-label={t.works.listLabel}>
		{
			rows.map((w, i) => {
				const external = !!w.href;
				return (
					<li>
						<a
							class='work-row'
							href={external ? w.href : accessHref(w.id)}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener' : undefined}
						>
							<span class='work-num' aria-hidden='true'>
								{String(i + 1).padStart(2, '0')}
							</span>
							<span class='work-thumb'>
								{w.image ? (
									<Image class='work-thumb-img' src={w.image} alt='' width={144} height={96} format='webp' loading='lazy' />
								) : (
									<span class='work-thumb-ph' aria-hidden='true' />
								)}
							</span>
							<span class='work-title'>{w.title}</span>
							<span class='work-desc'>{pick(w.desc, locale)}</span>
							{w.role && <span class='work-role'>{pick(w.role, locale)}</span>}
							<span class:list={['pill', 'work-status', w.status]}>{t.common[w.status]}</span>
							<span class='work-action'>
								{external ? (
									<>
										{t.common.viewProject} <span class='arr' aria-hidden='true'>↗</span>
										<span class='sr-only'>({t.common.openInNewTab})</span>
									</>
								) : (
									<>
										{t.common.requestAccess} <span class='arr' aria-hidden='true'>→</span>
									</>
								)}
							</span>
						</a>
					</li>
				);
			})
		}
	</ol>

	<div class='works-all reveal'>
		<a href={localePath(locale, '/work')} class='btn-link'>
			<span class='link-underline'>{t.works.all}</span>
		</a>
	</div>
</section>

<style>
	.works-list {
		list-style: none;
		border-top: 1px solid var(--rule);
	}
	.work-row {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 40px 72px minmax(0, 1fr) auto auto;
		grid-template-areas:
			'num thumb title status action'
			'num thumb desc status action'
			'num thumb role status action';
		column-gap: 24px;
		row-gap: 6px;
		align-items: center;
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
	}
	/* Hover tint: a bleeding rounded panel behind the row (opacity/transform
	   only — the old padding-left slide caused layout work on every hover). */
	.work-row::before {
		content: '';
		position: absolute;
		inset: 0 -16px;
		z-index: -1;
		border-radius: 14px;
		background: var(--bg-2);
		opacity: 0;
		transform: scale(0.985);
		transition:
			opacity 0.3s,
			transform 0.45s var(--ease-out-expo);
	}
	.work-row:hover::before,
	.work-row:focus-visible::before {
		opacity: 1;
		transform: none;
	}
	.work-num {
		grid-area: num;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
		transition: color 0.25s;
	}
	.work-row:hover .work-num {
		color: var(--accent-text);
	}
	.work-thumb {
		grid-area: thumb;
		display: block;
		width: 72px;
		height: 48px;
		border-radius: 8px;
		overflow: hidden;
		background: var(--bg-2);
		box-shadow: 0 0 0 1px var(--rule-2);
		/* keeps the rounded clip while the child scales (Safari) */
		will-change: transform;
		transition: box-shadow 0.3s;
	}
	.work-row:hover .work-thumb {
		box-shadow:
			0 0 0 1px var(--rule-2),
			0 10px 22px -12px rgba(26, 26, 28, 0.35);
	}
	.work-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.6s var(--ease-out-expo);
	}
	.work-row:hover .work-thumb-img,
	.work-row:focus-visible .work-thumb-img {
		transform: scale(1.04);
	}
	.work-thumb-ph {
		display: block;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--accent-soft), rgba(124, 58, 237, 0.12));
	}
	.work-title {
		grid-area: title;
		font-size: var(--fs-h3);
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.02;
		color: var(--ink);
		transition: transform 0.45s var(--ease-out-expo);
	}
	.work-row:hover .work-title,
	.work-row:focus-visible .work-title {
		transform: translateX(4px);
	}
	.work-desc {
		grid-area: desc;
		font-size: 15px;
		line-height: 1.5;
		color: var(--ink-2);
		max-width: 64ch;
	}
	.work-role {
		grid-area: role;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.02em;
		color: var(--ink-3);
	}
	.work-status {
		grid-area: status;
		justify-self: start;
	}
	/* Live: tiny pulsing green dot in front of the label. */
	.work-status.live {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.work-status.live::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--hue-green);
		animation: liveDot 2s ease-in-out infinite;
	}
	@keyframes liveDot {
		0% {
			box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
		}
		70% {
			box-shadow: 0 0 0 5px rgba(22, 163, 74, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(22, 163, 74, 0);
		}
	}
	.work-action {
		grid-area: action;
		justify-self: end;
		font-size: 14px;
		font-weight: 600;
		color: var(--accent-text);
		white-space: nowrap;
	}
	.work-action .arr {
		display: inline-block;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.work-row:hover .work-action .arr,
	.work-row:focus-visible .work-action .arr {
		transform: translate(2px, -2px);
	}
	.works-all {
		margin-top: 48px;
		text-align: center;
	}
	.works-all .btn-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Stacked rows: description stays visible under the title — never hidden. */
	@media (max-width: 900px) {
		.work-row {
			grid-template-columns: 28px 72px minmax(0, 1fr);
			grid-template-areas:
				'num thumb title'
				'desc desc desc'
				'role role role'
				'status status action';
			column-gap: 14px;
			row-gap: 10px;
			padding: 22px 0;
		}
		.work-row::before {
			inset: 0 -12px;
		}
		.work-desc {
			max-width: none;
		}
		.work-action {
			justify-self: end;
		}
	}
	@media (max-width: 600px) {
		.work-title {
			font-size: 24px;
		}
		.work-desc {
			font-size: 14px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.work-row:hover .work-title,
		.work-row:hover .work-thumb-img,
		.work-row:hover .work-action .arr {
			transform: none;
		}
		.work-status.live::before {
			animation: none;
		}
	}
</style>
