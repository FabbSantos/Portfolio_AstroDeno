---
/**
 * Theme switch, "eclipse": a round button in the top bar with a sun. On click
 * the moon's shadow slides over the sun (one shape, no icon swap) and the new
 * theme spreads across the page in a circle that grows from the button
 * (View Transitions API; browsers without it just switch).
 *
 * The choice is stored in localStorage('theme'); Layout.astro applies it
 * before paint. Without a stored choice the site follows the OS.
 */
import { localeOf, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
---

<button type='button' class='tt' id='theme-toggle' data-label-dark={t.common.theme.toDark} data-label-light={t.common.theme.toLight} aria-label={t.common.theme.toDark} aria-pressed='false'>
	<svg viewBox='0 0 24 24' aria-hidden='true' focusable='false'>
		<g class='tt-rays'>
			<line x1='12' y1='1.5' x2='12' y2='4' /><line x1='12' y1='20' x2='12' y2='22.5' /><line x1='1.5' y1='12' x2='4' y2='12' /><line x1='20' y1='12' x2='22.5' y2='12' />
			<line x1='4.6' y1='4.6' x2='6.4' y2='6.4' /><line x1='17.6' y1='17.6' x2='19.4' y2='19.4' /><line x1='4.6' y1='19.4' x2='6.4' y2='17.6' /><line x1='17.6' y1='6.4' x2='19.4' y2='4.6' />
		</g>
		<circle class='tt-sun' cx='12' cy='12' r='5.2' />
		<circle class='tt-shadow' cx='12' cy='12' r='5.2' />
	</svg>
</button>

<style>
	.tt {
		--tt-ease: cubic-bezier(0.34, 1.4, 0.64, 1);
		width: 40px;
		height: 40px;
		flex: none;
		border-radius: 50%;
		border: 1px solid var(--rule-2);
		background: var(--bg-3);
		color: var(--ink);
		display: grid;
		place-items: center;
		cursor: pointer;
		transition:
			transform 0.35s var(--tt-ease),
			border-color 0.25s,
			background 0.25s;
	}
	.tt:hover {
		transform: scale(1.08);
		border-color: var(--ink-4);
	}
	.tt:active {
		transform: scale(0.94);
		transition-duration: 0.1s;
	}
	.tt:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.tt svg {
		width: 20px;
		height: 20px;
		overflow: visible;
	}
	.tt-rays line {
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		transform-origin: 12px 12px;
		transition:
			transform 0.5s var(--tt-ease),
			opacity 0.3s;
	}
	.tt-sun {
		fill: currentColor;
	}
	/* The moon's shadow: a disc in the button's colour, parked off the sun. */
	.tt-shadow {
		fill: var(--bg-3);
		transform: translate(13px, -11px);
		transition:
			transform 0.55s var(--tt-ease),
			fill 0.25s;
	}
	:global(:root[data-theme='dark']) .tt-rays line {
		transform: scale(0);
		opacity: 0;
	}
	:global(:root[data-theme='dark']) .tt-shadow {
		transform: translate(3.6px, -3.6px);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .tt-rays line {
			transform: scale(0);
			opacity: 0;
		}
		:global(:root:not([data-theme='light'])) .tt-shadow {
			transform: translate(3.6px, -3.6px);
		}
	}
	@media (max-width: 780px) {
		.tt {
			width: 38px;
			height: 38px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tt,
		.tt-rays line,
		.tt-shadow {
			transition: none;
		}
	}
</style>

<script>
	const btn = document.getElementById('theme-toggle');
	if (btn) {
		const root = document.documentElement;
		const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
		const media = window.matchMedia('(prefers-color-scheme: dark)');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const isDark = () => {
			const t = root.getAttribute('data-theme');
			return t ? t === 'dark' : media.matches;
		};
		const reflect = () => {
			const dark = isDark();
			btn.setAttribute('aria-pressed', String(dark));
			btn.setAttribute('aria-label', (dark ? btn.dataset.labelLight : btn.dataset.labelDark) ?? '');
			if (meta) meta.content = dark ? '#121212' : '#FBFBFD';
		};
		const apply = (dark: boolean) => {
			root.setAttribute('data-theme', dark ? 'dark' : 'light');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {
				/* private mode */
			}
			reflect();
		};

		btn.addEventListener('click', () => {
			const next = !isDark();
			const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
			if (reduced || !doc.startViewTransition) return apply(next);
			// The new theme grows from the button: the wipe keyframes read these.
			const r = btn.getBoundingClientRect();
			root.style.setProperty('--tw-x', `${r.left + r.width / 2}px`);
			root.style.setProperty('--tw-y', `${r.top + r.height / 2}px`);
			doc.startViewTransition(() => apply(next));
		});

		media.addEventListener('change', reflect);
		reflect();
	}
</script>
