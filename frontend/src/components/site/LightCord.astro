---
/**
 * Theme switch as a pull cord with real physics: a string hangs from the top
 * edge of the viewport (fixed, right side, in its own lane beside the header)
 * with a bulb at the end. It is a damped pendulum with a spring along the
 * string: drag it anywhere and it follows the pointer; let go and it swings
 * and bounces on its own until it settles. It never snaps back to a keyframe.
 *
 * Pulling the bulb down past ~22px and releasing toggles the theme: the light
 * goes out (dark) or comes back on (light). A tap, click, Enter or Space gives
 * the cord a scripted tug that does the same. Hovering just nudges it.
 *
 * The choice is stored in localStorage('theme'); Layout.astro applies it
 * before paint. Without a stored choice the site follows the OS.
 * Reduced motion: no swing, no nudge; the tug is instant.
 */
import { localeOf, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
---

<button type='button' class='cord' id='light-cord' data-label-dark={t.common.theme.toDark} data-label-light={t.common.theme.toLight} aria-label={t.common.theme.toDark} aria-pressed='false'>
	<span class='cord-arm' data-cord-arm aria-hidden='true'>
		<span class='cord-line' data-cord-line></span>
		<span class='cord-knob' data-cord-knob>
			<span class='cord-glow'></span>
			<span class='cord-bulb'></span>
		</span>
	</span>
</button>

<style>
	.cord {
		/* String length; the script reads it. */
		--L: 112px;
		position: fixed;
		top: 0;
		right: 24px;
		z-index: 60;
		width: 44px;
		height: calc(var(--L) + 44px);
		padding: 0;
		border: 0;
		background: none;
		cursor: grab;
		touch-action: none;
		-webkit-tap-highlight-color: transparent;
	}
	.cord.is-dragging {
		cursor: grabbing;
	}
	.cord:focus-visible {
		outline: none;
	}
	.cord:focus-visible .cord-bulb {
		box-shadow:
			0 0 0 3px var(--bg),
			0 0 0 5px var(--accent);
	}
	/* The arm rotates around the anchor at the top edge of the screen. */
	.cord-arm {
		position: absolute;
		left: 50%;
		top: -2px;
		width: 0;
		height: var(--L);
		transform-origin: 50% 0;
		will-change: transform;
	}
	.cord-line {
		position: absolute;
		left: -1px;
		top: 0;
		width: 2px;
		height: var(--L);
		background: linear-gradient(to bottom, color-mix(in srgb, var(--ink) 25%, transparent), color-mix(in srgb, var(--ink) 55%, transparent));
		transform-origin: top;
		will-change: transform;
	}
	.cord-knob {
		position: absolute;
		left: -9px;
		top: calc(var(--L) - 2px);
		width: 18px;
		height: 18px;
		will-change: transform;
	}
	.cord-bulb {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 32%, #fff8cf 0%, #ffd23f 45%, #f4a300 100%);
		box-shadow:
			0 0 0 1px rgba(200, 140, 0, 0.35),
			0 2px 4px rgba(0, 0, 0, 0.3);
		transition:
			background 0.45s,
			box-shadow 0.45s;
	}
	.cord-glow {
		position: absolute;
		inset: -14px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 210, 63, 0.6) 0%, rgba(255, 210, 63, 0.2) 45%, transparent 70%);
		transition:
			opacity 0.45s,
			transform 0.45s var(--ease-out-expo);
	}
	/* Light off: the bulb goes cold and the glow disappears. */
	:global(:root[data-theme='dark']) .cord-bulb {
		background: radial-gradient(circle at 35% 32%, #4a4a4a 0%, #2a2a2a 60%, #1c1c1c 100%);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.16),
			0 2px 4px rgba(0, 0, 0, 0.6);
	}
	:global(:root[data-theme='dark']) .cord-glow {
		opacity: 0;
		transform: scale(0.6);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .cord-bulb {
			background: radial-gradient(circle at 35% 32%, #4a4a4a 0%, #2a2a2a 60%, #1c1c1c 100%);
			box-shadow:
				0 0 0 1px rgba(255, 255, 255, 0.16),
				0 2px 4px rgba(0, 0, 0, 0.6);
		}
		:global(:root:not([data-theme='light'])) .cord-glow {
			opacity: 0;
			transform: scale(0.6);
		}
	}
	/* A short flash when the light comes on. */
	.cord.is-flash .cord-glow {
		animation: cordFlash 0.6s ease-out;
	}
	@keyframes cordFlash {
		0% {
			transform: scale(0.6);
			opacity: 0;
		}
		40% {
			transform: scale(1.5);
			opacity: 1;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@media (max-width: 780px) {
		.cord {
			--L: 84px;
			right: 8px;
			width: 40px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cord-bulb,
		.cord-glow {
			transition: none;
		}
		.cord.is-flash .cord-glow {
			animation: none;
		}
	}
</style>

<script>
	const cord = document.getElementById('light-cord');
	const arm = cord?.querySelector<HTMLElement>('[data-cord-arm]');
	const line = cord?.querySelector<HTMLElement>('[data-cord-line]');
	const knob = cord?.querySelector<HTMLElement>('[data-cord-knob]');
	if (cord && arm && line && knob) {
		const root = document.documentElement;
		const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
		const media = window.matchMedia('(prefers-color-scheme: dark)');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		/* ---- theme ---- */
		const isDark = () => {
			const t = root.getAttribute('data-theme');
			return t ? t === 'dark' : media.matches;
		};
		const reflect = () => {
			const dark = isDark();
			cord.setAttribute('aria-pressed', String(dark));
			cord.setAttribute('aria-label', (dark ? cord.dataset.labelLight : cord.dataset.labelDark) ?? '');
			if (meta) meta.content = dark ? '#000000' : '#FBFBFD';
		};
		const setTheme = (dark: boolean) => {
			root.setAttribute('data-theme', dark ? 'dark' : 'light');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {
				/* private mode */
			}
			if (!dark && !reduced) {
				cord.classList.remove('is-flash');
				void cord.offsetWidth;
				cord.classList.add('is-flash');
			}
			reflect();
		};
		const toggle = () => setTheme(!isDark());

		/* ---- physics: a damped pendulum (angle) with a spring along the string (stretch) ---- */
		const L = () => parseFloat(getComputedStyle(cord).getPropertyValue('--L')) || 112;
		const G = 2400; // px/s², sets the swing period for a string ~100 px long
		const DAMP = 1.4; // angular damping
		const K = 230; // spring stiffness along the string
		const C = 13; // spring damping
		const MAX_ANGLE = 1.25; // rad
		const MAX_STRETCH = 84;
		const THRESHOLD = 22;
		let th = 0; // angle, 0 = hanging straight down, positive = to the right
		let w = 0; // angular velocity
		let s = 0; // stretch in px
		let sv = 0; // stretch velocity
		let raf = 0;
		let last = 0;
		let dragging = false;

		const render = () => {
			arm.style.transform = `rotate(${th}rad)`;
			line.style.transform = `scaleY(${1 + s / L()})`;
			knob.style.transform = `translateY(${s}px)`;
		};
		const settled = () => Math.abs(w) < 0.02 && Math.abs(th) < 0.003 && Math.abs(s) < 0.3 && Math.abs(sv) < 1;
		const step = (now: number) => {
			raf = 0;
			const dt = Math.min(0.032, (now - last) / 1000 || 0.016);
			last = now;
			if (!dragging) {
				const len = L() + s;
				const a = (-G / len) * Math.sin(th) - DAMP * w;
				w += a * dt;
				th += w * dt;
				sv += (-K * s - C * sv) * dt;
				s += sv * dt;
				if (settled()) {
					th = 0;
					w = 0;
					s = 0;
					sv = 0;
					render();
					return;
				}
			}
			render();
			raf = requestAnimationFrame(step);
		};
		const run = () => {
			if (reduced) return render();
			if (!raf) {
				last = performance.now();
				raf = requestAnimationFrame(step);
			}
		};

		/* ---- pointer: the bulb follows the hand, then the string is let go ---- */
		let prevTh = 0;
		let prevT = 0;
		let moved = 0;
		const anchor = () => {
			const r = cord.getBoundingClientRect();
			return { x: r.left + r.width / 2, y: r.top };
		};
		cord.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			dragging = true;
			moved = 0;
			cord.setPointerCapture(e.pointerId);
			cord.classList.add('is-dragging');
			prevTh = th;
			prevT = performance.now();
			run();
		});
		cord.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const a = anchor();
			const dx = e.clientX - a.x;
			const dy = Math.max(8, e.clientY - a.y);
			th = Math.max(-MAX_ANGLE, Math.min(MAX_ANGLE, Math.atan2(dx, dy)));
			const d = Math.hypot(dx, dy) - L();
			// Past the natural length the string resists.
			s = d <= 0 ? Math.max(-6, d * 0.3) : d <= 40 ? d : Math.min(MAX_STRETCH, 40 + (d - 40) * 0.45);
			moved = Math.max(moved, Math.abs(dx) + Math.abs(dy - L()));
			const now = performance.now();
			const dt = (now - prevT) / 1000;
			if (dt > 0.008) {
				w = (th - prevTh) / dt;
				prevTh = th;
				prevT = now;
			}
			sv = 0;
			render();
		});
		const release = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			cord.classList.remove('is-dragging');
			try {
				cord.releasePointerCapture(e.pointerId);
			} catch {
				/* already released */
			}
			if (moved < 6) {
				// A tap: a scripted tug.
				s = 34;
				sv = 0;
				toggle();
			} else if (s >= THRESHOLD) {
				toggle();
			}
			// Let go: the spring pulls the stretch back, the pendulum keeps the momentum.
			w = Math.max(-6, Math.min(6, w));
			run();
		};
		cord.addEventListener('pointerup', release);
		cord.addEventListener('pointercancel', release);

		// Hovering brushes the cord: a small push, and it swings on its own.
		cord.addEventListener('pointerenter', (e) => {
			if (dragging || reduced || e.pointerType !== 'mouse') return;
			const a = anchor();
			w += e.clientX < a.x ? 1.4 : -1.4;
			run();
		});

		// Keyboard activation (Enter / Space) comes through click with detail 0.
		cord.addEventListener('click', (e) => {
			if (e.detail !== 0) return;
			s = 34;
			sv = 0;
			toggle();
			run();
		});

		media.addEventListener('change', reflect);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden && raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			} else if (!document.hidden && !settled()) run();
		});
		reflect();
	}
</script>
