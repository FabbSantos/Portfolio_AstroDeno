---
/**
 * Floating WhatsApp button (portfolio pages). Renders only when
 * SITE.whatsapp.number is set. Attention cues: pulsing ring + a small hop
 * every few seconds; the label slides out on hover/focus. Hides itself while
 * the contact section (#contato) is on screen, since that block already has
 * a WhatsApp button. Everything stops under prefers-reduced-motion.
 */
import { whatsappUrl } from '../../data/site';
import { localeOf, useT } from '../../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
const href = whatsappUrl(locale);
---

{
	href && (
		<a
			class='wa-fab'
			href={href}
			target='_blank'
			rel='noopener'
			aria-label={t.common.ctaWhatsapp}
			data-wa-fab
			data-track='whatsapp_fab'
		>
			<span class='wa-ring' aria-hidden='true' />
			<span class='wa-icon' aria-hidden='true'>
				<svg viewBox='0 0 24 24' width='26' height='26' fill='currentColor'>
					<path d='M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-1 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.4c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3C4 15 3.7 13.5 3.7 12c0-4.6 3.7-8.3 8.3-8.3s8.3 3.7 8.3 8.3-3.7 8.2-8.3 8.2z' />
				</svg>
			</span>
			<span class='wa-label'>{t.common.ctaWhatsapp}</span>
		</a>
	)
}

<script>
	import { onScrolledPast } from '../../scripts/site';

	const fab = document.querySelector<HTMLAnchorElement>('[data-wa-fab]');
	const contact = document.getElementById('contato');
	if (fab) {
		// Hide while the contact block is visible (it has its own WhatsApp button).
		if (contact && 'IntersectionObserver' in window) {
			new IntersectionObserver(
				(entries) => entries.forEach((e) => fab.classList.toggle('is-hidden', e.isIntersecting)),
				{ threshold: 0.25 }
			).observe(contact);
		}
		// Show only after the hero has been passed a little, so it doesn't fight the hero CTAs.
		if ('IntersectionObserver' in window) onScrolledPast(240, (past) => fab.classList.toggle('is-ready', past));
		else fab.classList.add('is-ready');
		fab.addEventListener('click', () => {
			import('@vercel/analytics').then(({ track }) => track('whatsapp_click', { where: 'fab' })).catch(() => {});
		});
	}
</script>

<style>
	.wa-fab {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 900;
		display: inline-flex;
		align-items: center;
		gap: 0;
		height: 56px;
		padding: 0 0 0 0;
		border-radius: 999px;
		background: #25d366;
		color: #0b2b16;
		box-shadow: 0 12px 30px -10px rgba(37, 211, 102, 0.65), 0 2px 6px rgba(0, 0, 0, 0.12);
		transform: translateY(24px) scale(0.9);
		opacity: 0;
		pointer-events: none;
		transition:
			transform 0.5s var(--ease-out-expo),
			opacity 0.4s,
			box-shadow 0.3s;
	}
	.wa-fab.is-ready {
		opacity: 1;
		pointer-events: auto;
		transform: none;
		animation: waHop 6s ease-in-out 3s infinite;
	}
	.wa-fab.is-ready.is-hidden {
		opacity: 0;
		pointer-events: none;
		transform: translateY(24px) scale(0.9);
		animation: none;
	}
	.wa-icon {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		flex: none;
	}
	.wa-label {
		max-width: 0;
		overflow: hidden;
		white-space: nowrap;
		font-weight: 600;
		font-size: 15px;
		padding-right: 0;
		opacity: 0;
		transition:
			max-width 0.45s var(--ease-out-expo),
			padding 0.45s var(--ease-out-expo),
			opacity 0.3s;
	}
	.wa-fab:hover .wa-label,
	.wa-fab:focus-visible .wa-label {
		max-width: 220px;
		padding-right: 22px;
		opacity: 1;
	}
	.wa-fab:hover,
	.wa-fab:focus-visible {
		background: #1fb85a;
		box-shadow: 0 16px 34px -10px rgba(37, 211, 102, 0.8), 0 2px 6px rgba(0, 0, 0, 0.12);
		animation-play-state: paused;
	}
	.wa-ring {
		position: absolute;
		inset: 0;
		border-radius: 999px;
		border: 2px solid rgba(37, 211, 102, 0.7);
		animation: waRing 2.4s ease-out infinite;
		pointer-events: none;
	}
	@keyframes waRing {
		0% {
			transform: scale(1);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.7);
			opacity: 0;
		}
	}
	@keyframes waHop {
		0%,
		12%,
		100% {
			transform: translateY(0);
		}
		4% {
			transform: translateY(-14px) rotate(-4deg);
		}
		8% {
			transform: translateY(0) rotate(3deg);
		}
		10% {
			transform: translateY(-6px);
		}
	}
	@media (max-width: 600px) {
		.wa-fab {
			right: 14px;
			bottom: 14px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.wa-fab,
		.wa-fab.is-ready {
			animation: none;
			transition: none;
		}
		.wa-ring {
			display: none;
		}
	}
</style>
