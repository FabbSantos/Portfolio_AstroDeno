---
/**
 * Sticky top bar shared by every portfolio page (demos use DemoRibbon instead).
 *
 * - All links go through localePath(); the language switch is a plain link to
 *   the same page in the other locale (no client-side swapping).
 * - The language pill lives OUTSIDE <nav> so it stays reachable on mobile when
 *   the menu is collapsed (site.ts toggles `inert` on #nav-mini).
 * - Mobile menu: opacity + transform + visibility (transition-safe) — no body
 *   scroll lock, the page stays scrollable behind the dropdown.
 */
import { SITE } from '../../data/site';
import { LANG_TAG, altLocale, localeOf, localePath, switchPath, useT } from '../../i18n';

interface Props {
	active?: 'home' | 'services' | 'work' | 'templates' | 'about';
}

const { active } = Astro.props;
const locale = localeOf(Astro);
const alt = altLocale(locale);
const t = useT(locale);

const links = [
	{ key: 'services', href: localePath(locale, '/#servicos'), label: t.nav.services },
	{ key: 'work', href: localePath(locale, '/work'), label: t.nav.work },
	{ key: 'templates', href: localePath(locale, '/templates'), label: t.nav.templates },
	{ key: 'about', href: localePath(locale, '/about'), label: t.nav.about },
	{ key: 'contact', href: localePath(locale, '/#contato'), label: t.nav.contact },
] as const;

const switchHref = switchPath(locale, Astro.url.pathname);
const CODE: Record<typeof locale, string> = { pt: 'PT', en: 'EN' };
---

<header class='topbar' id='topbar'>
	<div class='inner'>
		<a href={localePath(locale, '/')} class='brand'>
			{SITE.brand.first}<span class='dot'>{SITE.brand.dot}</span> {SITE.brand.last}
		</a>

		<nav class='nav-mini' id='nav-mini' aria-label={t.nav.mainNav}>
			{
				links.map((l) => (
					<a href={l.href} aria-current={active === l.key ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class='tools'>
			<div class='lang' role='group' aria-label={t.common.language}>
				{
					(['pt', 'en'] as const).map((l) =>
						l === locale ? (
							<span class='lang-option is-current' aria-current='true' lang={LANG_TAG[l]}>
								{CODE[l]}
							</span>
						) : (
							<a
								class='lang-option'
								href={switchHref}
								hreflang={LANG_TAG[alt]}
								lang={LANG_TAG[alt]}
								aria-label={t.common.switchTo}
								title={t.common.switchTo}
							>
								{CODE[l]}
							</a>
						)
					)
				}
			</div>

			<button
				class='nav-toggle'
				id='nav-toggle'
				type='button'
				aria-controls='nav-mini'
				aria-expanded='false'
				aria-label={t.common.menu}
			>
				<span></span><span></span>
			</button>
		</div>
	</div>
</header>

<style>
	.topbar {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 20px 32px;
		background: rgba(251, 251, 253, 0);
		backdrop-filter: saturate(180%) blur(0);
		-webkit-backdrop-filter: saturate(180%) blur(0);
		border-bottom: 1px solid transparent;
		transition:
			background 0.3s,
			backdrop-filter 0.3s,
			border-color 0.3s,
			padding 0.3s;
	}
	.topbar.is-scrolled {
		background: rgba(251, 251, 253, 0.85);
		backdrop-filter: saturate(180%) blur(14px);
		-webkit-backdrop-filter: saturate(180%) blur(14px);
		border-bottom-color: var(--rule);
		padding: 14px 32px;
	}
	.inner {
		max-width: var(--maxw);
		margin: 0 auto;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 28px;
	}
	.brand {
		margin-right: auto;
		font-weight: 700;
		font-size: 17px;
		letter-spacing: -0.02em;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}
	.brand .dot {
		color: var(--accent);
	}

	/* Links */
	.nav-mini {
		display: flex;
		align-items: center;
		gap: 24px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.nav-mini a {
		display: inline-flex;
		align-items: center;
		padding: 6px 0;
		transition: color 0.2s;
	}
	.nav-mini a:hover {
		color: var(--ink);
	}
	.nav-mini a[aria-current='page'] {
		color: var(--ink);
		font-weight: 600;
	}

	/* Language pill + mobile toggle */
	.tools {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.lang {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--rule-2);
		border-radius: 999px;
		padding: 2px;
	}
	.lang-option {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 28px;
		padding: 0 11px;
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.5px;
		line-height: 1;
		color: var(--ink-3);
		transition:
			color 0.2s,
			background 0.2s;
	}
	a.lang-option:hover {
		color: var(--ink);
		background: var(--bg-2);
	}
	.lang-option.is-current {
		color: #fff;
		background: var(--ink);
	}

	.nav-toggle {
		display: none;
		width: 44px;
		height: 44px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		border-radius: 999px;
	}
	.nav-toggle span {
		width: 22px;
		height: 2px;
		background: var(--ink);
		border-radius: 2px;
		transition:
			transform 0.3s var(--ease-out-expo),
			opacity 0.3s;
	}
	.topbar.nav-open .nav-toggle span:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}
	.topbar.nav-open .nav-toggle span:last-child {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	@media (max-width: 780px) {
		.topbar {
			padding: 12px 20px;
		}
		.topbar.is-scrolled {
			padding: 8px 20px;
		}
		.inner {
			gap: 12px;
		}
		.nav-toggle {
			display: flex;
		}
		.lang-option {
			min-height: 36px;
			padding: 0 14px;
		}

		.nav-mini {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 8px 20px 20px;
			background: rgba(251, 251, 253, 0.96);
			backdrop-filter: saturate(180%) blur(14px);
			-webkit-backdrop-filter: saturate(180%) blur(14px);
			border-bottom: 1px solid var(--rule);
			font-size: 17px;
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition:
				opacity 0.25s,
				transform 0.25s var(--ease-out-expo),
				visibility 0s linear 0.25s;
		}
		.nav-mini a {
			min-height: 48px;
			padding: 12px 0;
			border-bottom: 1px solid var(--rule);
		}
		.nav-mini a:last-child {
			border-bottom: 0;
		}
		.topbar.nav-open .nav-mini {
			transform: translateY(0);
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transition:
				opacity 0.25s,
				transform 0.25s var(--ease-out-expo),
				visibility 0s;
		}
	}
</style>
