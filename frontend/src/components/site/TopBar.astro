---
/**
 * Sticky top bar shared by every portfolio page (demos use DemoRibbon instead).
 *
 * - All links go through localePath(); the language switch is a plain link to
 *   the same page in the other locale (no client-side swapping).
 * - The contact button always stays in the bar. On desktop the language pill sits
 *   next to it; on mobile (≤ 780px) the bar is brand + contact + toggle and the
 *   language link moves into the menu (site.ts toggles `inert` on #nav-mini).
 * - Mobile menu: opacity + transform + visibility (transition-safe) — no body
 *   scroll lock, the page stays scrollable behind the dropdown.
 */
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../../data/site';
import { LANG_TAG, altLocale, localeOf, localePath, switchPath, useT } from '../../i18n';

interface Props {
	active?: 'home' | 'services' | 'work' | 'templates' | 'about';
}

const { active } = Astro.props;
const locale = localeOf(Astro);
const alt = altLocale(locale);
const t = useT(locale);

const links = [
	{ key: 'services', href: localePath(locale, '/#servicos'), label: t.nav.services },
	{ key: 'work', href: localePath(locale, '/work'), label: t.nav.work },
	{ key: 'templates', href: localePath(locale, '/templates'), label: t.nav.templates },
	{ key: 'about', href: localePath(locale, '/about'), label: t.nav.about },
] as const;
// Contact is the always-visible button in .tools, not a nav link, so it survives the collapsed mobile menu.
const contactHref = localePath(locale, '/#contato');

const switchHref = switchPath(locale, Astro.url.pathname);
const CODE: Record<typeof locale, string> = { pt: 'PT', en: 'EN' };
---

<header class='topbar' id='topbar'>
	<div class='inner'>
		<a href={localePath(locale, '/')} class='brand'>
			{SITE.brand.first}<span class='dot'>{SITE.brand.dot}</span> {SITE.brand.last}
		</a>

		<nav class='nav-mini' id='nav-mini' aria-label={t.nav.mainNav}>
			{
				links.map((l) => (
					<a href={l.href} aria-current={active === l.key ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
			<a class='nav-lang' href={switchHref} hreflang={LANG_TAG[alt]} lang={LANG_TAG[alt]}>
				<span class='nav-lang-code' aria-hidden='true'>{CODE[alt]}</span>
				{t.common.switchTo}
			</a>
		</nav>

		<div class='tools'>
			<!-- Only one label is displayed per breakpoint; display:none keeps the other out of the accessible name. -->
			<a class='top-cta' href={contactHref} data-cta='topbar'>
				<span class='top-cta-full'>{t.common.ctaContact}</span>
				<span class='top-cta-short'>{t.common.ctaContactShort}</span>
			</a>
			<div class='lang' role='group' aria-label={t.common.language}>
				{
					(['pt', 'en'] as const).map((l) =>
						l === locale ? (
							<span class='lang-option is-current' aria-current='true' lang={LANG_TAG[l]}>
								{CODE[l]}
							</span>
						) : (
							<a
								class='lang-option'
								href={switchHref}
								hreflang={LANG_TAG[alt]}
								lang={LANG_TAG[alt]}
								aria-label={t.common.switchTo}
								title={t.common.switchTo}
							>
								{CODE[l]}
							</a>
						)
					)
				}
			</div>

			<ThemeToggle />

			<button
				class='nav-toggle'
				id='nav-toggle'
				type='button'
				aria-controls='nav-mini'
				aria-expanded='false'
				aria-label={t.common.menu}
			>
				<span></span><span></span>
			</button>
		</div>
	</div>
</header>

<style>
	.topbar {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 20px 32px;
		background: color-mix(in srgb, var(--bg) 0%, transparent);
		backdrop-filter: saturate(180%) blur(0);
		-webkit-backdrop-filter: saturate(180%) blur(0);
		border-bottom: 1px solid transparent;
		transition:
			background 0.3s,
			backdrop-filter 0.3s,
			border-color 0.3s,
			padding 0.3s;
	}
	.topbar.is-scrolled {
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(180%) blur(14px);
		-webkit-backdrop-filter: saturate(180%) blur(14px);
		border-bottom-color: var(--rule);
		padding: 14px 32px;
	}
	.inner {
		max-width: var(--maxw);
		margin: 0 auto;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 28px;
	}
	.brand {
		margin-right: auto;
		font-weight: 700;
		font-size: 17px;
		letter-spacing: -0.02em;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}
	.brand .dot {
		display: inline-block;
		color: var(--accent);
		transition: transform 0.4s var(--ease-out-expo);
		/* one pop on load; `backwards` (not `both`) so hover can transform it afterwards */
		animation: dotPop 0.9s var(--ease-out-expo) 0.3s backwards;
	}
	.brand:hover .dot {
		transform: scale(1.3);
	}
	@keyframes dotPop {
		0% {
			opacity: 0;
			transform: scale(0.2);
		}
		55% {
			opacity: 1;
			transform: scale(1.45);
		}
		100% {
			transform: scale(1);
		}
	}

	/* Links — gradient underline grows from the left; stays on aria-current. */
	.nav-mini {
		display: flex;
		align-items: center;
		gap: 24px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.nav-mini a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 6px 0;
		transition: color 0.2s;
	}
	.nav-mini a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1px;
		height: 2px;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.nav-mini a:hover,
	.nav-mini a:focus-visible {
		color: var(--ink);
	}
	.nav-mini a:hover::after,
	.nav-mini a:focus-visible::after,
	.nav-mini a[aria-current='page']::after {
		transform: scaleX(1);
	}
	.nav-mini a[aria-current='page'] {
		color: var(--ink);
		font-weight: 600;
	}

	/* Language pill + mobile toggle */
	.tools {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	/* Contact button: same language as .btn-primary, sized for the bar. */
	.top-cta {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 38px;
		padding: 0 18px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--on-ink);
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		transition:
			background 0.25s,
			transform 0.35s var(--ease-out-expo),
			box-shadow 0.3s;
	}
	.top-cta:hover,
	.top-cta:focus-visible {
		background: var(--accent);
		color: #fff;
		transform: translateY(-1px);
		box-shadow: 0 10px 24px -12px rgba(255, 89, 100, 0.65);
	}
	.top-cta::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.28) 50%, transparent 65%);
		transform: translateX(-120%);
	}
	.top-cta:hover::after {
		transition: transform 0.8s ease;
		transform: translateX(120%);
	}
	.top-cta-short {
		display: none;
	}
	/* Mobile-only language row inside the menu (desktop uses .lang). */
	.nav-mini .nav-lang {
		display: none;
	}
	.lang {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--rule-2);
		border-radius: 999px;
		padding: 2px;
		transition:
			border-color 0.25s,
			box-shadow 0.3s var(--ease-out-expo);
	}
	.lang:hover {
		border-color: var(--ink-4);
		box-shadow: 0 6px 16px -10px rgba(26, 26, 28, 0.45);
	}
	.lang-option {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 28px;
		padding: 0 11px;
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.5px;
		line-height: 1;
		color: var(--ink-3);
		transition:
			color 0.2s,
			background 0.2s;
	}
	a.lang-option:hover {
		color: var(--ink);
		background: var(--bg-2);
	}
	.lang-option.is-current {
		color: var(--on-ink);
		background: var(--ink);
	}

	.nav-toggle {
		display: none;
		width: 44px;
		height: 44px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		border-radius: 999px;
	}
	.nav-toggle {
		transition: background 0.2s;
	}
	.nav-toggle:hover {
		background: var(--bg-2);
	}
	.nav-toggle span {
		width: 22px;
		height: 2px;
		background: var(--ink);
		border-radius: 2px;
		transition:
			transform 0.3s var(--ease-out-expo),
			opacity 0.3s;
	}
	.topbar.nav-open .nav-toggle span:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}
	.topbar.nav-open .nav-toggle span:last-child {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	@media (max-width: 780px) {
		.topbar {
			padding: 12px 20px;
		}
		.topbar.is-scrolled {
			padding: 8px 20px;
		}
		.inner {
			gap: 12px;
		}
		.nav-toggle {
			display: flex;
		}
		.lang-option {
			min-height: 36px;
			padding: 0 14px;
		}
		.tools {
			gap: 8px;
		}
		.lang {
			display: none;
		}
		.top-cta {
			min-height: 38px;
			padding: 0 16px;
			font-size: 14px;
		}
		.top-cta-full {
			display: none;
		}
		.top-cta-short {
			display: inline;
		}
		.nav-mini .nav-lang {
			display: flex;
			gap: 10px;
			color: var(--ink-2);
		}
		.nav-lang-code {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 34px;
			height: 24px;
			border: 1px solid var(--rule-2);
			border-radius: 999px;
			font-family: var(--mono);
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 0.5px;
			color: var(--ink-2);
		}

		.nav-mini {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 8px 20px 20px;
			background: color-mix(in srgb, var(--bg) 96%, transparent);
			backdrop-filter: saturate(180%) blur(14px);
			-webkit-backdrop-filter: saturate(180%) blur(14px);
			border-bottom: 1px solid var(--rule);
			font-size: 17px;
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition:
				opacity 0.25s,
				transform 0.25s var(--ease-out-expo),
				visibility 0s linear 0.25s;
		}
		.nav-mini a {
			min-height: 48px;
			padding: 12px 0;
			border-bottom: 1px solid var(--rule);
			transition:
				color 0.2s,
				transform 0.3s var(--ease-out-expo);
		}
		.nav-mini a:last-child {
			border-bottom: 0;
		}
		/* Stacked menu: nudge instead of underline (a full-width bar reads as a border). */
		.nav-mini a::after {
			display: none;
		}
		.nav-mini a:hover {
			transform: translateX(4px);
		}
		.nav-mini a[aria-current='page'] {
			color: var(--accent-text);
		}
		.topbar.nav-open .nav-mini {
			transform: translateY(0);
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transition:
				opacity 0.25s,
				transform 0.25s var(--ease-out-expo),
				visibility 0s;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand .dot {
			animation: none;
		}
		.brand:hover .dot,
		.nav-mini a:hover,
		.top-cta:hover {
			transform: none;
		}
	}
</style>
