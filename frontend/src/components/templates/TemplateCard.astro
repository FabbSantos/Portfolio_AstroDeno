---
/**
 * Template card — used by the home band, the /templates gallery and the
 * "other templates" block on the sales page.
 *
 * - The whole card links to the SALES page (/templates/[slug]), never to the demo.
 * - Preview: a build-time screenshot from `src/assets/templates/[slug].png` when
 *   one exists; otherwise the live demo scaled down inside an inert iframe.
 * - `data-card` lets the home scroller measure the step for prev/next buttons.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { SITE } from '../../data/site';
import { demoPath, formatBRL, type TemplateMeta } from '../../data/templates';
import { fmt, localePath, pick, useT, type Locale } from '../../i18n';

interface Props {
	tpl: TemplateMeta;
	locale: Locale;
	/** Heading level: h2 in the gallery (directly under the page h1), h3 under a section h2. */
	heading?: 'h2' | 'h3';
	class?: string;
}
const { tpl, locale, heading = 'h3', class: cls } = Astro.props;
const t = useT(locale);

// Build-time screenshots (optional): src/assets/templates/[slug].png
type Shot = { default: ImageMetadata };
const shots = import.meta.glob('../../assets/templates/*.png', { eager: true }) as Record<string, Shot>;
const shot = Object.entries(shots).find(([path]) => path.endsWith('/' + tpl.slug + '.png'))?.[1].default;

const name = `${tpl.name} ${tpl.accent}`;
const previewAlt = fmt(t.templates.card.previewAlt, { name });
const includes = fmt(t.templates.card.includes, { months: SITE.promises.adjustmentsMonths });
---

<a href={localePath(locale, `/templates/${tpl.slug}`)} class:list={['tpl-card', cls]} data-card>
	<div class='tpl-frame' style={`background:${tpl.grad}`}>
		{
			shot ? (
				<Image
					src={shot}
					widths={[420, 840]}
					sizes='(max-width: 780px) 84vw, 420px'
					format='webp'
					alt={previewAlt}
					loading='lazy'
				/>
			) : (
				<iframe src={demoPath(tpl.slug)} title={previewAlt} loading='lazy' tabindex='-1' aria-hidden='true' />
			)
		}
		<span class='tpl-open' aria-hidden='true'>{t.templates.card.open} →</span>
	</div>

	<div class='tpl-meta'>
		<p class='top'>
			<span class='cat'>{pick(tpl.cat, locale)}</span>
			<span class='days'>{tpl.days} {t.common.businessDays}</span>
		</p>
		{
			heading === 'h2' ? (
				<h2 class='name'>
					{tpl.name} <span class='hl'>{tpl.accent}</span>
				</h2>
			) : (
				<h3 class='name'>
					{tpl.name} <span class='hl'>{tpl.accent}</span>
				</h3>
			)
		}
		<p class='desc'>{pick(tpl.desc, locale)}</p>
		<p class='inc'>{includes}</p>
		<p class='foot'>
			<span class='price'><span class='from'>{t.common.from}</span> {formatBRL(tpl.priceFrom)}</span>
			<span class='pick'>{t.templates.card.open}</span>
		</p>
	</div>
</a>

<style>
	.tpl-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-3);
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--rule);
		transition:
			transform 0.35s var(--ease-out-expo),
			box-shadow 0.35s;
	}
	.tpl-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.18);
	}
	.tpl-card:focus-visible {
		outline-offset: 4px;
		border-radius: 18px;
	}

	/* Preview: screenshot or scaled live demo */
	.tpl-frame {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid var(--rule);
	}
	.tpl-frame img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}
	.tpl-frame iframe {
		position: absolute;
		inset: 0;
		width: 250%;
		height: 250%;
		transform: scale(0.4);
		transform-origin: top left;
		border: 0;
		pointer-events: none;
		background: #fff;
	}
	.tpl-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 60%, rgba(26, 26, 28, 0.18));
		opacity: 0;
		transition: opacity 0.3s;
		pointer-events: none;
	}
	.tpl-card:hover .tpl-frame::after,
	.tpl-card:focus-visible .tpl-frame::after {
		opacity: 1;
	}
	.tpl-open {
		position: absolute;
		bottom: 16px;
		left: 50%;
		transform: translateX(-50%) translateY(8px);
		background: var(--ink);
		color: #fff;
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		padding: 8px 16px;
		border-radius: 999px;
		letter-spacing: 0.04em;
		white-space: nowrap;
		opacity: 0;
		transition:
			opacity 0.3s var(--ease-out-expo),
			transform 0.3s var(--ease-out-expo);
	}
	.tpl-card:hover .tpl-open,
	.tpl-card:focus-visible .tpl-open {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}

	/* Body */
	.tpl-meta {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 22px 24px 24px;
		flex: 1;
	}
	.top {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
	}
	.top .cat {
		color: var(--accent-text);
		font-weight: 600;
	}
	.top .days {
		white-space: nowrap;
	}
	.tpl-meta :global(.name) {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	/* Heading is < 24px: use the AA-safe accent. */
	.tpl-meta :global(.name .hl) {
		color: var(--accent-text);
	}
	.desc {
		font-size: 14px;
		color: var(--ink-2);
		line-height: 1.5;
	}
	.inc {
		font-size: 13px;
		color: var(--ink-3);
		line-height: 1.45;
	}
	.foot {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		margin-top: auto;
		padding-top: 14px;
		border-top: 1px solid var(--rule);
		font-size: 14px;
	}
	.foot .price {
		font-weight: 700;
		color: var(--ink);
	}
	.foot .from {
		font-weight: 500;
		color: var(--ink-3);
		font-size: 13px;
	}
	.foot .pick {
		color: var(--accent-text);
		font-weight: 600;
		white-space: nowrap;
	}
	.foot .pick::after {
		content: ' →';
		display: inline-block;
		transition: transform 0.2s;
	}
	.tpl-card:hover .foot .pick::after {
		transform: translateX(4px);
	}
</style>
