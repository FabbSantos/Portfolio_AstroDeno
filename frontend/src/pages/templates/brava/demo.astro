---
/**
 * Brava — portfolio demo. All copy/images live in
 * src/templates/brava/demo.config.ts; the page itself is just layout + body.
 */
import DemoLayout from '../../../layouts/DemoLayout.astro';
import ThemeVars from '../../../templates/core/ThemeVars.astro';
import BravaBody from '../../../templates/brava/BravaBody.astro';
import demo from '../../../templates/brava/demo.config';
---

<DemoLayout slug='brava' title={demo.seo.title} description={demo.seo.description} locale='en' themeColor={demo.theme.bg}>
	<ThemeVars theme={demo.theme} />
	<BravaBody config={demo} />
</DemoLayout>
