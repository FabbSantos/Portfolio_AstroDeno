---
/**
 * Client previews: /previas/<slug>, one page per data file in src/data/previas.
 * noindex + nofollow (PreviaLayout) and filtered out of the sitemap (astro.config).
 */
import PreviaLayout from '../../previas/PreviaLayout.astro';
import PreviaBody from '../../previas/PreviaBody.astro';
import ThemeVars from '../../templates/core/ThemeVars.astro';
// Upright display faces only (previews use no italic); the one the preview uses is preloaded.
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import cormorant from '@fontsource-variable/cormorant/files/cormorant-latin-wght-normal.woff2?url';
import { previas } from '../../data/previas';
import { previaPhotos } from '../../previas/photos';
import { ogPanels } from '../../previas/og';
import type { PreviaData } from '../../data/previas/types';

export function getStaticPaths() {
	return previas.map((data) => ({ params: { slug: data.slug }, props: { data } }));
}

interface Props {
	data: PreviaData;
}
const { data } = Astro.props;
const display = data.display === 'cormorant' ? cormorant : fraunces;
const url = new URL(`/previas/${data.slug}`, Astro.site).href;
// Same rule as og.jpg.ts: the image exists only when the preview has photos.
const ogImage = ogPanels(await previaPhotos(data.slug)).length ? new URL(`/previas/${data.slug}/og.jpg`, Astro.site).href : undefined;
---

<PreviaLayout slug={data.slug} title={data.seo.title} description={data.seo.description} themeColor={data.theme.bg} preload={[display]} url={url} ogImage={ogImage} ogImageAlt={`${data.name}: fotos do trabalho e do espaço`}>
	<ThemeVars theme={data.theme} />
	<PreviaBody data={data} />
</PreviaLayout>
