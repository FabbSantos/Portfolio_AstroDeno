---
/**
 * Hero: eyebrow, title, sub, two CTAs (booking + services), short highlights,
 * the portrait photo in an arch (eager: it is the LCP) and an hours card whose
 * status line becomes "Aberto agora · fecha às 19h" in the browser.
 */
import { Image } from 'astro:assets';
import type { SalviaConfig } from '../schema';
import { hoursSummary, OPEN_STRINGS } from '../hours';
import { md } from './_md';

interface Props {
	config: SalviaConfig;
}
const { config } = Astro.props;
const { hero, location, brand } = config;
const locale = brand.locale;
const summary = hoursSummary(location.hours, locale);
const status = JSON.stringify({ hours: location.hours, tz: location.timezone, locale, strings: OPEN_STRINGS[locale] });
const widths = (w: number) => [...[480, 720, 960].filter((x) => x < w), w];
---

<section class='hero wrap' aria-labelledby='salvia-hero-title'>
	<div class='copy'>
		<p class='eyebrow'>{hero.eyebrow}</p>
		<h1 id='salvia-hero-title' set:html={md(hero.title)} />
		<p class='sub'>{hero.sub}</p>
		<div class='actions'>
			<a class='btn btn-primary' href='#agendar'>{hero.cta}</a>
			<a class='btn btn-ghost' href='#especialidades'>{hero.secondaryCta}</a>
		</div>
		{
			hero.highlights.length > 0 && (
				<ul class='highlights'>
					{hero.highlights.map((h) => (
						<li>
							<svg viewBox='0 0 20 20' aria-hidden='true'>
								<path d='M5 10.5l3.2 3L15 6.5' />
							</svg>
							{h}
						</li>
					))}
				</ul>
			)
		}
	</div>

	<div class='art'>
		<div class='arch-line' aria-hidden='true'></div>
		<div class='arch'>
			{
				hero.photo && (
					<Image
						src={hero.photo}
						alt={hero.photoAlt}
						widths={widths(hero.photo.width)}
						sizes='(max-width: 900px) 86vw, 470px'
						format='webp'
						quality='high'
						loading='eager'
						fetchpriority='high'
						decoding='async'
					/>
				)
			}
		</div>
		<div class='hours-card'>
			<p class='status' data-open-status={status}>
				<span class='status-dot' aria-hidden='true'></span>
				<span data-open-text>{location.hoursTitle}</span>
			</p>
			<p class='hours-line'>{summary}</p>
		</div>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(40px, 6vw, 88px);
		align-items: center;
		padding-block: clamp(40px, 7vw, 88px) clamp(64px, 9vw, 112px);
	}
	h1 {
		margin-top: 20px;
		font-size: clamp(42px, 5.6vw, 76px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.02;
		text-wrap: balance;
	}
	.sub {
		margin-top: 22px;
		max-width: 46ch;
		font-size: clamp(17px, 1.6vw, 20px);
		line-height: 1.6;
		color: var(--ink-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 34px;
	}
	.highlights {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px 22px;
		margin-top: 30px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.highlights li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.highlights svg {
		width: 20px;
		height: 20px;
		padding: 2px;
		border-radius: 50%;
		background: var(--accent-soft);
	}
	.highlights path {
		fill: none;
		stroke: var(--accent-text);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Arch photo with an offset outline arch behind it */
	.art {
		position: relative;
		justify-self: center;
		width: min(100%, 470px);
		padding: 0 0 36px 28px;
	}
	.arch {
		position: relative;
		aspect-ratio: 4 / 5;
		border-radius: var(--arch);
		overflow: hidden;
		background:
			radial-gradient(120% 80% at 30% 20%, color-mix(in srgb, var(--accent) 22%, var(--bg)), transparent 70%),
			linear-gradient(180deg, color-mix(in srgb, var(--accent) 14%, var(--bg)), color-mix(in srgb, var(--accent) 34%, var(--bg)));
	}
	.arch :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.arch-line {
		position: absolute;
		inset: -18px 22px 58px 6px;
		border: 1.5px solid color-mix(in srgb, var(--accent) 45%, transparent);
		border-radius: var(--arch);
	}
	.hours-card {
		position: absolute;
		left: 0;
		bottom: 0;
		display: grid;
		gap: 4px;
		max-width: 300px;
		padding: 16px 20px;
		border-radius: var(--r-md);
		background: var(--bg-3);
		box-shadow:
			0 24px 50px -24px color-mix(in srgb, var(--ink) 35%, transparent),
			0 0 0 1px var(--rule);
	}
	.hours-line {
		font-size: 13px;
		line-height: 1.45;
		color: var(--ink-2);
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
		}
		.art {
			width: min(100%, 420px);
		}
	}
	@media (max-width: 480px) {
		.actions .btn {
			flex: 1 1 100%;
		}
		.art {
			padding-left: 14px;
		}
		.hours-card {
			right: 14px;
			max-width: none;
		}
	}
</style>
