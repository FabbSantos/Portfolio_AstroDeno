---
/**
 * Space (#espaco), optional: up to three photos laid out asymmetrically on the
 * 12-column grid, each with a numbered caption.
 */
import { Image } from 'astro:assets';
import type { SalviaConfig } from '../schema';
import { md } from './_md';

interface Props {
	space: NonNullable<SalviaConfig['space']>;
}
const { space } = Astro.props;
const widths = (w: number) => [...[480, 720, 960, 1280].filter((x) => x < w), w];
---

<section class='sec' id='espaco' aria-labelledby='salvia-space-title'>
	<div class='wrap'>
		<header class='sec-head'>
			<h2 id='salvia-space-title' set:html={md(space.title)} />
			{space.lead && <p class='lead'>{space.lead}</p>}
		</header>
		<div class:list={['photos', `n${space.photos.length}`]}>
			{
				space.photos.map((ph, i) => (
					<figure>
						<div class='img'>
							<Image
								src={ph.image}
								alt={ph.alt}
								widths={widths(ph.image.width)}
								sizes='(max-width: 900px) 92vw, 640px'
								format='webp'
								quality='high'
								loading='lazy'
								decoding='async'
							/>
						</div>
						{ph.caption && (
							<figcaption>
								<span class='cn'>({i + 1})</span> {ph.caption}
							</figcaption>
						)}
					</figure>
				))
			}
		</div>
	</div>
</section>

<style>
	.photos {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: 24px;
		row-gap: 40px;
		align-items: end;
	}
	figure {
		margin: 0;
	}
	.img {
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--bg-2);
	}
	.img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	figcaption {
		margin-top: 12px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.cn {
		font-variant-numeric: tabular-nums;
		color: var(--ink);
	}

	.n1 figure {
		grid-column: 3 / span 8;
	}
	.n1 .img {
		aspect-ratio: 3 / 2;
	}
	/* Portrait on the left, a wider frame offset to the right and lower. */
	.n2 figure:nth-child(1) {
		grid-column: 1 / span 5;
	}
	.n2 figure:nth-child(1) .img {
		aspect-ratio: 4 / 5;
	}
	.n2 figure:nth-child(2) {
		grid-column: 7 / span 6;
		margin-bottom: -72px;
	}
	.n2 figure:nth-child(2) .img {
		aspect-ratio: 5 / 4;
	}
	.n3 figure:nth-child(1) {
		grid-column: 1 / span 5;
	}
	.n3 figure:nth-child(1) .img {
		aspect-ratio: 4 / 5;
	}
	.n3 figure:nth-child(2) {
		grid-column: 6 / span 4;
	}
	.n3 figure:nth-child(2) .img {
		aspect-ratio: 1;
	}
	.n3 figure:nth-child(3) {
		grid-column: 10 / span 3;
	}
	.n3 figure:nth-child(3) .img {
		aspect-ratio: 3 / 4;
	}

	@media (max-width: 900px) {
		.photos figure,
		.photos figure:nth-child(n) {
			grid-column: 1 / -1;
			margin-bottom: 0;
		}
		.photos figure:nth-child(n) .img {
			aspect-ratio: 4 / 3;
		}
	}
</style>
