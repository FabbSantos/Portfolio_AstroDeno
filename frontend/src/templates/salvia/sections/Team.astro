---
/**
 * Team (#equipe), optional: photo or initials, role, council registry chip
 * (CRM, CRO, CREFITO…) and a one-line bio.
 */
import { Image } from 'astro:assets';
import type { SalviaConfig } from '../schema';
import { md } from './_md';

interface Props {
	team: NonNullable<SalviaConfig['team']>;
}
const { team } = Astro.props;
const initialsOf = (name: string) =>
	name
		.replace(/^(dra?\.?|dr\.?)\s+/i, '')
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w.charAt(0).toUpperCase())
		.join('');
---

<section class='sec' id='equipe' aria-labelledby='salvia-team-title'>
	<div class='wrap'>
		<div class='sec-h'>
			<p class='eyebrow'>{team.eyebrow}</p>
			<h2 id='salvia-team-title' set:html={md(team.title)} />
			{team.lead && <p class='lead'>{team.lead}</p>}
		</div>

		<ul class='people'>
			{
				team.people.map((p) => (
					<li class='person'>
						<div class='face'>
							{p.photo ? (
								<Image src={p.photo} alt='' width={72} height={72} densities={[1, 2]} format='webp' quality='high' loading='lazy' decoding='async' />
							) : (
								<span aria-hidden='true'>{initialsOf(p.name)}</span>
							)}
						</div>
						<div class='info'>
							<h3>{p.name}</h3>
							<p class='role'>{p.role}</p>
							{p.registry && <p class='registry'>{p.registry}</p>}
							{p.bio && <p class='bio'>{p.bio}</p>}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.people {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: 16px;
	}
	.person {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 24px;
		border-radius: var(--r-lg);
		background: var(--bg-3);
		box-shadow: 0 0 0 1px var(--rule);
	}
	/* Round on purpose: a small arch around a face reads as a headstone. */
	.face {
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		overflow: hidden;
		border-radius: 50%;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.face :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	h3 {
		font-size: 18px;
		font-weight: 650;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
	.role {
		margin-top: 2px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.registry {
		display: inline-block;
		margin-top: 10px;
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--bg-2);
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.02em;
		white-space: nowrap;
		color: var(--ink-2);
	}
	@media (max-width: 560px) {
		.person {
			flex-direction: row;
			align-items: flex-start;
			padding: 20px;
		}
		.face {
			flex: none;
			width: 60px;
			height: 60px;
			font-size: 20px;
		}
	}
	.bio {
		margin-top: 10px;
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--ink-2);
	}
</style>
