---
/**
 * Services (#especialidades), after 21st.dev "Services with Animated Hover
 * Modal" (cnippet-dev): big typographic rows on hairlines; on hover the other
 * rows dim, a photo frame trails the cursor and a small "Agendar" disc follows
 * it. Rewritten without GSAP/Framer Motion (rAF lerp + CSS transitions).
 *
 * Fine pointers only; touch and reduced motion get a plain list with a
 * thumbnail. Each row links to #agendar and preselects the service there.
 */
import { Image } from 'astro:assets';
import type { SalviaConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: SalviaConfig;
}
const { services } = Astro.props.config;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class='sec services' id='especialidades' aria-labelledby='salvia-services-title'>
	<div class='wrap'>
		<header class='sec-head'>
			<h2 id='salvia-services-title' set:html={md(services.title)} />
			{services.lead && <p class='lead'>{services.lead}</p>}
		</header>

		<ol class='rows' data-svc-list>
			{
				services.items.map((s, i) => (
					<li>
						<a class='row' href='#agendar' data-book-service={s.name} data-svc-index={i}>
							<span class='n'>{pad(i + 1)}</span>
							<span class='name serif'>{s.name}</span>
							<span class='desc'>{s.desc}</span>
							<span class='go'>
								{services.bookLabel}
								<span class='visually-hidden'>: {s.name}</span>
								<span aria-hidden='true'>&nbsp;→</span>
							</span>
							{s.photo && (
								<span class='thumb' aria-hidden='true'>
									<Image src={s.photo} alt='' width={96} height={120} densities={[1, 2]} format='webp' quality='high' loading='lazy' decoding='async' />
								</span>
							)}
						</a>
					</li>
				))
			}
		</ol>
	</div>

	<div class='float' aria-hidden='true' data-svc-float hidden>
		<div class='frame'>
			<div class='strip' data-svc-strip>
				{
					services.items.map((s) => (
						<div class='slide'>
							{s.photo ? (
								<Image src={s.photo} alt='' widths={[320, 640]} sizes='320px' format='webp' quality='high' loading='lazy' decoding='async' />
							) : (
								<span class='ph serif'>{s.name}</span>
							)}
						</div>
					))
				}
			</div>
		</div>
	</div>
	<div class='disc' aria-hidden='true' data-svc-disc hidden><span>{services.bookLabel}</span></div>
</section>

<script>
	const list = document.querySelector<HTMLElement>('[data-svc-list]');
	const float = document.querySelector<HTMLElement>('[data-svc-float]');
	const disc = document.querySelector<HTMLElement>('[data-svc-disc]');
	const strip = document.querySelector<HTMLElement>('[data-svc-strip]');
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (list && float && disc && strip && canHover && !calm) {
		let tx = 0;
		let ty = 0;
		let fx = 0;
		let fy = 0;
		let dx = 0;
		let dy = 0;
		let raf = 0;

		const place = () => {
			float.style.transform = `translate3d(${fx}px, ${fy}px, 0)`;
			disc.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
		};
		const tick = () => {
			// The frame lags behind the pointer; the disc keeps up.
			fx += (tx - fx) * 0.12;
			fy += (ty - fy) * 0.12;
			dx += (tx - dx) * 0.3;
			dy += (ty - dy) * 0.3;
			place();
			const settled = Math.abs(tx - fx) < 0.3 && Math.abs(ty - fy) < 0.3;
			raf = settled ? 0 : requestAnimationFrame(tick);
		};
		const follow = (e: PointerEvent) => {
			tx = e.clientX;
			ty = e.clientY;
			if (!raf) raf = requestAnimationFrame(tick);
		};

		list.addEventListener('pointerenter', (e) => {
			// Unhide on first visit so the lazy photos start loading only now.
			float.hidden = false;
			disc.hidden = false;
			tx = fx = dx = e.clientX;
			ty = fy = dy = e.clientY;
			place();
			list.classList.add('is-hovering');
			window.addEventListener('pointermove', follow, { passive: true });
		});
		list.addEventListener('pointerleave', () => {
			list.classList.remove('is-hovering');
			float.classList.remove('is-on');
			disc.classList.remove('is-on');
			window.removeEventListener('pointermove', follow);
		});
		list.querySelectorAll<HTMLElement>('[data-svc-index]').forEach((row) => {
			row.addEventListener('pointerenter', () => {
				strip.style.transform = `translateY(${-Number(row.dataset.svcIndex) * 100}%)`;
				float.classList.add('is-on');
				disc.classList.add('is-on');
			});
		});
	}
</script>

<style>
	.services {
		position: relative;
	}
	.rows {
		list-style: none;
		border-bottom: 1px solid var(--line);
	}
	.rows li {
		border-top: 1px solid var(--line);
	}
	.row {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) minmax(0, 340px) 110px;
		column-gap: 24px;
		align-items: center;
		padding-block: clamp(22px, 3vw, 38px);
		transition: opacity 0.35s;
	}
	.n {
		font-size: 14px;
		font-variant-numeric: tabular-nums;
		color: var(--ink-2);
	}
	.name {
		font-size: clamp(34px, 4.6vw, 64px);
		line-height: 1.02;
		letter-spacing: -0.03em;
		transition: transform 0.5s var(--ease);
	}
	.desc {
		font-size: 15.5px;
		line-height: 1.5;
		color: var(--ink-2);
		transition: transform 0.5s var(--ease);
	}
	.go {
		justify-self: end;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
	}
	.thumb {
		display: none;
	}
	.row:focus-visible {
		outline-offset: -2px;
	}

	/* Fine pointer: dim the others, slide the hovered row a touch. */
	@media (hover: hover) and (pointer: fine) {
		.rows.is-hovering .row {
			opacity: 0.32;
		}
		.rows.is-hovering .row:hover {
			opacity: 1;
		}
		.row:hover .name,
		.row:hover .desc {
			transform: translateX(12px);
		}
		.go {
			opacity: 0;
			transition: opacity 0.3s;
		}
		.row:hover .go,
		.row:focus-visible .go {
			opacity: 1;
		}
	}

	/* Photo frame + disc that trail the pointer (positioned by the script). */
	.float,
	.disc {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 60;
		pointer-events: none;
	}
	.frame {
		width: 300px;
		height: 375px;
		margin: -187px 0 0 -150px;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--bg-2);
		transform: scale(0);
		transition: transform 0.45s var(--ease);
		box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--ink) 55%, transparent);
	}
	.float:global(.is-on) .frame {
		transform: scale(1);
	}
	.strip {
		height: 100%;
		transition: transform 0.6s var(--ease);
	}
	.slide {
		height: 100%;
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--accent) 18%, var(--bg));
	}
	.slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.ph {
		padding: 24px;
		font-size: 34px;
		line-height: 1.1;
		text-align: center;
		color: var(--ink);
	}
	.disc span {
		display: grid;
		place-items: center;
		width: 88px;
		height: 88px;
		margin: -44px 0 0 -44px;
		border-radius: 50%;
		background: var(--ink);
		color: var(--bg);
		font-size: 13px;
		font-weight: 600;
		transform: scale(0);
		transition: transform 0.35s var(--ease);
	}
	.disc:global(.is-on) span {
		transform: scale(1);
	}

	/* Touch / narrow: plain list with a thumbnail, the action always visible. */
	@media (max-width: 900px), (hover: none) {
		.row {
			grid-template-columns: 36px minmax(0, 1fr) auto;
			grid-template-areas:
				'n name thumb'
				'. desc thumb'
				'. go thumb';
			row-gap: 6px;
			align-items: start;
		}
		.n {
			grid-area: n;
			padding-top: 10px;
		}
		.name {
			grid-area: name;
			font-size: clamp(30px, 7vw, 40px);
		}
		.desc {
			grid-area: desc;
		}
		.go {
			grid-area: go;
			justify-self: start;
			opacity: 1;
			display: inline-flex;
			align-items: center;
			min-height: 44px;
			color: var(--accent-text);
		}
		.thumb {
			grid-area: thumb;
			display: block;
			width: 72px;
			aspect-ratio: 4 / 5;
			overflow: hidden;
			border-radius: var(--radius);
		}
		.thumb :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.float,
		.disc {
			display: none;
		}
	}
</style>
