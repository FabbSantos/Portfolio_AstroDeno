---
/**
 * Booking (#agendar) as a reception form: hairline rows for service, period and
 * name on the left; the composed WhatsApp message printed on a paper ticket on
 * the right. Submitting opens wa.me with that text.
 *
 * Works without JS: the form GETs wa.me with the default message in `text`.
 * `demo` (portfolio page only) keeps it interactive without a number: submit
 * shows a note instead of opening WhatsApp.
 */
import type { SalviaConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: SalviaConfig;
	demo?: boolean;
}
const { config, demo = false } = Astro.props;
const { booking, services, contact, brand } = config;
const en = brand.locale === 'en';

const action = contact.whatsapp ? `https://wa.me/${contact.whatsapp.number}` : undefined;
const initial = booking.message
	.replace('{servico}', services.items[0]?.name ?? '')
	.replace('{periodo}', (booking.periods[0] ?? '').toLowerCase());
const demoNote = en
	? 'Demo: on the published site this button opens the clinic’s WhatsApp with this message.'
	: 'Demo: no site publicado, este botão abre o WhatsApp da clínica com essa mensagem.';
const via = en ? 'via WhatsApp' : 'pelo WhatsApp';
---

<section class='sec booking' id='agendar' aria-labelledby='salvia-booking-title'>
	<div class='wrap grid'>
		<div class='left'>
			<h2 id='salvia-booking-title' class='serif' set:html={md(booking.title)} />
			<p class='lead'>{booking.lead}</p>

			<form
				class='form'
				action={action}
				method='get'
				target='_blank'
				data-booking
				data-message={booking.message}
				data-name-sentence={booking.nameSentence}
				data-demo={demo ? '' : undefined}
			>
				<fieldset class='field'>
					<legend>{booking.serviceLabel}</legend>
					<div class='opts'>
						{
							services.items.map((s, i) => (
								<label class='opt'>
									<input type='radio' name='servico' value={s.name} checked={i === 0} />
									<span>{s.name}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class='field'>
					<legend>{booking.periodLabel}</legend>
					<div class='opts'>
						{
							booking.periods.map((p, i) => (
								<label class='opt'>
									<input type='radio' name='periodo' value={p} checked={i === 0} />
									<span>{p}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<label class='field name'>
					<span class='legend'>{booking.nameLabel}</span>
					<input name='nome' type='text' autocomplete='given-name' maxlength='60' />
				</label>

				<input type='hidden' name='text' value={initial} />

				<div class='submit'>
					<button class='btn' type='submit'>
						{booking.cta}
						<span class='arr' aria-hidden='true'>↗</span>
					</button>
					{booking.foot && <p class='foot'>{booking.foot}</p>}
				</div>
				<p class='demo-note' data-booking-note role='status' hidden>{demoNote}</p>
			</form>
		</div>

		<figure class='ticket'>
			<figcaption class='t-head'>
				<span class='t-label'>{booking.previewLabel}</span>
				<strong class='serif'>{brand.name}</strong>
			</figcaption>
			<blockquote class='t-body serif'>
				<p data-booking-preview>{initial}</p>
			</blockquote>
			<div class='t-foot'>
				<span>{via}</span>
				<span aria-hidden='true'>✳︎</span>
			</div>
		</figure>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLFormElement>('form[data-booking]').forEach((form) => {
		const preview = form.closest('.booking')?.querySelector<HTMLElement>('[data-booking-preview]');
		const note = form.querySelector<HTMLElement>('[data-booking-note]');
		const hidden = form.elements.namedItem('text') as HTMLInputElement | null;
		const value = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value ?? '';

		const compose = () => {
			const text = (form.dataset.message ?? '').replace('{servico}', value('servico')).replace('{periodo}', value('periodo').toLowerCase());
			const nome = value('nome').trim();
			return nome ? `${text} ${(form.dataset.nameSentence ?? '').replace('{nome}', nome)}` : text;
		};
		const sync = () => {
			const text = compose();
			if (preview) preview.textContent = text;
			if (hidden) hidden.value = text;
		};

		form.addEventListener('input', sync);
		form.addEventListener('change', sync);
		sync();

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			sync();
			if (form.hasAttribute('data-demo') || !form.getAttribute('action')) {
				if (note) note.hidden = false;
				return;
			}
			window.open(`${form.getAttribute('action')}?text=${encodeURIComponent(compose())}`, '_blank', 'noopener');
		});
	});

	// Service rows link here with that service preselected.
	document.querySelectorAll<HTMLAnchorElement>('[data-book-service]').forEach((link) => {
		link.addEventListener('click', () => {
			const radios = document.querySelectorAll<HTMLInputElement>('form[data-booking] input[name="servico"]');
			const match = Array.from(radios).find((r) => r.value === link.dataset.bookService);
			if (!match) return;
			match.checked = true;
			match.dispatchEvent(new Event('change', { bubbles: true }));
		});
	});
</script>

<style>
	.booking {
		background: var(--bg-2);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: 24px;
		row-gap: 48px;
		align-items: start;
	}
	.left {
		grid-column: 1 / span 6;
	}
	h2 {
		font-size: clamp(40px, 5.4vw, 76px);
		line-height: 1;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.lead {
		margin-top: 20px;
		max-width: 44ch;
		font-size: 17px;
		line-height: 1.6;
		color: var(--ink-2);
	}

	.form {
		margin-top: clamp(36px, 5vw, 56px);
		border-bottom: 1px solid var(--line);
	}
	.field {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr);
		column-gap: 20px;
		align-items: center;
		min-width: 0;
		margin: 0;
		padding: 18px 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	legend,
	.legend {
		float: left;
		width: 150px;
		padding: 0;
		font-size: 14px;
		color: var(--ink-2);
	}
	.opts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.opt {
		position: relative;
		cursor: pointer;
	}
	.opt input {
		position: absolute;
		inset: 0;
		opacity: 0;
		cursor: pointer;
	}
	.opt span {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 16px;
		border-radius: var(--radius);
		box-shadow: inset 0 0 0 1px var(--line);
		font-size: 15px;
		transition:
			background 0.2s,
			color 0.2s,
			box-shadow 0.2s;
	}
	.opt:hover span {
		box-shadow: inset 0 0 0 1px var(--ink-2);
	}
	.opt input:checked + span {
		background: var(--ink);
		color: var(--bg);
		box-shadow: none;
	}
	.opt input:focus-visible + span {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.name input {
		width: 100%;
		max-width: 320px;
		min-height: 44px;
		padding: 0;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 18px;
	}
	.name input:focus-visible {
		outline: none;
		border-bottom: 2px solid var(--accent);
	}
	.submit {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
		padding: 24px 0;
		border-top: 1px solid var(--line);
	}
	.foot {
		font-size: 14px;
		color: var(--ink-2);
	}
	.demo-note {
		margin-bottom: 20px;
		padding: 12px 14px;
		border-left: 2px solid var(--accent);
		background: var(--bg);
		font-size: 14px;
		color: var(--ink-2);
	}

	/* The message on a paper ticket, perforated between head and body. */
	.ticket {
		grid-column: 8 / span 5;
		position: sticky;
		top: 104px;
		margin: 0;
		background: var(--bg-3);
		border-radius: var(--radius);
		box-shadow:
			0 1px 0 var(--line),
			0 40px 70px -45px color-mix(in srgb, var(--ink) 50%, transparent);
	}
	.t-head {
		display: grid;
		gap: 4px;
		padding: 24px 28px 22px;
		border-bottom: 1px dashed var(--line);
		position: relative;
	}
	.t-head::before,
	.t-head::after {
		content: '';
		position: absolute;
		bottom: -9px;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: var(--bg-2);
	}
	.t-head::before {
		left: -9px;
	}
	.t-head::after {
		right: -9px;
	}
	.t-label {
		font-size: 13px;
		color: var(--ink-2);
	}
	.t-head strong {
		font-size: 26px;
		line-height: 1.15;
		font-weight: 400;
	}
	.t-body {
		margin: 0;
		padding: 30px 28px 34px;
		min-height: 220px;
	}
	.t-body p {
		font-size: clamp(24px, 2.4vw, 32px);
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}
	.t-body p::before {
		content: '“';
	}
	.t-body p::after {
		content: '”';
	}
	.t-foot {
		display: flex;
		justify-content: space-between;
		padding: 14px 28px;
		border-top: 1px solid var(--line);
		font-size: 13px;
		color: var(--ink-2);
	}

	@media (max-width: 900px) {
		.left,
		.ticket {
			grid-column: 1 / -1;
		}
		.ticket {
			position: static;
		}
	}
	@media (max-width: 560px) {
		.field {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 10px;
		}
		legend,
		.legend {
			width: auto;
			margin-bottom: 10px;
		}
		.submit .btn {
			flex: 1 1 100%;
		}
	}
</style>
