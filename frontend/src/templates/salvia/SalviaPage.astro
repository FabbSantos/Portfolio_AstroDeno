---
/**
 * Full standalone page for a client deploy: core Page (head, theme, WhatsApp
 * FAB, LGPD notice) wrapping the Sálvia body. `src/pages/index.astro` of a
 * scaffolded client is just `<SalviaPage config={site} />`.
 *
 * The booking widget opens WhatsApp, so a client build without
 * `contact.whatsapp` fails here instead of shipping a dead button.
 */
import Page from '../core/Page.astro';
import SalviaBody from './SalviaBody.astro';
import type { SalviaConfig } from './schema';

interface Props {
	config: SalviaConfig;
	noindex?: boolean;
}
const { config, noindex = false } = Astro.props;

if (!config.contact.whatsapp) {
	throw new Error('site.config.ts: 1 problem(s) found\n  - contact.whatsapp: required by the Sálvia booking widget (number with country code, e.g. 5521999998888)\n');
}
---

<Page site={config} class='page-salvia' noindex={noindex} preloadFonts={false}>
	<main id='main-content'>
		<SalviaBody config={config} />
	</main>
</Page>
