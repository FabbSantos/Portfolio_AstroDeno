---
/**
 * Desktop topbar (brand · tagline · nav · underlined CTA) ≥ 900px; below
 * that the core MobileNav takes over (44px hamburger, inert panel, Escape).
 * Only one of the two is displayed at any width.
 */
import { Image } from 'astro:assets';
import MobileNav from '../../core/MobileNav.astro';
import type { MiranteConfig } from '../schema';

interface Props {
	config: MiranteConfig;
}
const { brand, nav, topbar } = Astro.props.config;
---

<header class='tb'>
	<div class='tb-inner'>
		<a href={topbar.brandHref} class='brand'>
			{
				brand.logo ? (
					<Image class='brand-logo' src={brand.logo} alt={brand.name} height={28} densities={[1, 2]} format='webp' loading='eager' />
				) : (
					brand.name
				)
			}
			<span class='dot' aria-hidden='true'>●</span>
			{brand.tagline && <span class='loc'>{brand.tagline}</span>}
		</a>
		<nav class='tb-nav' aria-label='Menu'>
			{nav.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
		<a href={topbar.cta.href} class='tb-cta'>{topbar.cta.label}</a>
	</div>
</header>
<div class='tb-mobile'>
	<MobileNav brand={brand.name} brandHref={topbar.brandHref} nav={nav} cta={topbar.cta} id='mirante-nav' />
</div>

<style>
	.tb {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--topbar);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--rule);
	}
	.tb-inner {
		max-width: 1240px;
		margin: 0 auto;
		padding: 18px 32px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}
	.tb-nav {
		display: flex;
		gap: 26px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.tb-nav a:hover {
		color: var(--accent);
	}
	.tb-cta {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink);
		font-weight: 600;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
		white-space: nowrap;
	}
	@media (max-width: 960px) {
		.tb .tb-inner :global(.brand .loc) {
			display: none;
		}
	}

	/* Mobile: core MobileNav, restyled to the Mirante look */
	.tb-mobile {
		display: none;
	}
	.tb-mobile :global(.mnav) {
		z-index: 40;
	}
	.tb-mobile :global(.mnav-brand) {
		font-weight: 700;
		font-size: 19px;
		letter-spacing: -0.02em;
	}
	.tb-mobile :global(.mnav-cta) {
		border-radius: var(--r-btn);
		background: var(--ink);
	}
	@media (max-width: 899.98px) {
		.tb {
			display: none;
		}
		.tb-mobile {
			display: block;
		}
	}
</style>
