---
/**
 * Desktop topbar (≥ 900px): sits over the hero photo in paper-coloured text
 * and turns solid once the hero scrolls past. Sticky with a negative bottom
 * margin, so the hero starts underneath it and the demo ribbon (also sticky)
 * keeps its place. Below 900px the core MobileNav takes over, solid.
 */
import { Image } from 'astro:assets';
import MobileNav from '../../core/MobileNav.astro';
import type { MiranteConfig } from '../schema';

interface Props {
	config: MiranteConfig;
}
const { brand, nav, topbar } = Astro.props.config;
---

<header class='tb' data-tb>
	<div class='tb-inner'>
		<a href={topbar.brandHref} class='tb-brand'>
			{
				brand.logo ? (
					<Image class='tb-logo' src={brand.logo} alt={brand.name} height={28} densities={[1, 2]} format='webp' loading='eager' quality='high' />
				) : (
					<span class='tb-name'>{brand.name}</span>
				)
			}
			{brand.tagline && <span class='tb-loc'>{brand.tagline}</span>}
		</a>
		<nav class='tb-nav' aria-label='Menu'>
			{nav.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
		<a href={topbar.cta.href} class='tb-cta'>{topbar.cta.label}</a>
	</div>
</header>
<div class='tb-mobile'>
	<MobileNav brand={brand.name} brandHref={topbar.brandHref} nav={nav} cta={topbar.cta} id='mirante-nav' />
</div>

<script>
	// Solid once the hero has scrolled by (its height minus the bar).
	document.querySelectorAll<HTMLElement>('[data-tb]').forEach((tb) => {
		const hero = tb.parentElement?.querySelector<HTMLElement>('[data-hero]');
		if (!hero) return;
		let ticking = false;
		const update = () => {
			ticking = false;
			tb.classList.toggle('is-solid', window.scrollY > hero.offsetHeight - tb.offsetHeight - 8);
		};
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true }
		);
		update();
	});
</script>

<style>
	.tb {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--tb-h);
		margin-bottom: calc(-1 * var(--tb-h));
		color: #fff;
		transition:
			background 0.35s,
			color 0.35s,
			border-color 0.35s;
		border-bottom: 1px solid transparent;
	}
	.tb.is-solid {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		color: var(--ink);
		border-bottom-color: var(--line-soft);
	}
	.tb-inner {
		max-width: var(--wrap);
		height: 100%;
		margin: 0 auto;
		padding: 0 var(--pad-x);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 32px;
	}
	.tb-brand {
		display: inline-flex;
		align-items: baseline;
		gap: 14px;
	}
	.tb-name {
		font-family: var(--display);
		font-size: 30px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1;
	}
	.tb-logo {
		height: 28px;
		width: auto;
	}
	.tb.is-solid .tb-logo {
		filter: none;
	}
	.tb:not(.is-solid) .tb-logo {
		filter: brightness(0) invert(1);
	}
	.tb-loc {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.75;
	}
	.tb-nav {
		display: flex;
		gap: 30px;
		font-size: 15px;
		font-weight: 500;
	}
	.tb-nav a {
		opacity: 0.85;
		transition: opacity 0.2s;
	}
	.tb-nav a:hover {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 1px;
	}
	.tb-cta {
		font-size: 15px;
		font-weight: 600;
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 1px;
		text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
		transition: text-decoration-color 0.2s;
	}
	.tb-cta:hover {
		text-decoration-color: currentColor;
	}
	@media (max-width: 1060px) {
		.tb-loc {
			display: none;
		}
	}

	.tb-mobile {
		display: none;
	}
	@media (max-width: 899.98px) {
		.tb {
			display: none;
		}
		.tb-mobile {
			display: block;
		}
	}
</style>
