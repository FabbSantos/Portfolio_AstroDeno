---
/**
 * Payment conditions: three columns separated by hairlines, no cards. Each
 * headline is a serif h3 in one style ('Desconto de até 12%'); the featured
 * option sits on a block of the accent colour.
 */
import type { MiranteConfig } from '../schema';

interface Props {
	config: MiranteConfig;
}
const { conditions } = Astro.props.config;
---

<section class='valores sec' id='valores' aria-labelledby='valores-title'>
	<div class='wrap'>
		<div class='sec-head'>
			<h2 id='valores-title' class='display'>{conditions.title}</h2>
		</div>
		<div class='val-grid' style={`--cols:${conditions.items.length}`}>
			{
				conditions.items.map((c) => (
					<article class:list={['val', { 'is-featured': c.featured }]}>
						<p class='v-tag'>
							<span>{c.tag}</span>
							{c.badge && <span class='v-badge'>{c.badge}</span>}
						</p>
						<h3 class='v-h'>{c.headline}</h3>
						<p class='v-d'>{c.desc}</p>
						{c.bullets.length > 0 && (
							<ul class='v-list'>
								{c.bullets.map((b) => (
									<li>{b}</li>
								))}
							</ul>
						)}
					</article>
				))
			}
		</div>
		{conditions.foot && <p class='val-foot'>{conditions.foot}</p>}
	</div>
</section>

<style>
	.val-grid {
		display: grid;
		grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.val {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 36px 28px 40px;
		border-left: 1px solid var(--line);
	}
	.val:first-child {
		border-left: 0;
		padding-left: 0;
	}
	.val:last-child {
		padding-right: 0;
	}
	.val.is-featured {
		background: var(--accent-text);
		color: #fff;
		border-left-color: transparent;
		padding-inline: 32px;
		margin-block: -1px;
	}
	.val.is-featured + .val {
		border-left-color: transparent;
	}
	.v-tag {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
	}
	.is-featured .v-tag {
		color: color-mix(in srgb, #fff 78%, transparent);
	}
	.v-badge {
		padding: 4px 8px;
		background: var(--ink);
		color: var(--bg);
	}
	.is-featured .v-badge {
		background: #fff;
		color: var(--accent-text);
	}
	/* One style: the serif display at a heading size, no figure set apart */
	.v-h {
		font-family: var(--display);
		font-size: clamp(30px, 2.8vw, 40px);
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	.v-d {
		font-size: 15px;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 32ch;
	}
	.is-featured .v-d {
		color: color-mix(in srgb, #fff 86%, transparent);
	}
	.v-list {
		list-style: none;
		margin-top: 6px;
	}
	.v-list li {
		padding: 10px 0;
		font-size: 14px;
		color: var(--ink-2);
		border-top: 1px solid var(--line-soft);
	}
	.is-featured .v-list li {
		color: color-mix(in srgb, #fff 90%, transparent);
		border-top-color: color-mix(in srgb, #fff 22%, transparent);
	}
	.val-foot {
		margin-top: 20px;
		font-family: var(--mono);
		font-size: 11px;
		line-height: 1.6;
		color: var(--ink-3);
	}
	@media (max-width: 900px) {
		.val-grid {
			grid-template-columns: minmax(0, 1fr);
			border-top: 0;
		}
		.val,
		.val:first-child,
		.val:last-child {
			border-left: 0;
			border-top: 1px solid var(--line);
			padding: 32px 0 36px;
		}
		.val.is-featured {
			padding-inline: 24px;
			margin-inline: 0;
			margin-block: 0;
			border-top-color: transparent;
		}
		.val.is-featured + .val {
			border-top-color: transparent;
		}
	}
</style>
