---
/** Numbers row under the hero: serif numerals between hairlines, mono labels. 3 / 2 columns on small screens. */
import type { MiranteConfig } from '../schema';

interface Props {
	config: MiranteConfig;
}
const { stats } = Astro.props.config;
---

<section class='numbers' aria-label='Números'>
	<div class='wrap'>
		<dl class='n-grid' style={`--cols:${stats.length}`}>
			{
				stats.map((s) => (
					<div class='n'>
						<dd class='v display'>{s.v}</dd>
						<dt class='l'>{s.l}</dt>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.numbers {
		padding-block: 8px;
	}
	.n-grid {
		display: grid;
		grid-template-columns: repeat(var(--cols, 6), minmax(0, max-content));
		justify-content: space-between;
		column-gap: 24px;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.n {
		display: flex;
		flex-direction: column-reverse;
		gap: 6px;
		padding: 26px 0 24px 20px;
		border-left: 1px solid var(--line);
		white-space: nowrap;
	}
	.n:first-child {
		border-left: 0;
		padding-left: 0;
	}
	.n .v {
		font-size: clamp(36px, 3.6vw, 56px);
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.n .l {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	@media (max-width: 900px) {
		.n-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: 0;
		}
		.n {
			white-space: normal;
		}
		.n {
			padding: 20px 14px 18px;
		}
		.n:nth-child(3n + 1) {
			border-left: 0;
			padding-left: 0;
		}
		.n:nth-child(n + 4) {
			border-top: 1px solid var(--line);
		}
	}
	@media (max-width: 540px) {
		.n-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.n:nth-child(3n + 1) {
			border-left: 1px solid var(--line);
			padding-left: 14px;
		}
		.n:nth-child(2n + 1) {
			border-left: 0;
			padding-left: 0;
		}
		.n:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}
		.n .v {
			font-size: 34px;
		}
	}
</style>
