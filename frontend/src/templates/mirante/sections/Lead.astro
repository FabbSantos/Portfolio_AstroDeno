---
/**
 * High-intent lead block over the second gallery photo, darkened: pitch and
 * bullets on the left, the core LeadForm (`full`) on a paper panel at the
 * right. Field labels come from `lead.labels`; the "tipologia" options from
 * `plans.items`.
 */
import { Image } from 'astro:assets';
import LeadForm from '../../core/LeadForm.astro';
import type { LeadField } from '../../core/schema';
import type { MiranteConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: MiranteConfig;
}
const { config } = Astro.props;
const { lead, plans, legal, hero } = config;
const L = lead.labels;
const photo = hero.gallery[hero.gallery.length > 1 ? 1 : 0];

const fields: LeadField[] = [
	{ name: 'nome', label: L.nome, type: 'text', required: true, autocomplete: 'name' },
	{ name: 'email', label: L.email, type: 'email', required: true },
	{ name: 'telefone', label: L.telefone, type: 'tel', required: true, placeholder: '(11) 99999-9999' },
	{ name: 'tipologia', label: L.tipologia, type: 'select', options: [L.qualquer, ...plans.items.map((t) => `${t.tag} · ${t.m2}`)] },
	{ name: 'horario', label: L.horario, type: 'select', options: lead.times },
	{ name: 'mensagem', label: L.mensagem, type: 'textarea', placeholder: lead.messagePlaceholder },
];

// "…concorda com nossa Política de Privacidade." → the label becomes a link when legal.privacyUrl exists.
const footParts = lead.foot && legal.privacyUrl && lead.foot.includes(lead.privacyLabel) ? lead.foot.split(lead.privacyLabel) : null;
const widths = (w: number) => [...[960, 1600, 2400].filter((x) => x < w), w];
---

<section class='lead' id='lead' aria-labelledby='lead-title'>
	<div class='lead-media' aria-hidden='true'>
		{photo && <Image src={photo.image} alt='' widths={widths(photo.image.width)} sizes='100vw' format='webp' quality={72} loading='lazy' decoding='async' />}
	</div>
	<div class='wrap lead-inner'>
		<div class='lead-l'>
			{lead.eyebrow && <p class='eyebrow'>{lead.eyebrow}</p>}
			<h2 id='lead-title' class='display' set:html={md(lead.title)} />
			<p class='lead-sub'>{lead.sub}</p>
			{
				lead.bullets.length > 0 && (
					<ul class='lead-bullets'>
						{lead.bullets.map((b) => (
							<li>{b}</li>
						))}
					</ul>
				)
			}
		</div>
		<div class='big-form'>
			<LeadForm site={config} id='mirante-lead' variant='full' fields={fields} cta={lead.cta} source='lead' />
			{
				lead.foot && (
					<p class='mf-foot'>
						{footParts ? (
							<>
								{footParts[0]}
								<a href={legal.privacyUrl}>{lead.privacyLabel}</a>
								{footParts.slice(1).join(lead.privacyLabel)}
							</>
						) : (
							lead.foot
						)}
					</p>
				)
			}
		</div>
	</div>
</section>

<style>
	.lead {
		position: relative;
		isolation: isolate;
		padding-block: clamp(80px, 10vw, 140px);
		color: #fff;
		background: var(--ink);
	}
	.lead-media {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
	}
	.lead-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.55;
	}
	.lead-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, color-mix(in srgb, var(--ink) 78%, transparent) 0%, color-mix(in srgb, var(--ink) 35%, transparent) 100%);
	}
	.lead-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(40px, 6vw, 96px);
		align-items: center;
	}
	.lead-l .eyebrow {
		color: color-mix(in srgb, #fff 70%, transparent);
		margin-bottom: 18px;
	}
	.lead-l h2 {
		font-size: clamp(48px, 5.8vw, 92px);
		max-width: 12ch;
	}
	.lead-sub {
		margin: 24px 0 28px;
		font-size: 17px;
		line-height: 1.6;
		color: color-mix(in srgb, #fff 82%, transparent);
		max-width: 44ch;
	}
	.lead-bullets {
		list-style: none;
		border-top: 1px solid var(--line-on-dark);
		max-width: 44ch;
	}
	.lead-bullets li {
		padding: 12px 0;
		border-bottom: 1px solid var(--line-on-dark);
		font-size: 15px;
		color: color-mix(in srgb, #fff 88%, transparent);
	}
	.big-form {
		background: var(--bg);
		color: var(--ink);
		padding: clamp(28px, 3.5vw, 48px);
	}
	.big-form :global(.lead-form .lf-body) {
		gap: 22px 24px;
	}
	/* Name spans both columns; the rest pairs up (e-mail + phone, plan + time). */
	.big-form :global(.lead-form .lf-field:first-child) {
		grid-column: 1 / -1;
	}
	.big-form :global(.lead-form .lf-submit) {
		justify-self: stretch;
		margin-top: 8px;
	}
	@media (max-width: 900px) {
		.lead-inner {
			grid-template-columns: minmax(0, 1fr);
			gap: 40px;
		}
		.big-form :global(.lead-form .lf-body) {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
