---
/**
 * Location: the map (client image · Google Maps embed · CSS wireframe with
 * the brand marker and numbered pins) + the numbered list of points of
 * interest. POIs are numbered 01… in config order.
 */
import { Image } from 'astro:assets';
import type { MiranteConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: MiranteConfig;
}
const { brand, location } = Astro.props.config;
const { map, poi } = location;

const num = (i: number) => String(i + 1).padStart(2, '0');
/** Where the wireframe pins of the first six POIs go. */
const spots = [
	{ top: '52%', left: '54%' },
	{ top: '40%', left: '64%' },
	{ top: '30%', left: '30%' },
	{ top: '70%', left: '40%' },
	{ top: '20%', left: '78%' },
	{ top: '80%', left: '70%' },
];
const mapTitle = brand.locale === 'en' ? `Map — ${brand.name}` : `Mapa — ${brand.name}`;
/** srcset widths, capped at the source width. */
const widths = (w: number) => [...[640, 960, 1300].filter((x) => x < w), w];
---

<section class='local' id='local' aria-labelledby='local-title'>
	<div class='sec-h'>
		{location.eyebrow && <p class='eyebrow'>{location.eyebrow}</p>}
		<h2 id='local-title' set:html={md(location.title)} />
	</div>
	<div class='local-grid'>
		{
			map.kind === 'image' ? (
				<figure class='map map--img'>
					<Image
						src={map.image}
						alt={map.alt ?? mapTitle}
						widths={widths(map.image.width)}
						sizes='(max-width: 900px) calc(100vw - 64px), 680px'
						format='webp'
						loading='lazy'
						decoding='async'
					/>
				</figure>
			) : map.kind === 'gmaps' ? (
				<div class='map map--embed'>
					<iframe src={map.embedUrl} title={mapTitle} loading='lazy' allowfullscreen referrerpolicy='no-referrer-when-downgrade' />
				</div>
			) : (
				<div class='map' aria-hidden='true'>
					<div class='map-grid' />
					<span class='map-here'>{brand.name}</span>
					{poi.slice(0, spots.length).map((p, i) => (
						<span class='pin' style={`top:${spots[i]?.top};left:${spots[i]?.left}`} aria-label={p.name}>
							{num(i)}
						</span>
					))}
				</div>
			)
		}
		<ul class='poi'>
			{
				poi.map((p, i) => (
					<li>
						<span class='p-n'>{num(i)}</span>
						<div class='p-info'>
							<b>{p.name}</b>
							<span class='p-d'>{p.d}</span>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.local {
		padding: 60px 0 100px;
	}
	.local-grid {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 32px;
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 40px;
	}
	.map {
		position: relative;
		aspect-ratio: 1.3;
		background:
			radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 60%),
			linear-gradient(135deg, color-mix(in srgb, var(--bg-2) 96%, var(--ink)) 0%, var(--bg-2) 100%);
		border-radius: var(--r-card);
		border: 1px solid var(--rule);
		overflow: hidden;
	}
	.map--img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.map--embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.map-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px);
		background-size: 40px 40px;
	}
	.map-here {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		background: var(--ink);
		color: #fff;
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 8px 14px;
		border-radius: var(--r-btn);
		box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--ink) 40%, transparent);
	}
	.map-here::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		width: 0;
		height: 0;
		border-left: 6px solid transparent;
		border-right: 6px solid transparent;
		border-top: 6px solid var(--ink);
	}
	.pin {
		position: absolute;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: translate(-50%, -50%);
		box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 50%, transparent);
		border: 2px solid #fff;
	}
	.poi {
		list-style: none;
		display: flex;
		flex-direction: column;
	}
	.poi li {
		display: grid;
		grid-template-columns: 36px 1fr;
		gap: 14px;
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
		align-items: center;
	}
	.p-n {
		font-family: var(--mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--accent);
		text-align: center;
	}
	.p-info {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
	}
	.p-info b {
		font-size: 15px;
		font-weight: 600;
	}
	.p-d {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
	}
	@media (max-width: 900px) {
		.local-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
