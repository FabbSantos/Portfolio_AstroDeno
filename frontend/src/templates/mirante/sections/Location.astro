---
/**
 * Location, on an ink block: the map (client image · Google Maps embed · CSS
 * wireframe with a grid, the brand marker and numbered pins) and the list of
 * points of interest with distances aligned right. POIs are numbered 01… in
 * config order.
 */
import { Image } from 'astro:assets';
import type { MiranteConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: MiranteConfig;
}
const { brand, location } = Astro.props.config;
const { map, poi } = location;

const num = (i: number) => String(i + 1).padStart(2, '0');
/** Where the wireframe pins of the first six POIs go. */
const spots = [
	{ top: '52%', left: '54%' },
	{ top: '40%', left: '64%' },
	{ top: '30%', left: '30%' },
	{ top: '70%', left: '40%' },
	{ top: '20%', left: '78%' },
	{ top: '80%', left: '70%' },
];
const mapTitle = brand.locale === 'en' ? `Map · ${brand.name}` : `Mapa · ${brand.name}`;
const widths = (w: number) => [...[640, 960, 1300].filter((x) => x < w), w];
---

<section class='local sec' id='local' aria-labelledby='local-title'>
	<div class='wrap'>
		<div class='sec-head'>
			{location.eyebrow && <p class='eyebrow'>{location.eyebrow}</p>}
			<h2 id='local-title' class='display' set:html={md(location.title)} />
		</div>
		<div class='local-grid'>
			{
				map.kind === 'image' ? (
					<figure class='map map--img'>
						<Image src={map.image} alt={map.alt ?? mapTitle} widths={widths(map.image.width)} sizes='(max-width: 900px) calc(100vw - 40px), 56vw' format='webp' quality={80} loading='lazy' decoding='async' />
					</figure>
				) : map.kind === 'gmaps' ? (
					<div class='map map--embed'>
						<iframe src={map.embedUrl} title={mapTitle} loading='lazy' allowfullscreen referrerpolicy='no-referrer-when-downgrade' />
					</div>
				) : (
					<div class='map map--wire' aria-hidden='true'>
						<div class='map-grid' />
						<span class='map-here'>{brand.name}</span>
						{poi.slice(0, spots.length).map((_, i) => (
							<span class='pin' style={`top:${spots[i]?.top};left:${spots[i]?.left}`}>
								{num(i)}
							</span>
						))}
					</div>
				)
			}
			<ol class='poi'>
				{
					poi.map((p, i) => (
						<li>
							<span class='p-n display'>{num(i)}</span>
							<span class='p-name'>{p.name}</span>
							<span class='p-d'>{p.d}</span>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.local {
		background: var(--ink);
		color: var(--bg);
	}
	.local .eyebrow {
		color: color-mix(in srgb, var(--bg) 62%, transparent);
	}
	.local-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: clamp(32px, 5vw, 72px);
		align-items: start;
	}
	.map {
		position: relative;
		aspect-ratio: 13 / 10;
		margin: 0;
		border: 1px solid var(--line-on-dark);
		overflow: hidden;
		background: color-mix(in srgb, var(--bg) 8%, var(--ink));
	}
	.map--img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.map--embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		filter: grayscale(0.2);
	}
	.map-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(color-mix(in srgb, var(--bg) 9%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--bg) 9%, transparent) 1px, transparent 1px);
		background-size: 48px 48px;
	}
	.map-here {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		padding: 8px 14px;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--display);
		font-size: 20px;
		font-weight: 600;
		line-height: 1;
	}
	.map-here::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		width: 1px;
		height: 22px;
		background: var(--bg);
	}
	.pin {
		position: absolute;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--accent-on-dark);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 600;
		transform: translate(-50%, -50%);
	}
	/* Static ring: six looping animations cost real rendering time on phones */
	.pin::before {
		content: '';
		position: absolute;
		inset: -6px;
		border-radius: 50%;
		border: 1px solid var(--accent-on-dark);
		opacity: 0.45;
	}
	.poi {
		list-style: none;
		border-top: 1px solid var(--line-on-dark);
	}
	.poi li {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 16px;
		padding: 18px 0;
		border-bottom: 1px solid var(--line-on-dark);
	}
	.p-n {
		font-size: 28px;
		color: var(--accent-on-dark);
		line-height: 1;
	}
	.p-name {
		font-size: 18px;
		font-weight: 500;
	}
	.p-d {
		font-family: var(--mono);
		font-size: 13px;
		color: color-mix(in srgb, var(--bg) 62%, transparent);
		font-variant-numeric: tabular-nums;
	}
	@media (max-width: 900px) {
		.local-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
