---
/**
 * Footer: address and info columns, the legal strip (`legal.lines` with the
 * CNPJ after the first line, copyright and privacy link) and the brand name
 * set giant across the bottom.
 */
import { Image } from 'astro:assets';
import type { MiranteConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: MiranteConfig;
}
const { brand, topbar, footer, legal } = Astro.props.config;

const [first, ...rest] = legal.lines;
const legalLine = [first, legal.cnpj ? `CNPJ ${legal.cnpj}` : undefined, ...rest].filter(Boolean).join(' · ');
const copyright = footer.copyright ?? `© ${new Date().getFullYear()}`;
const privacyLabel = brand.locale === 'en' ? 'Privacy' : 'Privacidade';
---

<footer class='ft'>
	<div class='wrap'>
		<div class='ft-top'>
			<div class='ft-brand'>
				<a href={topbar.brandHref} class='ft-mark'>
					{brand.logo ? <Image class='ft-logo' src={brand.logo} alt={brand.name} height={28} densities={[1, 2]} format='webp' loading='lazy' decoding='async' quality='high' /> : brand.name}
				</a>
				<p class='ft-addr'>{footer.address}</p>
				{footer.hours && <p class='ft-addr'>{footer.hours}</p>}
			</div>
			{
				footer.columns.length > 0 && (
					<div class='ft-info' style={`--cols:${footer.columns.length}`}>
						{footer.columns.map((c) => (
							<div>
								<h3>{c.h}</h3>
								<p set:html={md(c.p)} />
							</div>
						))}
					</div>
				)
			}
		</div>
		<div class='ft-legal'>
			{legalLine && <span>{legalLine}</span>}
			<span class='ft-r'>
				{copyright}
				{
					legal.privacyUrl && (
						<>
							{' · '}
							<a href={legal.privacyUrl}>{privacyLabel}</a>
						</>
					)
				}
			</span>
		</div>
	</div>
	<p class='ft-word display' aria-hidden='true'>{brand.name}</p>
</footer>

<style>
	.ft {
		padding-top: clamp(64px, 8vw, 110px);
		border-top: 1px solid var(--line);
		overflow: hidden;
	}
	.ft-top {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
		gap: 48px;
	}
	.ft-mark {
		font-family: var(--display);
		font-size: 30px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1;
	}
	.ft-logo {
		height: 28px;
		width: auto;
	}
	.ft-addr {
		margin-top: 14px;
		font-size: 15px;
		color: var(--ink-2);
		max-width: 34ch;
	}
	.ft-addr + .ft-addr {
		margin-top: 4px;
	}
	.ft-info {
		display: grid;
		grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
		gap: 28px;
	}
	.ft-info h3 {
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin-bottom: 12px;
	}
	.ft-info p {
		font-size: 15px;
		color: var(--ink-2);
		line-height: 1.6;
	}
	.ft-legal {
		margin-top: 56px;
		padding-top: 20px;
		border-top: 1px solid var(--line-soft);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px 24px;
		font-family: var(--mono);
		font-size: 11px;
		line-height: 1.6;
		color: var(--ink-3);
	}
	.ft-legal a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.ft-legal a:hover {
		color: var(--ink);
	}
	.ft-word {
		margin: 24px 0 -0.14em;
		padding-inline: var(--pad-x);
		font-size: clamp(88px, 17.5vw, 270px);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.03em;
		white-space: nowrap;
		color: var(--ink);
		user-select: none;
	}
	@media (max-width: 900px) {
		.ft-top {
			grid-template-columns: minmax(0, 1fr);
			gap: 36px;
		}
		.ft-info {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
	@media (max-width: 520px) {
		.ft-info {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
