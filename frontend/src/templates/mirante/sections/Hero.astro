---
/**
 * Hero: the photo fills the screen. Title (serif, italic accent) and rich sub
 * bottom-left, the mini lead form (core LeadForm: nome + telefone) in a dark
 * translucent panel bottom-right, and a filmstrip of the gallery photos that
 * swaps the backdrop. The first photo is the LCP (eager, high priority); the
 * rest load lazily. The strip advances on a CSS-animation timer, paused while
 * the pointer or focus is inside, when the tab is hidden, and never under
 * reduced motion.
 */
import { Image } from 'astro:assets';
import LeadForm from '../../core/LeadForm.astro';
import type { LeadField } from '../../core/schema';
import type { MiranteConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: MiranteConfig;
}
const { config } = Astro.props;
const { hero, contact, brand } = config;
const { miniForm } = hero;

const fields: LeadField[] = [
	{ name: 'nome', label: miniForm.labels.nome, type: 'text', required: true, autocomplete: 'name' },
	{ name: 'telefone', label: miniForm.labels.telefone, type: 'tel', required: true, placeholder: '(11) 99999-9999' },
];

const whatsapp = contact.whatsapp ? `https://wa.me/${contact.whatsapp.number}?text=${encodeURIComponent(contact.whatsapp.message)}` : null;

/** srcset widths, capped at the source width (never upscale). */
const widths = (w: number) => [...[640, 768, 960, 1280, 1920, 2400].filter((x) => x < w), w];
const en = brand.locale === 'en';
const stripLabel = en ? 'Photos' : 'Fotos';
const showLabel = en ? 'Show' : 'Mostrar';
---

<section class='hero' data-hero aria-labelledby='hero-title'>
	<div class='hero-media' aria-hidden='true' data-hero-media>
		{
			hero.gallery.map((g, i) => {
				const shot = (
					<figure class:list={['hero-bg', { 'is-on': i === 0 }]} data-hero-bg={i}>
						<Image
							src={g.image}
							alt=''
							widths={widths(g.image.width)}
							sizes='100vw'
							format='webp'
							quality={62}
							loading={i === 0 ? 'eager' : 'lazy'}
							fetchpriority={i === 0 ? 'high' : undefined}
							decoding='async'
						/>
					</figure>
				);
				// Slides 2… sit inside the viewport, so `lazy` alone would still fetch them
				// alongside the LCP photo; they are mounted once the page has loaded.
				return i === 0 ? shot : <template data-hero-deferred>{shot}</template>;
			})
		}
		<div class='hero-shade'></div>
	</div>

	<div class='hero-inner wrap'>
		<div class='hero-copy'>
			<p class='eyebrow'>
				<span class='live-dot' aria-hidden='true'></span>
				{hero.eyebrow}
			</p>
			<h1 id='hero-title' class='display'>
				{hero.title} <em class='hl'>{hero.titleAccent}</em>
			</h1>
			<p class='sub' set:html={md(hero.sub)} />
		</div>

		<div class='hero-film' role='group' aria-label={stripLabel} data-hero-film>
			{
				hero.gallery.map((g, i) => (
					<button type='button' class:list={['film', { 'is-on': i === 0 }]} data-hero-go={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${showLabel}: ${g.label}`}>
						<span class='film-shot'>
							<Image src={g.image} alt='' widths={[240, 480]} sizes='120px' format='webp' quality={70} loading={i === 0 ? 'eager' : 'lazy'} decoding='async' />
						</span>
						<span class='film-l'>{g.label}</span>
						<span class='film-bar' aria-hidden='true'>
							<span class='film-fill' />
						</span>
					</button>
				))
			}
		</div>

		<aside class='hero-form on-dark' aria-label={miniForm.title}>
			<p class='mf-h'>{miniForm.title}</p>
			<LeadForm site={config} id='mirante-hero' variant='mini' fields={fields} cta={miniForm.cta} source='hero' />
			{
				(miniForm.foot || whatsapp) && (
					<p class='mf-foot'>
						{miniForm.foot}
						{whatsapp && (
							<a href={whatsapp} target='_blank' rel='noopener'>
								{miniForm.whatsappLabel}
							</a>
						)}
					</p>
				)
			}
		</aside>
	</div>
</section>

<script>
	const mountDeferred = (hero: HTMLElement) => {
		hero.querySelectorAll<HTMLTemplateElement>('[data-hero-deferred]').forEach((t) => t.replaceWith(t.content));
	};
	const afterLoad = (fn: () => void) => {
		if (document.readyState === 'complete') fn();
		else window.addEventListener('load', fn, { once: true });
	};

	document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
		afterLoad(() => setup(hero));
	});

	function setup(hero: HTMLElement) {
		mountDeferred(hero);
		const bgs = [...hero.querySelectorAll<HTMLElement>('[data-hero-bg]')];
		const btns = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-go]')];
		if (bgs.length < 2 || btns.length !== bgs.length) return;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;

		const holds = new Set<string>();
		const syncHold = () => hero.toggleAttribute('data-paused', holds.size > 0);
		const hold = (why: string, on: boolean) => {
			if (on) holds.add(why);
			else holds.delete(why);
			syncHold();
		};

		const show = (i: number) => {
			if (i !== current) hero.setAttribute('data-live', '');
			current = (i + bgs.length) % bgs.length;
			bgs.forEach((bg, k) => bg.classList.toggle('is-on', k === current));
			btns.forEach((b, k) => {
				const on = k === current;
				b.classList.toggle('is-on', on);
				b.setAttribute('aria-pressed', String(on));
				const fill = b.querySelector<HTMLElement>('.film-fill');
				if (!fill) return;
				// Restart the timer bar on the active thumb (double rAF so the removal paints first).
				fill.classList.remove('is-running');
				if (on && !reduced.matches) {
					requestAnimationFrame(() => requestAnimationFrame(() => fill.classList.add('is-running')));
				}
			});
		};

		btns.forEach((b, i) => {
			b.addEventListener('click', () => show(i));
		});
		hero.addEventListener('animationend', (e) => {
			if ((e.target as HTMLElement).classList.contains('film-fill')) show(current + 1);
		});

		// Holds: pointer or keyboard focus inside the strip or the form, hidden tab, offscreen.
		const film = hero.querySelector<HTMLElement>('[data-hero-film]');
		film?.addEventListener('pointerenter', () => hold('hover', true));
		film?.addEventListener('pointerleave', () => hold('hover', false));
		hero.addEventListener('focusin', (e) => {
			if ((e.target as Element).matches(':focus-visible') || (e.target as Element).closest('form')) hold('focus', true);
		});
		hero.addEventListener('focusout', () => {
			requestAnimationFrame(() => {
				if (!hero.contains(document.activeElement)) hold('focus', false);
			});
		});
		document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
		new IntersectionObserver(([entry]) => hold('offscreen', !entry?.isIntersecting), { threshold: 0.15 }).observe(hero);

		show(0);
	}
</script>

<style>
	.hero {
		position: relative;
		color: #fff;
		isolation: isolate;
		overflow: hidden;
	}
	.hero-media {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--ink);
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		transform: scale(1.06);
		transition:
			opacity 1.1s var(--ease),
			transform 0s linear 1.1s;
	}
	.hero-bg.is-on {
		opacity: 1;
		transform: scale(1);
		transition:
			opacity 1.1s var(--ease),
			transform 0s;
	}
	/* Slow zoom only after the first swap, so the first paint stays a still (no per-frame work while loading) */
	[data-live] .hero-bg.is-on {
		transition:
			opacity 1.1s var(--ease),
			transform 8s linear;
	}
	.hero-bg :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* Three shades so white copy reads on any photo: top (topbar), left (title and sub), bottom (strip and form) */
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, color-mix(in srgb, #000 42%, transparent) 0%, transparent 32%),
			linear-gradient(90deg, color-mix(in srgb, #000 62%, transparent) 0%, color-mix(in srgb, #000 40%, transparent) 38%, transparent 68%),
			linear-gradient(180deg, transparent 30%, color-mix(in srgb, #000 30%, transparent) 58%, color-mix(in srgb, #000 82%, transparent) 100%);
	}

	.hero-inner {
		min-height: 100svh;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 400px);
		grid-template-rows: 1fr auto auto;
		grid-template-areas:
			'. .'
			'copy form'
			'film form';
		column-gap: 48px;
		row-gap: 36px;
		padding-top: calc(var(--tb-h) + 32px);
		padding-bottom: 32px;
		align-items: end;
	}
	.hero-copy {
		grid-area: copy;
		max-width: 720px;
	}
	.hero-copy .eyebrow {
		color: color-mix(in srgb, #fff 92%, transparent);
	}
	/* The pulse animates only transform and opacity on a ring (a box-shadow animation repainted the hero every frame). */
	.live-dot {
		position: relative;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-on-dark);
	}
	.live-dot::after {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: 50%;
		border: 1px solid var(--accent-on-dark);
		animation: mirante-pulse 2.4s ease-out infinite;
	}
	@keyframes mirante-pulse {
		0% {
			transform: scale(0.8);
			opacity: 0.9;
		}
		100% {
			transform: scale(2.6);
			opacity: 0;
		}
	}
	.hero h1 {
		margin-top: 22px;
		font-size: clamp(56px, 8.4vw, 132px);
		line-height: 0.94;
		max-width: 12ch;
	}
	.hero .sub {
		margin-top: 24px;
		font-size: 18px;
		line-height: 1.55;
		max-width: 46ch;
		color: #fff;
	}
	.hero .sub :global(strong) {
		color: #fff;
		font-weight: 600;
	}

	/* Filmstrip */
	.hero-film {
		grid-area: film;
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}
	.film {
		display: grid;
		gap: 8px;
		width: 120px;
		padding: 0;
		text-align: left;
		color: #fff;
		opacity: 0.62;
		transition: opacity 0.3s;
	}
	.film:hover,
	.film.is-on {
		opacity: 1;
	}
	.film:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
	}
	.film-shot {
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background: color-mix(in srgb, #fff 12%, transparent);
	}
	.film-shot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease);
	}
	.film:hover .film-shot :global(img) {
		transform: scale(1.05);
	}
	.film-l {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.film-bar {
		display: block;
		height: 1px;
		background: color-mix(in srgb, #fff 30%, transparent);
		overflow: hidden;
	}
	.film-fill {
		display: block;
		height: 100%;
		width: 100%;
		background: #fff;
		transform: scaleX(0);
		transform-origin: left;
	}
	.film-fill.is-running {
		animation: mirante-film 7s linear forwards;
	}
	[data-paused] .film-fill.is-running {
		animation-play-state: paused;
	}
	@keyframes mirante-film {
		to {
			transform: scaleX(1);
		}
	}

	/* Mini form panel */
	.hero-form {
		grid-area: form;
		padding: 28px 28px 24px;
		background: color-mix(in srgb, var(--ink) 86%, transparent);
		border: 1px solid color-mix(in srgb, #fff 14%, transparent);
	}
	.mf-h {
		font-family: var(--display);
		font-size: 30px;
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.01em;
		margin-bottom: 18px;
	}
	/* Doubled class: beats the core mini layout (two columns) at every width */
	.hero-form :global(.lead-form.lead-form .lf-body) {
		grid-template-columns: minmax(0, 1fr);
		gap: 18px;
	}
	.hero-form :global(.lead-form.lead-form .lf-submit) {
		grid-column: 1 / -1;
		margin-top: 6px;
	}
	.hero-form :global(.lead-form.lead-form .lf-status) {
		text-align: left;
	}

	@media (max-width: 1100px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
			column-gap: 32px;
		}
	}
	@media (max-width: 900px) {
		.hero-inner {
			min-height: 0;
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'copy'
				'film'
				'form';
			grid-template-rows: auto;
			row-gap: 32px;
			padding-top: 88px;
			padding-bottom: 28px;
		}
		.hero h1 {
			font-size: clamp(52px, 13vw, 84px);
		}
		.hero-media {
			/* Keep the photo behind the copy only; the form sits on solid ink below */
			background: var(--ink);
		}
		.hero-film {
			gap: 10px;
		}
		.film {
			width: calc((100% - 30px) / 4);
			min-width: 64px;
		}
		.film-l {
			font-size: 10px;
		}
		.hero-shade {
			background:
				linear-gradient(180deg, color-mix(in srgb, #000 40%, transparent) 0%, color-mix(in srgb, #000 22%, transparent) 30%, color-mix(in srgb, #000 30%, transparent) 55%, color-mix(in srgb, #000 78%, transparent) 100%);
		}
		.hero-form {
			padding: 24px 22px 20px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-bg,
		.hero-bg.is-on {
			transform: none;
			transition: opacity 0.2s;
		}
		.film-fill.is-running {
			animation: none;
		}
	}
</style>
