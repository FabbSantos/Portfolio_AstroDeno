---
/**
 * Full standalone Mirante page for a client site: core Page (head, theme
 * tokens, WhatsApp FAB, LGPD bar) wrapping MiranteBody. The core Inter preload
 * is off (the template sets its own faces); Cormorant is preloaded instead.
 */
import Page from '../core/Page.astro';
import MiranteBody from './MiranteBody.astro';
import { MIRANTE_PRELOAD } from './fonts';
import type { MiranteConfig } from './schema';

interface Props {
	config: MiranteConfig;
	noindex?: boolean;
}
const { config, noindex = false } = Astro.props;
---

<Page site={config} class='page-mirante' noindex={noindex} preloadFonts={false} preload={MIRANTE_PRELOAD}>
	<main id='main-content'>
		<MiranteBody config={config} />
	</main>
</Page>
