---
/**
 * Menu (#cardapio), after 21st.dev "Restaurant Menu Block" (7ovr/menu-1) made
 * louder: a giant section title, a row of jump links to each category, then
 * categories in two columns. Each dish is a row with a dotted leader to its
 * price, the description and small marks (vegano, sem glúten) underneath.
 */
import type { PimentaConfig } from '../schema';
import { formatPrice } from '../menu';

interface Props {
	config: PimentaConfig;
}
const { config } = Astro.props;
const { menu, brand } = config;
const locale = brand.locale;
const slug = (s: string) =>
	s
		.normalize('NFD')
		.replace(/\p{Diacritic}/gu, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
const categories = menu.categories.map((c, i) => ({ ...c, id: `cardapio-${slug(c.name) || i + 1}` }));
const onRequest = locale === 'en' ? 'ask' : 'consulte';
---

<section class='sec menu' id='cardapio' aria-labelledby='pimenta-menu-title'>
	<div class='wrap'>
		<header class='sec-head'>
			<h2 id='pimenta-menu-title' class='display'>{menu.title}</h2>
			{menu.lead && <p class='lead'>{menu.lead}</p>}
		</header>

		{
			categories.length > 1 && (
				<nav class='jump' aria-label={menu.title}>
					{categories.map((c) => (
						<a href={`#${c.id}`}>
							{c.name}
							<span class='count' aria-hidden='true'>
								{c.items.length}
							</span>
						</a>
					))}
				</nav>
			)
		}

		<div class='cats'>
			{
				categories.map((c) => (
					<section class='cat' id={c.id} aria-labelledby={`${c.id}-title`}>
						<h3 id={`${c.id}-title`} class='display'>
							{c.name}
						</h3>
						<ul class='items' role='list'>
							{c.items.map((item) => (
								<li class='item'>
									<p class='row'>
										<span class='name'>{item.name}</span>
										<span class='dots' aria-hidden='true' />
										<span class='price'>{item.price > 0 ? formatPrice(item.price, locale) : onRequest}</span>
									</p>
									{(item.desc || item.tags.length > 0) && (
										<p class='desc'>
											{item.desc}
											{item.tags.map((tag) => (
												<span class='tag'>{tag}</span>
											))}
										</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>

		{
			(menu.note || menu.full) && (
				<div class='after'>
					{menu.note && <p class='note'>{menu.note}</p>}
					{menu.full && (
						<a class='btn' href={menu.full.href} target='_blank' rel='noopener'>
							{menu.full.label} <span class='arr' aria-hidden='true'>↗</span>
						</a>
					)}
				</div>
			)
		}
	</div>
</section>

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		padding-block: 18px;
		border-block: 2px solid var(--ink);
		margin-bottom: clamp(48px, 6vw, 80px);
	}
	.jump a {
		display: inline-flex;
		gap: 6px;
		min-height: 44px;
		align-items: center;
		font-family: var(--display);
		font-size: 26px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.jump a:hover {
		text-decoration: underline;
		text-decoration-thickness: 3px;
		text-decoration-color: var(--accent);
		text-underline-offset: 6px;
	}
	.count {
		font-family: var(--text);
		font-size: 13px;
		font-weight: 600;
		color: var(--ink-2);
	}

	.cats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(56px, 6vw, 88px) clamp(40px, 6vw, 96px);
	}
	.cat {
		scroll-margin-top: 96px;
	}
	.cat h3 {
		position: relative;
		font-size: clamp(44px, 5vw, 72px);
		padding-bottom: 18px;
		margin-bottom: 8px;
	}
	/* short flat bar under each category name */
	.cat h3::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 56px;
		height: 8px;
		background: var(--accent);
	}
	.items {
		list-style: none;
	}
	.item {
		padding-block: 18px;
		border-bottom: 1px solid var(--line);
	}
	.row {
		display: flex;
		align-items: baseline;
		gap: 10px;
		font-size: 18px;
		font-weight: 600;
		line-height: 1.3;
	}
	.name {
		min-width: 0;
	}
	.dots {
		flex: 1;
		min-width: 24px;
		border-bottom: 2px dotted color-mix(in srgb, var(--ink) 35%, transparent);
		transform: translateY(-4px);
	}
	.price {
		flex: none;
		font-variant-numeric: tabular-nums;
	}
	.desc {
		margin-top: 6px;
		font-size: 15px;
		line-height: 1.5;
		color: var(--ink-2);
	}
	.tag {
		display: inline-block;
		margin-left: 10px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}
	.tag::before {
		content: '';
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-right: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 1px var(--ink);
		vertical-align: 1px;
	}

	.after {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 20px 40px;
		margin-top: clamp(48px, 6vw, 72px);
	}
	.note {
		max-width: 60ch;
		font-size: 15px;
		color: var(--ink-2);
	}

	@media (max-width: 900px) {
		.cats {
			grid-template-columns: minmax(0, 1fr);
		}
		.jump a {
			font-size: 22px;
		}
	}
</style>
