---
/**
 * Analytics snippets, each only when its id is set. Renders nothing otherwise.
 * GA4 + Meta Pixel set cookies (LgpdNotice must be shown); Plausible does not.
 */
import type { BaseSite } from './schema';

interface Props {
	analytics: BaseSite['analytics'];
}
const { analytics } = Astro.props;
const { ga4, metaPixel, plausibleDomain } = analytics;
---

{
	ga4 && (
		<Fragment>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4)}`} />
			<script is:inline define:vars={{ ga4 }}>
				/* eslint-disable prefer-rest-params -- gtag.js requires the real Arguments object */
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					window.dataLayer.push(arguments);
				}
				gtag('js', new Date());
				gtag('config', ga4);
			</script>
		</Fragment>
	)
}

{
	metaPixel && (
		<Fragment>
			<script is:inline define:vars={{ metaPixel }}>
				/* eslint-disable prefer-rest-params, prefer-spread, @typescript-eslint/no-unused-expressions -- Meta's verbatim loader */
				!(function (f, b, e, v, n, t, s) {
					if (f.fbq) return;
					n = f.fbq = function () {
						n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
					};
					if (!f._fbq) f._fbq = n;
					n.push = n;
					n.loaded = !0;
					n.version = '2.0';
					n.queue = [];
					t = b.createElement(e);
					t.async = !0;
					t.src = v;
					s = b.getElementsByTagName(e)[0];
					s.parentNode.insertBefore(t, s);
				})(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
				fbq('init', metaPixel);
				fbq('track', 'PageView');
			</script>
			<noscript>
				<img
					height='1'
					width='1'
					style='display:none'
					src={`https://www.facebook.com/tr?id=${encodeURIComponent(metaPixel)}&ev=PageView&noscript=1`}
					alt=''
				/>
			</noscript>
		</Fragment>
	)
}

{plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src='https://plausible.io/js/script.js' />}
