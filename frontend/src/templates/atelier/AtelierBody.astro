---
/**
 * Atelier — everything between <main> and </main>. Used by the portfolio demo
 * (DemoLayout + ThemeVars + this) and by AtelierPage (core Page + this).
 */
// Weight-axis build only (37 KB): the optical-size build is twice that. Upright only: nothing in Atelier is italic.
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/figtree';
import './styles.css';
import type { AtelierConfig } from './schema';
import Topbar from './sections/Topbar.astro';
import Hero from './sections/Hero.astro';
import Work from './sections/Work.astro';
import Studio from './sections/Studio.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';

interface Props {
	config: AtelierConfig;
}
const { config } = Astro.props;
---

<div class='tpl tpl-atelier'>
	<Topbar config={config} />
	<Hero config={config} />
	<Work config={config} />
	<Studio config={config} />
	<Contact config={config} />
	<Footer config={config} />
</div>
