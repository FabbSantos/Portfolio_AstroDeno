---
/** The studio, on a block of the deep colour: copy on the left, the numbers in a hairline grid on the right. */
import type { AtelierConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: AtelierConfig;
}
const { studio } = Astro.props.config;
---

<section class='studio sec' id='studio' aria-labelledby='studio-title'>
	<div class='wrap studio-grid'>
		<div class='studio-copy'>
			<p class='eyebrow'>{studio.eyebrow}</p>
			<h2 id='studio-title' class='display' set:html={md(studio.title)} />
			<div class='studio-text'>{studio.paragraphs.map((p) => <p>{p}</p>)}</div>
			{
				studio.link && (
					<a href={studio.link.href} class='link'>
						{studio.link.label}
					</a>
				)
			}
		</div>
		{
			studio.stats.length > 0 && (
				<dl class='studio-stats'>
					{studio.stats.map((s) => (
						<div>
							<dd class='display'>{s.v}</dd>
							<dt>{s.l}</dt>
						</div>
					))}
				</dl>
			)
		}
	</div>
</section>

<style>
	.studio {
		background: var(--accent-text);
		color: #fff;
	}
	.studio .eyebrow {
		color: color-mix(in srgb, #fff 72%, transparent);
	}
	.studio .eyebrow::before {
		background: color-mix(in srgb, #fff 72%, transparent);
	}
	.studio-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: clamp(40px, 6vw, 96px);
		align-items: start;
	}
	.studio-copy {
		display: grid;
		gap: 24px;
		justify-items: start;
	}
	.studio h2 {
		font-size: clamp(48px, 6vw, 96px);
		max-width: 12ch;
	}
	.studio-text {
		display: grid;
		gap: 16px;
		max-width: 52ch;
	}
	.studio-text p {
		font-size: 17px;
		line-height: 1.65;
		color: color-mix(in srgb, #fff 88%, transparent);
	}
	.studio .link {
		color: #fff;
		text-decoration-color: color-mix(in srgb, #fff 50%, transparent);
	}
	.studio .link:hover {
		text-decoration-color: #fff;
	}
	.studio-stats {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		border-top: 1px solid var(--line-on-dark);
		border-left: 1px solid var(--line-on-dark);
		margin-top: 0.4em;
	}
	.studio-stats div {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 28px 24px 26px;
		border-right: 1px solid var(--line-on-dark);
		border-bottom: 1px solid var(--line-on-dark);
	}
	.studio-stats dd {
		font-size: clamp(48px, 5vw, 80px);
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.studio-stats dt {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 72%, transparent);
	}
	@media (max-width: 900px) {
		.studio-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 480px) {
		.studio-stats {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
