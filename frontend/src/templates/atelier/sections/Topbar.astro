---
/**
 * Sticky topbar = core MobileNav restyled for Atelier (serif brand with the
 * mark, links, underlined CTA). The mark is injected via a CSS string
 * variable so the brand stays a single accessible link. Styles live in
 * ../styles.css (.tpl-atelier .mnav …).
 */
import MobileNav from '../../core/MobileNav.astro';
import type { AtelierConfig } from '../schema';

interface Props {
	config: AtelierConfig;
}
const { topbar, brand, nav } = Astro.props.config;
---

<div class='tb' style={`--mark: '${topbar.mark}'`}>
	<MobileNav brand={brand.name} brandHref={topbar.brandHref} nav={nav} cta={topbar.cta} id='atelier-nav' />
</div>

<style>
	.tb {
		position: sticky;
		top: 0;
		z-index: 40;
	}
</style>
