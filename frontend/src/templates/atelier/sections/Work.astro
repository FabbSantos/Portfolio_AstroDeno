---
/**
 * Case grid. Each card is an <article>; when `href` is set the client name is
 * a stretched link covering the whole card. Photo when `image`, otherwise a
 * tinted gradient placeholder (`tint`, defaults to the accent).
 */
import { Image } from 'astro:assets';
import type { AtelierConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: AtelierConfig;
}
const { work } = Astro.props.config;
---

<section class='work' id='work' aria-labelledby='work-title'>
	<div class='sec-h'>
		<span class='eyebrow'>{work.eyebrow}</span>
		<h2 id='work-title' set:html={md(work.title)} />
	</div>
	<div class='case-grid'>
		{
			work.cases.map((c) => (
				<article class='case' style={c.tint ? `--tint: ${c.tint}` : undefined}>
					{c.image ? (
						<Image
							class='case-thumb'
							src={c.image}
							alt={c.alt ?? c.client}
							widths={[480, 720, 960, 1200]}
							sizes='(max-width: 780px) calc(100vw - 64px), 572px'
							format='webp'
							loading='lazy'
							decoding='async'
							quality='high'
						/>
					) : (
						<div class='case-thumb case-thumb--tint' aria-hidden='true' />
					)}
					<div class='case-meta'>
						<span class='c-n'>{c.n}</span>
						<div class='c-info'>
							<h3>
								{c.href ? (
									<a class='c-link' href={c.href}>
										{c.client}
									</a>
								) : (
									c.client
								)}
							</h3>
							<p>
								<span>{c.tag}</span>
								<span class='sep'>·</span>
								<span>{c.year}</span>
							</p>
						</div>
						<span class='c-arr' aria-hidden='true'>
							↗
						</span>
					</div>
				</article>
			))
		}
	</div>
	{
		work.archive && (
			<div class='work-foot'>
				<a href={work.archive.href} class='link'>
					{work.archive.label}
				</a>
			</div>
		)
	}
</section>

<style>
	.work {
		max-width: 1240px;
		margin: 0 auto;
		padding: 100px 32px;
	}
	.case-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px 32px;
	}
	.case {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 20px;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.case:hover {
		transform: translateY(-6px);
	}
	/* Stretched link: the whole card is clickable, the link name is the client. */
	.c-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.case:has(.c-link:focus-visible) {
		outline: 2px solid var(--accent-2);
		outline-offset: 6px;
		border-radius: 16px;
	}
	.c-link:focus-visible {
		outline: none;
	}
	.case-thumb {
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		border-radius: 16px;
		position: relative;
		overflow: hidden;
	}
	.case-thumb--tint {
		--tint-base: var(--tint, color-mix(in srgb, var(--accent) 26%, var(--bg-3)));
		background: linear-gradient(135deg, color-mix(in srgb, var(--tint-base) 55%, var(--bg-3)), var(--tint-base));
	}
	.case-thumb--tint::before {
		content: '';
		position: absolute;
		inset: 30% 25% auto auto;
		width: 50px;
		height: 50px;
		border-radius: 50%;
		background: var(--accent);
		opacity: 0.4;
		filter: blur(8px);
	}
	.case-thumb--tint::after {
		content: '';
		position: absolute;
		inset: auto 20% 25% 20%;
		height: 40%;
		background: linear-gradient(180deg, transparent, var(--rule));
		border-radius: 8px;
	}
	.case-meta {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 16px;
		align-items: center;
	}
	.c-n {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
	}
	.c-info h3 {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.015em;
	}
	.c-info p {
		font-size: 13px;
		color: var(--ink-3);
		margin-top: 4px;
	}
	.c-info .sep {
		margin: 0 8px;
		opacity: 0.4;
	}
	.c-arr {
		font-size: 22px;
		color: var(--ink-3);
		transition:
			color 0.25s,
			transform 0.25s;
	}
	.case:hover .c-arr {
		color: var(--accent-text);
		transform: translate(4px, -4px);
	}
	.work-foot {
		margin-top: 48px;
		text-align: center;
	}
	@media (max-width: 780px) {
		.case-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
