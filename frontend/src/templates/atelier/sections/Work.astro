---
/**
 * Selected work as a magazine grid: rows of two tiles with alternating spans
 * (wide + narrow, then narrow + wide), the caption on a paper chip over the
 * photo and an arrow when the case links out. Photo when `image`, otherwise a
 * tinted placeholder (`tint`, defaults to the second colour).
 */
import { Image } from 'astro:assets';
import type { AtelierConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: AtelierConfig;
}
const { work } = Astro.props.config;
const widths = (w: number) => [...[640, 960, 1280].filter((x) => x < w), w];
/** Column span pattern per row: 7/5, 5/7, 7/5 … */
const wide = (i: number) => (Math.floor(i / 2) % 2 === 0 ? i % 2 === 0 : i % 2 === 1);
---

<section class='work sec' id='work' aria-labelledby='work-title'>
	<div class='wrap'>
		<div class='sec-head'>
			<p class='eyebrow'>{work.eyebrow}</p>
			<h2 id='work-title' class='display' set:html={md(work.title)} />
		</div>
		<ul class='cases'>
			{
				work.cases.map((c, i) => (
					<li class:list={['case', wide(i) ? 'is-wide' : 'is-narrow']} style={c.tint ? `--tint:${c.tint}` : undefined}>
						<article class='case-in'>
							<div class='case-media'>
								{c.image ? (
									<Image src={c.image} alt={c.alt ?? c.client} widths={widths(c.image.width)} sizes={wide(i) ? '(max-width: 780px) calc(100vw - 40px), 58vw' : '(max-width: 780px) calc(100vw - 40px), 42vw'} format='webp' quality={76} loading='lazy' decoding='async' />
								) : (
									<div class='case-tint' aria-hidden='true' />
								)}
							</div>
							<div class='case-cap'>
								<span class='c-n'>{c.n}</span>
								<h3 class='c-client'>
									{c.href ? (
										<a class='c-link' href={c.href}>
											{c.client}
										</a>
									) : (
										c.client
									)}
								</h3>
								<span class='c-meta'>
									{c.tag} · {c.year}
								</span>
							</div>
							{c.href && (
								<span class='case-arr' aria-hidden='true'>
									↗
								</span>
							)}
						</article>
					</li>
				))
			}
		</ul>
		{
			work.archive && (
				<div class='work-foot'>
					<a href={work.archive.href} class='link'>
						{work.archive.label}
					</a>
				</div>
			)
		}
	</div>
</section>

<style>
	.cases {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(12px, 1.6vw, 22px);
	}
	.case.is-wide {
		grid-column: span 7;
	}
	.case.is-narrow {
		grid-column: span 5;
	}
	.case-in {
		position: relative;
		height: 100%;
		min-height: clamp(260px, 32vw, 480px);
		overflow: hidden;
		background: var(--bg-2);
	}
	.case-media {
		position: absolute;
		inset: 0;
	}
	.case-media :global(img),
	.case-tint {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.9s var(--ease);
	}
	.case-tint {
		background: linear-gradient(135deg, var(--tint, var(--accent-2)), color-mix(in srgb, var(--tint, var(--accent-2)) 60%, var(--bg)));
	}
	.case-in:hover .case-media :global(img) {
		transform: scale(1.03);
	}
	/* Caption chip on paper */
	.case-cap {
		position: absolute;
		left: 14px;
		bottom: 14px;
		max-width: calc(100% - 28px);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 12px;
		align-items: baseline;
		padding: 12px 16px 12px 14px;
		background: var(--bg);
		color: var(--ink);
	}
	.c-n {
		font-family: var(--display);
		font-size: 15px;
		font-weight: 500;
		color: var(--accent-text);
	}
	.c-client {
		font-family: var(--display);
		font-size: 22px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}
	.c-meta {
		grid-column: 2;
		margin-top: 4px;
		font-size: 13px;
		color: var(--ink-3);
	}
	/* Stretched link: the whole tile is clickable */
	.c-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.c-link:focus-visible {
		outline: none;
	}
	.case-in:has(.c-link:focus-visible) {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}
	.case-arr {
		position: absolute;
		right: 14px;
		bottom: 14px;
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--display);
		font-size: 22px;
		transition:
			background 0.25s,
			color 0.25s,
			transform 0.4s var(--ease);
	}
	.case-in:hover .case-arr {
		background: var(--accent-text);
		color: #fff;
		transform: translate(2px, -2px);
	}
	.work-foot {
		margin-top: 36px;
	}
	@media (max-width: 780px) {
		.cases {
			grid-template-columns: minmax(0, 1fr);
		}
		.case.is-wide,
		.case.is-narrow {
			grid-column: auto;
		}
		.case-in {
			min-height: 0;
			aspect-ratio: 4 / 3;
		}
		.c-client {
			font-size: 19px;
		}
	}
</style>
