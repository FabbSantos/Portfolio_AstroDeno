---
/** Process: the steps side by side on one hairline, each with its number in serif; only typography. */
import type { AtelierConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: AtelierConfig;
}
const { process } = Astro.props.config;
---

<section class='process sec' id='process' aria-labelledby='process-title'>
	<div class='wrap'>
		<div class='sec-head'>
			<p class='eyebrow'>{process.eyebrow}</p>
			<h2 id='process-title' class='display' set:html={md(process.title)} />
			{process.lead && <p class='sec-l'>{process.lead}</p>}
		</div>
		<ol class='steps' style={`--n:${process.steps.length}`}>
			{
				process.steps.map((s) => (
					<li class='step'>
						<span class='s-n display' aria-hidden='true'>
							{s.n}
						</span>
						<h3>{s.t}</h3>
						<p>{s.d}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
		border-top: 1px solid var(--line);
	}
	.step {
		position: relative;
		padding: 28px 28px 8px 0;
	}
	.step + .step {
		padding-left: 28px;
		border-left: 1px solid var(--line-soft);
	}
	/* A dot where the step meets the rule */
	.step::before {
		content: '';
		position: absolute;
		top: -4px;
		left: 0;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-text);
	}
	.step + .step::before {
		left: 28px;
	}
	.s-n {
		display: block;
		font-size: clamp(48px, 5vw, 72px);
		line-height: 1;
		color: var(--ink);
	}
	.step h3 {
		margin-top: 22px;
		font-family: var(--display);
		font-size: 26px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}
	.step p {
		margin-top: 12px;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-2);
		max-width: 30ch;
	}
	@media (max-width: 900px) {
		.steps {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			row-gap: 32px;
		}
		.step:nth-child(2n + 1) {
			padding-left: 0;
			border-left: 0;
		}
		.step:nth-child(2n + 1)::before {
			left: 0;
		}
		.step:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}
	}
	@media (max-width: 540px) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}
		.step,
		.step + .step {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--line);
		}
		.step:first-child {
			border-top: 0;
		}
		.step + .step::before {
			left: 0;
		}
	}
</style>
