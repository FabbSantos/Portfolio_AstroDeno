---
/** Footer: the line and legal notes on a hairline, then the studio name set giant across the bottom. */
import type { AtelierConfig } from '../schema';

interface Props {
	config: AtelierConfig;
}
const { brand, topbar, footer, legal } = Astro.props.config;
const privacyLabel = brand.locale === 'en' ? 'Privacy' : 'Privacidade';
---

<footer class='ft'>
	<div class='wrap ft-top'>
		<a href={topbar.brandHref} class='ft-brand'>
			{brand.name}
			{topbar.mark && <span class='ft-mark' aria-hidden='true'>{topbar.mark}</span>}
		</a>
		<div class='ft-lines'>
			<p>{footer.line}</p>
			{legal.lines.map((l) => <p>{l}</p>)}
			{
				legal.privacyUrl && (
					<p>
						<a href={legal.privacyUrl}>{privacyLabel}</a>
					</p>
				)
			}
		</div>
	</div>
	<p class='ft-word display' aria-hidden='true'>{brand.name}</p>
</footer>

<style>
	.ft {
		border-top: 1px solid var(--line);
		padding-top: 40px;
		overflow: hidden;
	}
	.ft-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 24px;
		flex-wrap: wrap;
	}
	.ft-brand {
		font-family: var(--display);
		font-size: 26px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.ft-mark {
		margin-left: 8px;
		font-family: var(--text);
		font-size: 11px;
		color: var(--accent-text);
		vertical-align: 0.35em;
	}
	.ft-lines {
		text-align: right;
		font-size: 13px;
		line-height: 1.7;
		color: var(--ink-3);
	}
	.ft-lines a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.ft-lines a:hover {
		color: var(--ink);
	}
	.ft-word {
		margin: 24px 0 -0.16em;
		padding-inline: var(--pad-x);
		font-size: clamp(88px, 18vw, 280px);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.04em;
		white-space: nowrap;
		color: var(--ink);
		user-select: none;
	}
	@media (max-width: 640px) {
		.ft-lines {
			text-align: left;
		}
	}
</style>
