---
/**
 * Editorial hero: the wide photo opens the page (eager, the LCP), then the
 * eyebrow and the meta list on the left and the serif title on the right.
 * Without `hero.image` the section starts with the text.
 */
import { Image } from 'astro:assets';
import type { AtelierConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: AtelierConfig;
}
const { hero } = Astro.props.config;
const widths = (w: number) => [...[768, 1280, 1920, 2400].filter((x) => x < w), w];
---

<section class='hero' id='top' aria-labelledby='hero-title'>
	{
		hero.image && (
			<figure class='hero-photo'>
				<Image src={hero.image} alt={hero.imageAlt ?? ''} widths={widths(hero.image.width)} sizes='100vw' format='webp' quality={72} loading='eager' fetchpriority='high' decoding='async' />
			</figure>
		)
	}
	<div class='wrap hero-grid'>
		<div class='hero-side'>
			<p class='eyebrow'>{hero.eyebrow}</p>
			{
				hero.meta.length > 0 && (
					<dl class='hero-meta'>
						{hero.meta.map((m) => (
							<div>
								<dt>{m.label}</dt>
								<dd>{m.value}</dd>
							</div>
						))}
					</dl>
				)
			}
		</div>
		<h1 id='hero-title' class='display' set:html={md(hero.title)} />
	</div>
</section>

<style>
	.hero-photo {
		margin: 0;
		aspect-ratio: 2.4 / 1;
		max-height: 72svh;
		overflow: hidden;
		background: var(--bg-2);
	}
	.hero-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: start;
		padding-block: clamp(40px, 5vw, 72px) clamp(56px, 7vw, 96px);
	}
	.hero h1 {
		font-size: clamp(48px, 6.6vw, 104px);
		max-width: 14ch;
	}
	.hero-side {
		display: grid;
		gap: 28px;
		padding-top: 0.6em;
	}
	.hero-meta {
		display: grid;
		gap: 14px;
	}
	.hero-meta div {
		padding-top: 12px;
		border-top: 1px solid var(--line);
	}
	.hero-meta dt {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.hero-meta dd {
		margin-top: 4px;
		font-size: 16px;
		color: var(--ink);
	}
	@media (max-width: 900px) {
		.hero-photo {
			aspect-ratio: 4 / 3;
			max-height: 60svh;
		}
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
		.hero h1 {
			order: -1;
			font-size: clamp(44px, 11vw, 72px);
		}
		.hero-side {
			padding-top: 0;
		}
		.hero-meta {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
</style>
