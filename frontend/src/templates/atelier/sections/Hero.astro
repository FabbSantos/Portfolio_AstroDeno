---
/**
 * Editorial hero: the wide photo opens the page (eager, the LCP), then the
 * meta list on the left and the serif title on the right, with the optional
 * plain line under it. Without `hero.image` the section starts with the text.
 */
import { Image } from 'astro:assets';
import type { AtelierConfig } from '../schema';

interface Props {
	config: AtelierConfig;
}
const { hero } = Astro.props.config;
const widths = (w: number) => [...[768, 1280, 1920, 2400].filter((x) => x < w), w];
---

<section class='hero' id='top' aria-labelledby='hero-title'>
	{
		hero.image && (
			<figure class='hero-photo'>
				<Image src={hero.image} alt={hero.imageAlt ?? ''} widths={widths(hero.image.width)} sizes='100vw' format='webp' quality={72} loading='eager' fetchpriority='high' decoding='async' />
			</figure>
		)
	}
	<div class='wrap hero-grid'>
		{
			hero.meta.length > 0 && (
				<dl class='hero-meta'>
					{hero.meta.map((m) => (
						<div>
							<dt>{m.label}</dt>
							<dd>{m.value}</dd>
						</div>
					))}
				</dl>
			)
		}
		<div class='hero-head'>
			<h1 id='hero-title' class='display'>{hero.title}</h1>
			{hero.sub && <p class='hero-sub'>{hero.sub}</p>}
		</div>
	</div>
</section>

<style>
	.hero-photo {
		margin: 0;
		/* Explicit width: with `width: auto`, `max-height` would transfer through the aspect ratio and shrink the photo. */
		width: 100%;
		aspect-ratio: 2.4 / 1;
		max-height: 72svh;
		overflow: hidden;
		background: var(--bg-2);
	}
	.hero-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: start;
		padding-block: clamp(40px, 5vw, 72px) clamp(56px, 7vw, 96px);
	}
	/* The title always takes the wide column, with or without the meta list. */
	.hero-head {
		grid-column: 2;
	}
	.hero h1 {
		font-size: clamp(48px, 6.6vw, 104px);
		max-width: 14ch;
	}
	.hero-sub {
		margin-top: 20px;
		font-size: 18px;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 48ch;
	}
	.hero-meta {
		display: grid;
		gap: 14px;
		padding-top: 0.6em;
	}
	.hero-meta div {
		padding-top: 12px;
		border-top: 1px solid var(--line);
	}
	.hero-meta dt {
		font-size: 13px;
		font-weight: 600;
		color: var(--ink-3);
	}
	.hero-meta dd {
		margin-top: 4px;
		font-size: 16px;
		color: var(--ink);
	}
	@media (max-width: 900px) {
		.hero-photo {
			aspect-ratio: 4 / 3;
			max-height: 60svh;
		}
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
		.hero-head {
			grid-column: auto;
			order: -1;
		}
		.hero h1 {
			font-size: clamp(44px, 11vw, 72px);
		}
		.hero-sub {
			margin-top: 16px;
			font-size: 17px;
		}
		.hero-meta {
			padding-top: 0;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
</style>
