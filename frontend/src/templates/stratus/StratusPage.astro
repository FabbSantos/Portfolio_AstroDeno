---
/**
 * Full standalone Stratus page for a client site: core Page (head, theme
 * tokens, WhatsApp FAB, LGPD bar) wrapping StratusBody.
 */
import Page from '../core/Page.astro';
import StratusBody from './StratusBody.astro';
import { STRATUS_PRELOAD } from './fonts';
import type { StratusConfig } from './schema';

interface Props {
	config: StratusConfig;
	noindex?: boolean;
}
const { config, noindex = false } = Astro.props;
---

<Page site={config} class='page-stratus' noindex={noindex} preloadFonts={false} preload={STRATUS_PRELOAD}>
	<main id='main-content'>
		<StratusBody config={config} />
	</main>
</Page>
