---
/**
 * Desktop topbar (brand · nav · sign-in · CTA) ≥ 900px, a hairline under it;
 * below that the core MobileNav takes over. Only one of the two is displayed.
 */
import { Image } from 'astro:assets';
import MobileNav from '../../core/MobileNav.astro';
import type { StratusConfig } from '../schema';

interface Props {
	config: StratusConfig;
}
const { config } = Astro.props;
const { brand, nav, header } = config;
const mobileNav = header.signIn ? [...nav, header.signIn] : nav;
---

<header class='tb'>
	<div class='tb-inner wrap'>
		<a href={header.brandHref} class='brand'>
			{
				brand.logo ? (
					<Image class='brand-logo' src={brand.logo} alt={brand.name} height={26} densities={[1, 2]} format='webp' loading='eager' quality='high' />
				) : (
					<>
						{brand.name}
						{header.brandDot && <span class='dot'>.</span>}
					</>
				)
			}
		</a>
		<nav class='tb-nav' aria-label='Main'>
			{nav.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
		<div class='tb-actions'>
			{
				header.signIn && (
					<a href={header.signIn.href} class='tb-link'>
						{header.signIn.label}
					</a>
				)
			}
			<a href={header.cta.href} class='btn'>{header.cta.label}</a>
		</div>
	</div>
</header>
<div class='tb-mobile'>
	<MobileNav brand={brand.name} brandHref={header.brandHref} nav={mobileNav} cta={header.cta} id='stratus-nav' />
</div>

<style>
	.tb {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.tb-inner {
		height: var(--tb-h);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}
	.tb-nav {
		display: flex;
		gap: 28px;
		font-size: 14px;
		font-weight: 500;
		color: var(--ink-2);
	}
	.tb-nav a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 1px;
	}
	.tb-actions {
		display: flex;
		gap: 18px;
		align-items: center;
	}
	.tb-actions .btn {
		min-height: 40px;
		padding: 0 16px;
		font-size: 14px;
	}
	.tb-link {
		font-size: 14px;
		font-weight: 500;
		color: var(--ink-2);
	}
	.tb-link:hover {
		color: var(--ink);
	}

	.tb-mobile {
		display: none;
	}
	@media (max-width: 899.98px) {
		.tb {
			display: none;
		}
		.tb-mobile {
			display: block;
		}
	}
</style>
