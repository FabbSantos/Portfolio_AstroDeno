---
/** Footer on paper: brand and tagline, link columns with mono headings, then a mono legal row. */
import { Image } from 'astro:assets';
import type { StratusConfig } from '../schema';

interface Props {
	config: StratusConfig;
}
const { brand, header, legal, footer } = Astro.props.config;
const copyright = footer.copyright ?? `© ${new Date().getFullYear()} ${legal.company ?? brand.name}`;
---

<footer class='ft'>
	<div class='wrap'>
		<div class='ft-inner' style={`--cols:${footer.columns.length}`}>
			<div class='ft-brand'>
				<a href={header.brandHref} class='brand'>
					{
						brand.logo ? (
							<Image class='brand-logo' src={brand.logo} alt={brand.name} height={26} densities={[1, 2]} format='webp' loading='lazy' decoding='async' quality='high' />
						) : (
							<>
								{brand.name}
								{header.brandDot && <span class='dot'>.</span>}
							</>
						)
					}
				</a>
				{brand.tagline && <p>{brand.tagline}</p>}
			</div>
			{
				footer.columns.map((col) => (
					<nav class='ft-col' aria-label={col.h}>
						<h3 class='label'>{col.h}</h3>
						{col.links.map((l) => (
							<a href={l.href}>{l.label}</a>
						))}
					</nav>
				))
			}
		</div>
		<div class='ft-bot'>
			<span>{copyright}</span>
			{
				footer.legalLinks.length > 0 && (
					<span class='ft-links'>
						{footer.legalLinks.map((l) => (
							<a href={l.href}>{l.label}</a>
						))}
					</span>
				)
			}
		</div>
	</div>
</footer>

<style>
	.ft {
		border-top: 1px solid var(--line);
		padding-block: clamp(56px, 7vw, 88px) 28px;
	}
	.ft-inner {
		display: grid;
		grid-template-columns: minmax(0, 2fr) repeat(var(--cols, 3), minmax(0, 1fr));
		gap: 40px;
	}
	.ft-brand p {
		margin-top: 12px;
		font-size: 14px;
		color: var(--ink-3);
		max-width: 28ch;
	}
	.ft-col h3 {
		margin-bottom: 14px;
	}
	.ft-col a {
		display: block;
		font-size: 15px;
		color: var(--ink-2);
		padding: 5px 0;
		transition: color 0.2s;
	}
	.ft-col a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
	}
	.ft-bot {
		margin-top: 56px;
		padding-top: 20px;
		border-top: 1px solid var(--line-soft);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px 24px;
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.02em;
		color: var(--ink-3);
	}
	.ft-links a {
		margin-left: 18px;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.ft-links a:hover {
		color: var(--ink);
	}
	@media (max-width: 780px) {
		.ft-inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.ft-brand {
			grid-column: 1 / -1;
		}
	}
</style>
