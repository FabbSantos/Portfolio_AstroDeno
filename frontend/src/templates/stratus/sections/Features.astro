---
import type { StratusConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: StratusConfig;
}
const { features } = Astro.props.config;
---

<section class='features' id='features' aria-labelledby='features-title'>
	<div class='sec-h'>
		{features.eyebrow && <span class='eyebrow'>{features.eyebrow}</span>}
		<h2 id='features-title' set:html={md(features.title)} />
	</div>
	<div class='feat-grid'>
		{
			features.items.map((f) => (
				<article class='feat' style={f.tint ? `--tint:${f.tint}` : undefined}>
					<div class='feat-ic' aria-hidden='true'>
						{f.icon}
					</div>
					<h3>{f.title}</h3>
					<p set:html={md(f.desc)} />
				</article>
			))
		}
	</div>
</section>

<style>
	.features {
		max-width: 1240px;
		margin: 0 auto;
		padding: 100px 32px;
	}
	.feat-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}
	.feat {
		padding: 32px 28px;
		background: var(--bg-3);
		border: 1px solid var(--rule);
		border-radius: var(--r-card);
		transition:
			transform 0.3s,
			box-shadow 0.3s;
	}
	.feat:hover {
		transform: translateY(-4px);
		box-shadow: 0 30px 60px -20px color-mix(in srgb, #000 12%, transparent);
	}
	.feat-ic {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: color-mix(in srgb, var(--tint, var(--accent)) 10%, transparent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 22px;
		margin-bottom: 18px;
	}
	.feat h3 {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}
	.feat p {
		font-size: 15px;
		line-height: 1.55;
		color: var(--ink-2);
	}
	@media (max-width: 900px) {
		.feat-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
