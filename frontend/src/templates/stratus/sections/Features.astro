---
/**
 * Features on a hairline grid (3 across, 2 across under 1100px, 1 on phones),
 * crosshair marks where the lines meet, and a soft spotlight that follows the
 * pointer across the grid. Each cell carries its index in mono; `icon` is
 * optional and shows next to it.
 */
import type { StratusConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: StratusConfig;
}
const { features } = Astro.props.config;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section class='features sec' id='features' aria-labelledby='features-title'>
	<div class='wrap'>
		<div class='sec-head'>
			{features.eyebrow && <p class='eyebrow'>{features.eyebrow}</p>}
			<h2 id='features-title' class='display' set:html={md(features.title)} />
			{features.lead && <p class='sec-l' set:html={md(features.lead)} />}
		</div>
		<div class='frame'>
			<span class='mark' aria-hidden='true'></span>
			<ul class='feat-grid' data-spotlight style={`--n:${features.items.length}`}>
				{
					features.items.map((f, i) => (
						<li class='feat'>
							<span class='feat-n'>
								{num(i)}
								{f.icon && <span class='feat-ic'>{f.icon}</span>}
							</span>
							<h3>{f.title}</h3>
							<p set:html={md(f.desc)} />
							<span class='cross' aria-hidden='true' />
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	// The spotlight is a radial gradient positioned by two custom properties.
	document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((grid) => {
		if (!window.matchMedia('(hover: hover)').matches) return;
		let raf = 0;
		grid.addEventListener('pointermove', (e) => {
			if (raf) return;
			raf = requestAnimationFrame(() => {
				raf = 0;
				const r = grid.getBoundingClientRect();
				grid.style.setProperty('--mx', `${e.clientX - r.left}px`);
				grid.style.setProperty('--my', `${e.clientY - r.top}px`);
				grid.classList.add('is-lit');
			});
		});
		grid.addEventListener('pointerleave', () => grid.classList.remove('is-lit'));
	});
</script>

<style>
	.feat-grid {
		--cols: 3;
		position: relative;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		background: var(--bg);
		overflow: hidden;
	}
	/* Spotlight layer */
	.feat-grid::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.4s;
	}
	.feat-grid.is-lit::before {
		opacity: 1;
	}
	.feat {
		position: relative;
		padding: 30px 28px 34px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		display: grid;
		gap: 12px;
		align-content: start;
	}
	.feat:nth-child(3n) {
		border-right: 0;
	}
	.feat:nth-last-child(-n + 3) {
		border-bottom: 0;
	}
	/* Crosshair at the bottom-right corner of each cell */
	.cross {
		position: absolute;
		right: -5px;
		bottom: -5px;
		width: 9px;
		height: 9px;
		z-index: 1;
	}
	.cross::before,
	.cross::after {
		content: '';
		position: absolute;
		background: var(--ink);
	}
	.cross::before {
		left: 4px;
		top: 0;
		width: 1px;
		height: 9px;
	}
	.cross::after {
		top: 4px;
		left: 0;
		width: 9px;
		height: 1px;
	}
	.feat:nth-child(3n) .cross,
	.feat:nth-last-child(-n + 3) .cross {
		display: none;
	}
	.feat-n {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		color: var(--accent-text);
	}
	.feat-ic {
		font-size: 14px;
		color: var(--ink);
	}
	.feat h3 {
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.2;
		margin-top: 18px;
	}
	.feat p {
		font-size: 15px;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 34ch;
	}
	@media (max-width: 1100px) {
		.feat-grid {
			--cols: 2;
		}
		.feat:nth-child(3n) {
			border-right: 1px solid var(--line);
		}
		.feat:nth-child(2n) {
			border-right: 0;
		}
		.feat:nth-last-child(-n + 3) {
			border-bottom: 1px solid var(--line);
		}
		.feat:nth-last-child(-n + 2) {
			border-bottom: 0;
		}
		.feat:nth-child(3n) .cross,
		.feat:nth-last-child(-n + 3) .cross {
			display: block;
		}
		.feat:nth-child(2n) .cross,
		.feat:nth-last-child(-n + 2) .cross {
			display: none;
		}
	}
	@media (max-width: 640px) {
		.feat-grid {
			--cols: 1;
		}
		.feat,
		.feat:nth-child(3n) {
			border-right: 0;
			border-bottom: 1px solid var(--line);
			padding: 24px 20px 28px;
		}
		.feat:last-child {
			border-bottom: 0;
		}
		.cross {
			display: none !important;
		}
		.feat-grid::before {
			display: none;
		}
	}
</style>
