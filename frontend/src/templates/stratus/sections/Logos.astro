---
import { Image } from 'astro:assets';
import type { StratusConfig } from '../schema';

interface Props {
	config: StratusConfig;
}
const { logos } = Astro.props.config;
---

{
	logos.items.length > 0 && (
		<section class='logos' aria-labelledby={logos.title ? 'logos-title' : undefined}>
			{logos.title && (
				<h2 class='logos-l' id='logos-title'>
					{logos.title}
				</h2>
			)}
			<div class='logos-row'>
				{logos.items.map((l) =>
					l.image ? (
						<Image class='logo-img' src={l.image} alt={l.name} height={28} densities={[1, 2]} format='webp' loading='lazy' decoding='async' />
					) : (
						<span class='logo-wm'>{l.name}</span>
					),
				)}
			</div>
		</section>
	)
}

<style>
	.logos {
		max-width: 1100px;
		margin: 0 auto;
		padding: 60px 32px 80px;
		text-align: center;
	}
	.logos-l {
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin-bottom: 28px;
	}
	.logos-row {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 48px;
		flex-wrap: wrap;
	}
	.logo-wm {
		font-family: 'Georgia', serif;
		font-size: 22px;
		font-style: italic;
		color: var(--ink-3);
		opacity: 0.5;
		letter-spacing: -0.02em;
	}
	.logo-img {
		height: 28px;
		width: auto;
		opacity: 0.55;
		filter: grayscale(1);
		transition: opacity 0.2s, filter 0.2s;
	}
	.logo-img:hover {
		opacity: 1;
		filter: none;
	}
</style>
