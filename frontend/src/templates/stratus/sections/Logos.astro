---
/** Logo strip between two hairlines: a mono kicker, then the wordmarks or logo images in one row. */
import { Image } from 'astro:assets';
import type { StratusConfig } from '../schema';

interface Props {
	config: StratusConfig;
}
const { logos } = Astro.props.config;
---

{
	logos.items.length > 0 && (
		<section class='logos' aria-labelledby={logos.title ? 'logos-title' : undefined}>
			<div class='wrap logos-in'>
				{logos.title && (
					<h2 class='label' id='logos-title'>
						{logos.title}
					</h2>
				)}
				<ul class='logos-row'>
					{logos.items.map((l) => (
						<li>{l.image ? <Image class='logo-img' src={l.image} alt={l.name} height={24} densities={[1, 2]} format='webp' loading='lazy' decoding='async' quality='high' /> : <span class='logo-wm'>{l.name}</span>}</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.logos {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.logos-in {
		display: flex;
		align-items: center;
		gap: 32px;
		padding-block: 22px;
	}
	.logos .label {
		flex: none;
		margin: 0;
	}
	.logos-row {
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px 40px;
		flex-wrap: wrap;
		flex: 1;
	}
	.logo-wm {
		font-family: var(--text);
		font-variation-settings: 'wdth' 118;
		font-weight: 700;
		font-size: 17px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--ink-3);
		transition: color 0.2s;
	}
	li:hover .logo-wm {
		color: var(--ink);
	}
	.logo-img {
		height: 24px;
		width: auto;
		opacity: 0.6;
		filter: grayscale(1);
		transition:
			opacity 0.2s,
			filter 0.2s;
	}
	.logo-img:hover {
		opacity: 1;
		filter: none;
	}
	@media (max-width: 900px) {
		.logos-in {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}
		.logos-row {
			justify-content: flex-start;
			gap: 14px 28px;
		}
		.logo-wm {
			font-size: 15px;
		}
	}
</style>
