---
/**
 * Final call on an ink block: wide title, sub, the buttons, and the optional
 * core LeadForm (mini) in a single row.
 */
import LeadForm from '../../core/LeadForm.astro';
import type { StratusConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: StratusConfig;
}
const { config } = Astro.props;
const { finalCta } = config;
---

<section class='cta' id='cta' aria-labelledby='cta-title'>
	<div class='wrap cta-in'>
		<div class='cta-copy'>
			<h2 id='cta-title' class='display' set:html={md(finalCta.title)} />
			{finalCta.sub && <p class='cta-sub' set:html={md(finalCta.sub)} />}
		</div>
		<div class='cta-side'>
			{
				finalCta.ctas.length > 0 && (
					<div class='cta-row'>
						{finalCta.ctas.map((c, i) => (
							<a href={c.href} class:list={['btn', 'btn--lg', i === 0 ? 'btn--paper' : 'btn--dark']}>
								{c.label}
							</a>
						))}
					</div>
				)
			}
			{
				finalCta.form && (
					<div class='cta-form'>
						<LeadForm site={config} id='stratus-lead' variant='mini' fields={finalCta.form.fields} cta={finalCta.form.cta} foot={finalCta.form.foot} source='final-cta' />
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.cta {
		background: var(--ink);
		color: var(--bg);
		padding-block: clamp(72px, 9vw, 120px);
	}
	.cta-in {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: clamp(32px, 5vw, 72px);
		align-items: end;
	}
	.cta h2 {
		font-size: clamp(44px, 6.4vw, 96px);
		max-width: 12ch;
	}
	.cta-sub {
		margin-top: 20px;
		font-size: 17px;
		line-height: 1.55;
		color: color-mix(in srgb, var(--bg) 72%, transparent);
		max-width: 44ch;
	}
	.cta-row {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}
	.btn--dark {
		background: transparent;
		color: var(--bg);
		border-color: var(--line-on-dark);
	}
	.btn--dark:hover {
		background: var(--bg);
		color: var(--ink);
		border-color: var(--bg);
	}
	.cta-form {
		margin-top: 24px;
		max-width: 520px;
	}
	.cta-form :global(.lead-form) {
		color: var(--bg);
	}
	.cta-form :global(.lead-form .lf-field label) {
		color: color-mix(in srgb, var(--bg) 70%, transparent);
	}
	.cta-form :global(.lead-form.lead-form .lf-field input),
	.cta-form :global(.lead-form.lead-form .lf-field select) {
		background: transparent;
		color: var(--bg);
		border-color: var(--line-on-dark);
	}
	.cta-form :global(.lead-form.lead-form .lf-field input:focus) {
		border-color: var(--bg);
		box-shadow: inset 0 0 0 1px var(--bg);
	}
	.cta-form :global(.lead-form.lead-form .lf-submit) {
		background: var(--bg);
		color: var(--ink);
		border-color: var(--bg);
	}
	.cta-form :global(.lead-form.lead-form .lf-submit:hover) {
		background: var(--accent-on-dark);
		border-color: var(--accent-on-dark);
		color: var(--ink);
	}
	.cta-form :global(.lead-form .lf-foot),
	.cta-form :global(.lead-form .lf-status) {
		color: color-mix(in srgb, var(--bg) 65%, transparent);
	}
	@media (max-width: 900px) {
		.cta-in {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
