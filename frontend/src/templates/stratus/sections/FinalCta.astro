---
import LeadForm from '../../core/LeadForm.astro';
import type { StratusConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: StratusConfig;
}
const { config } = Astro.props;
const { finalCta } = config;
---

<section class='cta' id='cta' aria-labelledby='cta-title'>
	<h2 id='cta-title' set:html={md(finalCta.title)} />
	{finalCta.sub && <p set:html={md(finalCta.sub)} />}
	{
		finalCta.ctas.length > 0 && (
			<div class='cta-row center'>
				{finalCta.ctas.map((c, i) => (
					<a href={c.href} class:list={[i === 0 ? 'btn-acc' : 'btn-ghost', 'lg']}>
						{c.label}
					</a>
				))}
			</div>
		)
	}
	{
		finalCta.form && (
			<div class='cta-form'>
				<LeadForm site={config} id='stratus-lead' variant='mini' fields={finalCta.form.fields} cta={finalCta.form.cta} foot={finalCta.form.foot} source='final-cta' />
			</div>
		)
	}
</section>

<style>
	.cta {
		max-width: 1240px;
		margin: 0 auto 100px;
		padding: 100px 32px;
		text-align: center;
		background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 15%, var(--bg-3)), color-mix(in srgb, var(--accent) 28%, var(--bg-3)));
		border-radius: var(--r-cta);
	}
	.cta h2 {
		font-size: clamp(40px, 6vw, 80px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
		max-width: 16ch;
		margin: 0 auto;
	}
	.cta p {
		margin: 18px auto 32px;
		font-size: 18px;
		color: var(--ink-2);
	}
	.cta-form {
		max-width: 560px;
		margin: 32px auto 0;
		text-align: left;
	}
	.cta-form :global(.lf-submit) {
		border-radius: 999px;
		background: var(--ink);
	}
	.cta-form :global(.lf-submit:hover) {
		background: var(--accent);
	}
	.cta-form :global(.lf-field input),
	.cta-form :global(.lf-field select) {
		border-radius: 999px;
	}
	@media (max-width: 780px) {
		.cta {
			margin-left: 20px;
			margin-right: 20px;
			padding: 72px 24px;
		}
	}
</style>
