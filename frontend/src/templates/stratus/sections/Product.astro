---
/**
 * Product shot in a hairline frame with corner marks and a mono meta bar
 * (`product.meta`, e.g. 'app.stratus.io · v3.0'). With `product.image`: the
 * client's screenshot (eager, high priority; it sits right under the hero).
 * Without: a CSS dashboard drawn in hairlines, KPI tiles from `product.kpis`.
 */
import { Image } from 'astro:assets';
import type { StratusConfig } from '../schema';

interface Props {
	config: StratusConfig;
}
const { product, brand } = Astro.props.config;
const shot = product?.image ?? null;
const kpis = product?.kpis ?? [];
const widths = shot ? [...[640, 960, 1280, 1600].filter((w) => w < shot.width), shot.width] : [];
const meta = product?.meta ?? brand.name;
const en = brand.locale === 'en';
---

{
	product && (
		<div class='product wrap'>
			<div class='frame'>
				<span class='mark' aria-hidden='true' />
				<div class='meta' aria-hidden='true'>
					<span class='meta-live'>
						<span class='meta-dot' />
						{en ? 'live' : 'ao vivo'}
					</span>
					<span class='meta-text'>{meta}</span>
					<span class='meta-right'>100%</span>
				</div>
				{shot ? (
					<Image
						class='shot-img'
						src={shot}
						alt={product.alt ?? ''}
						widths={widths}
						sizes='(max-width: 1280px) calc(100vw - 40px), 1184px'
						format='webp'
						loading='eager'
						fetchpriority='high'
						decoding='async'
						quality={82}
					/>
				) : (
					<div class='dash' aria-hidden='true'>
						<div class='dash-side'>
							<div class='ds-logo' />
							<div class='ds-item is-on' />
							<div class='ds-item' />
							<div class='ds-item' />
							<div class='ds-item' />
							<div class='ds-item' />
						</div>
						<div class='dash-main'>
							<div class='dm-bar'>
								<div class='dm-title' />
								<div class='dm-search' />
							</div>
							{kpis.length > 0 && (
								<div class='dm-stats'>
									{kpis.map((k) => (
										<div class='dm-stat'>
											<span class='ds-v'>{k.value}</span>
											{k.label ? <span class='ds-t'>{k.label}</span> : <span class='ds-l' />}
										</div>
									))}
								</div>
							)}
							<div class='dm-chart'>
								<svg viewBox='0 0 600 200' preserveAspectRatio='none' aria-hidden='true'>
									<path d='M0,160 L40,140 L80,150 L120,120 L160,128 L200,90 L240,110 L280,70 L320,80 L360,50 L400,60 L440,30 L480,55 L520,40 L560,25 L600,35 L600,200 L0,200 Z' fill='var(--accent)' fill-opacity='0.08' />
									<path d='M0,160 L40,140 L80,150 L120,120 L160,128 L200,90 L240,110 L280,70 L320,80 L360,50 L400,60 L440,30 L480,55 L520,40 L560,25 L600,35' fill='none' stroke='var(--accent)' stroke-width='2' vector-effect='non-scaling-stroke' />
								</svg>
							</div>
							<div class='dm-table'>
								{Array.from({ length: 4 }).map(() => (
									<div class='dm-row'>
										<span class='dm-cell w20' />
										<span class='dm-cell w30' />
										<span class='dm-cell w15' />
										<span class='dm-cell w15' />
										<span class='dm-cell w20' />
									</div>
								))}
							</div>
						</div>
					</div>
				)}
			</div>
		</div>
	)
}

<style>
	.product {
		padding-bottom: clamp(48px, 6vw, 80px);
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.meta-live {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
	}
	.meta-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-text);
	}
	.meta-right {
		margin-left: auto;
	}
	.shot-img {
		width: 100%;
		height: auto;
		display: block;
	}

	/* Hairline dashboard */
	.dash {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		min-height: 460px;
		background: var(--bg);
	}
	.dash-side {
		padding: 20px 14px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		border-right: 1px solid var(--line);
	}
	.ds-logo {
		width: 26px;
		height: 26px;
		background: var(--ink);
		margin-bottom: 14px;
	}
	.ds-item {
		height: 12px;
		width: 70%;
		background: var(--line-soft);
	}
	.ds-item.is-on {
		background: var(--accent-text);
		width: 55%;
	}
	.dash-main {
		padding: 22px 26px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.dm-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--line);
	}
	.dm-title {
		width: 160px;
		height: 14px;
		background: var(--ink);
	}
	.dm-search {
		width: 200px;
		height: 26px;
		border: 1px solid var(--line);
	}
	.dm-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--line);
	}
	.dm-stat {
		padding: 14px 16px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		border-left: 1px solid var(--line);
	}
	.dm-stat:first-child {
		border-left: 0;
	}
	.ds-v {
		font-family: var(--mono);
		font-size: 20px;
		font-weight: 600;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}
	.ds-l {
		display: block;
		height: 6px;
		width: 55%;
		background: var(--line-soft);
	}
	.ds-t {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.dm-chart {
		border: 1px solid var(--line);
		padding: 14px;
		background-image: linear-gradient(var(--line-soft) 1px, transparent 1px);
		background-size: 100% 40px;
	}
	.dm-chart svg {
		width: 100%;
		height: 180px;
		display: block;
	}
	.dm-table {
		display: flex;
		flex-direction: column;
	}
	.dm-row {
		display: flex;
		gap: 14px;
		padding: 12px 0;
		border-bottom: 1px solid var(--line-soft);
	}
	.dm-cell {
		height: 8px;
		background: var(--line-soft);
	}
	.dm-cell.w15 {
		width: 15%;
	}
	.dm-cell.w20 {
		width: 20%;
	}
	.dm-cell.w30 {
		width: 30%;
	}
	@media (max-width: 780px) {
		.dash {
			grid-template-columns: minmax(0, 1fr);
			min-height: 0;
		}
		.dash-side {
			display: none;
		}
		.dm-stats {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.dm-stat:nth-child(3) {
			border-left: 0;
		}
		.dm-stat:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}
		.meta-right {
			display: none;
		}
	}
</style>
