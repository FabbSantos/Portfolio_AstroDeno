---
import type { StratusConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: StratusConfig;
}
const { hero } = Astro.props.config;

// '★★★★★ **4.9** on G2 …' → stars get their own styled span.
const proofMatch = hero.socialProof ? /^([★☆]+)\s*([\s\S]*)$/.exec(hero.socialProof) : null;
const proofStars = proofMatch?.[1] ?? '';
const proofText = proofMatch ? (proofMatch[2] ?? '') : (hero.socialProof ?? '');
---

<section class='hero' aria-labelledby='hero-title'>
	{
		hero.pill &&
			(hero.pill.href ? (
				<a href={hero.pill.href} class='pill'>
					{hero.pill.tag && <span class='pill-tag'>{hero.pill.tag}</span>}
					{hero.pill.text} <span class='arr'>→</span>
				</a>
			) : (
				<span class='pill'>
					{hero.pill.tag && <span class='pill-tag'>{hero.pill.tag}</span>}
					{hero.pill.text}
				</span>
			))
	}
	<h1 id='hero-title' set:html={md(hero.title)} />
	<p class='lead' set:html={md(hero.lead)} />
	<div class='cta-row'>
		<a href={hero.primary.href} class='btn-acc lg'>{hero.primary.label}</a>
		{
			hero.secondary && (
				<a href={hero.secondary.href} class='btn-ghost lg'>
					{hero.secondary.label}
				</a>
			)
		}
	</div>
	{
		hero.socialProof && (
			<p class='proof'>
				{proofStars && <span class='proof-stars'>{proofStars}</span>}
				<Fragment set:html={md(proofText)} />
			</p>
		)
	}
</section>

<style>
	.hero {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 32px 60px;
		text-align: center;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px 14px 6px 6px;
		background: var(--accent-soft);
		color: var(--accent-text);
		border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		margin-bottom: 28px;
	}
	.pill-tag {
		background: var(--accent-text);
		color: #fff;
		padding: 3px 8px;
		border-radius: 999px;
		font-size: 10px;
		letter-spacing: 0.06em;
	}
	.hero h1 {
		font-size: clamp(48px, 7.5vw, 96px);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.96;
		max-width: 16ch;
		margin: 0 auto;
	}
	.hero .lead {
		margin: 28px auto 0;
		max-width: 56ch;
		font-size: clamp(17px, 1.6vw, 21px);
		line-height: 1.55;
		color: var(--ink-2);
	}
	.proof {
		margin-top: 32px;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
	}
	.proof-stars {
		color: var(--accent-text);
		letter-spacing: 2px;
		margin-right: 8px;
	}
</style>
