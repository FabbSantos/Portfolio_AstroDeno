---
/**
 * Announcement strip in italic Didone, looping between two hairlines. The
 * loop speeds up while the page scrolls and settles back (Web Animations
 * playbackRate, no layout work). Static under reduced motion.
 */
import type { BravaConfig } from '../schema';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { messages } = config.ticker;

// Repeat short lists so the loop never shows a gap on wide screens.
let items = messages;
while (items.length < 8) items = [...items, ...messages];
const text = items.map((m) => `${m}`).join('  ·  ');
---

<div class='ticker' data-ticker>
	<div class='ticker-track'>
		{
			[0, 1].map((i) => (
				<div class='ticker-row' aria-hidden={i === 1 ? 'true' : undefined}>
					<span>{text}&nbsp;&nbsp;·&nbsp;&nbsp;</span>
				</div>
			))
		}
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((el) => {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const track = el.querySelector<HTMLElement>('.ticker-track');
		const anim = track?.getAnimations()[0];
		if (!anim) return;
		let last = window.scrollY;
		let rate = 1;
		let raf = 0;
		const settle = () => {
			rate = Math.max(1, rate * 0.92);
			anim.playbackRate = rate;
			if (rate > 1.02) raf = requestAnimationFrame(settle);
			else raf = 0;
		};
		window.addEventListener(
			'scroll',
			() => {
				const dy = Math.abs(window.scrollY - last);
				last = window.scrollY;
				rate = Math.min(6, rate + dy / 40);
				anim.playbackRate = rate;
				if (!raf) raf = requestAnimationFrame(settle);
			},
			{ passive: true }
		);
	});
</script>

<style>
	.ticker {
		overflow: hidden;
		padding: 10px 0;
		border-bottom: 1px solid var(--line);
		font-family: var(--display);
		font-style: italic;
		font-size: 17px;
		font-weight: 400;
		letter-spacing: 0.01em;
		color: var(--ink-2);
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: brava-tick 40s linear infinite;
	}
	.ticker-row {
		white-space: nowrap;
	}
	@keyframes brava-tick {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
	}
</style>
