---
/**
 * The drop: products without cards. Portrait photo, a paper chip for the tag,
 * the name in Didone with the price beside it. Sold-out pieces dim and get
 * their name struck. Products link to `href` when given.
 */
import { Image } from 'astro:assets';
import type { BravaConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { shop } = config;
---

<section class='shop sec' id='shop' aria-labelledby='shop-title'>
	<div class='wrap'>
		<div class='sec-head'>
			<p class='eyebrow'>{shop.eyebrow}</p>
			<h2 id='shop-title' class='display' set:html={md(shop.title)} />
			<p class='shop-count'>{String(shop.products.length).padStart(2, '0')}</p>
		</div>
		<ul class='prod-grid'>
			{
				shop.products.map((p) => {
					const Card = p.href ? 'a' : 'div';
					return (
						<li>
							<Card href={p.href} class:list={['prod', { 'is-sold': p.sold }]} style={p.tint ? `--tint:${p.tint}` : undefined}>
								<div class='prod-img'>
									{p.image && <Image src={p.image} alt={p.alt ?? p.name} widths={[400, 640, 800]} sizes='(max-width: 780px) 50vw, 30vw' format='webp' quality={74} loading='lazy' decoding='async' />}
									{p.tag && <span class='p-tag'>{p.tag}</span>}
									{p.sold && <span class='p-sold'>{shop.soldLabel}</span>}
								</div>
								<div class='prod-meta'>
									<span class='p-n'>{p.n}</span>
									<h3 class='p-name'>{p.name}</h3>
									<span class='p-price'>{p.price}</span>
								</div>
							</Card>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.shop-count {
		font-family: var(--display);
		font-size: clamp(44px, 6vw, 96px);
		font-weight: 400;
		font-style: italic;
		line-height: 0.98;
		color: var(--ink-3);
	}
	.prod-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px 24px;
	}
	.prod {
		display: grid;
		gap: 14px;
		color: var(--ink);
	}
	.prod-img {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: color-mix(in srgb, var(--tint, var(--bg-2)) 100%, transparent);
	}
	.prod-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 0.9s var(--ease),
			opacity 0.4s;
	}
	a.prod:hover .prod-img :global(img) {
		transform: scale(1.04);
	}
	.prod.is-sold .prod-img :global(img) {
		opacity: 0.45;
		filter: grayscale(1);
	}
	.p-tag,
	.p-sold {
		position: absolute;
		left: 12px;
		top: 12px;
		padding: 5px 9px;
		background: var(--ink);
		color: var(--bg);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.p-sold {
		top: auto;
		left: 50%;
		bottom: 16px;
		transform: translateX(-50%);
		background: var(--accent);
		color: #fff;
	}
	.prod-meta {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 12px;
		padding-top: 12px;
		border-top: 1px solid var(--line-soft);
	}
	.p-n {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--ink-3);
	}
	.p-name {
		font-family: var(--display);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.1;
	}
	.prod.is-sold .p-name {
		text-decoration: line-through;
		text-decoration-thickness: 1px;
		color: var(--ink-3);
	}
	.p-price {
		font-size: 14px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--ink-2);
	}
	@media (max-width: 780px) {
		.prod-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 28px 14px;
		}
		.p-name {
			font-size: 20px;
		}
		.prod-meta {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.p-n {
			display: none;
		}
	}
</style>
