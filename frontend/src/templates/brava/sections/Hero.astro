---
/**
 * Hero: eyebrow, the h1 in Didone (one entry per line), sub, the countdown
 * to `drop.endsAt` as bare numerals on a hairline, the call to action; on the
 * right the main portrait (tiles[0], eager, the LCP) with the two other tiles
 * stacked beside it.
 */
import { Image } from 'astro:assets';
import type { BravaConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { hero, drop } = config;

// Server-side initial state so the numbers are right even before JS runs.
const diff = Math.max(0, Date.parse(drop.endsAt) - Date.now());
const ended = diff <= 0;
const pad = (n: number) => String(n).padStart(2, '0');
const initial = {
	d: pad(Math.floor(diff / 86400000)),
	h: pad(Math.floor((diff % 86400000) / 3600000)),
	m: pad(Math.floor((diff % 3600000) / 60000)),
	s: pad(Math.floor((diff % 60000) / 1000)),
};
const cells = [
	['d', drop.units.days],
	['h', drop.units.hours],
	['m', drop.units.minutes],
	['s', drop.units.seconds],
] as const;
const [main, ...rest] = hero.tiles;
---

<section class='hero' aria-labelledby='hero-title'>
	<div class='wrap hero-grid'>
		<div class='hero-copy'>
			<p class='eyebrow'>{hero.eyebrow}</p>
			<h1 id='hero-title' class='display'>
				{
					hero.lines.map((line, i) => (
						<>
							{i > 0 && <br />}
							<Fragment set:html={md(line)} />
						</>
					))
				}
			</h1>
			<p class='hero-sub'>{hero.sub}</p>
			<div class:list={['countdown', { 'is-ended': ended }]} data-countdown data-ends-at={drop.endsAt}>
				<p class='cd-label'>{drop.countdownLabel}</p>
				<div class='counter' aria-label={drop.countdownLabel} hidden={ended}>
					{
						cells.map(([k, label]) => (
							<div class='cd'>
								<span class='c-v' data-cd={k}>
									{initial[k]}
								</span>
								<span class='c-l'>{label}</span>
							</div>
						))
					}
				</div>
				<p class='c-ended' data-countdown-ended hidden={!ended}>{drop.ended}</p>
			</div>
			<a href={hero.cta.href} class='btn'>{hero.cta.label}</a>
		</div>
		<div class='hero-media'>
			<div class='hero-side'>
				{
					rest.map((t) => (
						<figure class='hero-tile' style={t.tint ? `--tint:${t.tint}` : undefined}>
							<Image src={t.image} alt={t.alt} widths={[320, 480, 640]} sizes='(max-width: 900px) 40vw, 14vw' format='webp' quality={72} loading='lazy' decoding='async' />
						</figure>
					))
				}
			</div>
			{
				main && (
					<figure class='hero-main' style={main.tint ? `--tint:${main.tint}` : undefined}>
						<Image src={main.image} alt={main.alt} widths={[480, 720, 960, 1200]} sizes='(max-width: 900px) 60vw, 30vw' format='webp' quality={74} loading='eager' fetchpriority='high' decoding='async' />
					</figure>
				)
			}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((box) => {
		const target = Date.parse(box.dataset.endsAt ?? '');
		if (Number.isNaN(target)) return;
		const counter = box.querySelector<HTMLElement>('[aria-label]');
		const endedEl = box.querySelector<HTMLElement>('[data-countdown-ended]');
		const cell = (k: string) => box.querySelector<HTMLElement>(`[data-cd='${k}']`);
		const cells = { d: cell('d'), h: cell('h'), m: cell('m'), s: cell('s') };
		const pad = (n: number) => String(n).padStart(2, '0');
		let timer = 0;

		const tick = () => {
			const diff = Math.max(0, target - Date.now());
			const next = { d: pad(Math.floor(diff / 86400000)), h: pad(Math.floor((diff % 86400000) / 3600000)), m: pad(Math.floor((diff % 3600000) / 60000)), s: pad(Math.floor((diff % 60000) / 1000)) };
			(Object.keys(next) as Array<keyof typeof next>).forEach((k) => {
				const el = cells[k];
				if (el && el.textContent !== next[k]) el.textContent = next[k];
			});
			if (diff <= 0) {
				window.clearInterval(timer);
				if (counter) counter.hidden = true;
				if (endedEl) endedEl.hidden = false;
				box.classList.add('is-ended');
			}
		};
		tick();
		timer = window.setInterval(tick, 1000);
	});
</script>

<style>
	.hero {
		padding-block: clamp(40px, 6vw, 88px) clamp(48px, 6vw, 88px);
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: center;
	}
	.hero-copy {
		display: grid;
		gap: 26px;
		justify-items: start;
	}
	.hero h1 {
		font-size: clamp(56px, 7.6vw, 124px);
		line-height: 0.94;
	}
	.hero-sub {
		font-size: 17px;
		line-height: 1.6;
		color: var(--ink-2);
		max-width: 44ch;
	}

	/* Countdown: bare numerals on a hairline */
	.countdown {
		width: 100%;
		max-width: 520px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}
	.cd-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin-bottom: 12px;
	}
	.counter {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}
	.counter[hidden] {
		display: none;
	}
	.cd {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding-left: 14px;
		border-left: 1px solid var(--line);
	}
	.cd:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.c-v {
		font-family: var(--display);
		font-size: clamp(40px, 4.4vw, 64px);
		font-weight: 500;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.01em;
	}
	.c-l {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.c-ended {
		font-size: 15px;
		color: var(--ink-2);
		max-width: 40ch;
	}
	.c-ended[hidden] {
		display: none;
	}

	/* Media: main portrait, the other two stacked beside it */
	.hero-media {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: 12px;
		align-items: stretch;
	}
	.hero-side {
		display: grid;
		grid-template-rows: 1fr 1fr;
		gap: 12px;
	}
	.hero-tile,
	.hero-main {
		position: relative;
		margin: 0;
		overflow: hidden;
		background: color-mix(in srgb, var(--tint, var(--bg-2)) 100%, transparent);
	}
	.hero-main {
		aspect-ratio: 4 / 5;
	}
	.hero-tile :global(img),
	.hero-main :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero h1 {
			font-size: clamp(52px, 13vw, 88px);
		}
		.hero-media {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		}
		.hero-main {
			order: -1;
		}
	}
	@media (max-width: 480px) {
		.counter {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 16px;
		}
		.cd:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>
