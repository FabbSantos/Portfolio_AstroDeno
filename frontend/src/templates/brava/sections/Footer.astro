---
/** Footer: brand in Didone, link columns, then the legal line (+ privacy) and the socials on a hairline. */
import type { BravaConfig } from '../schema';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { brand, topbar, footer, legal } = config;
---

<footer class='ft'>
	<div class='wrap'>
		<div class='ft-inner' style={`--cols:${footer.columns.length}`}>
			<div class='ft-brand'>
				<a href={topbar.brandHref} class='brand'>{brand.name}</a>
				{brand.tagline && <p>{brand.tagline}</p>}
			</div>
			{
				footer.columns.map((c) => (
					<nav class='ft-col' aria-label={c.h}>
						<h3>{c.h}</h3>
						{c.links.map((l) => (
							<a href={l.href}>{l.label}</a>
						))}
					</nav>
				))
			}
		</div>
		<div class='ft-bot'>
			<span>
				{legal.lines.join(' · ')}
				{
					legal.privacyUrl && (
						<>
							{' · '}
							<a href={legal.privacyUrl}>{footer.privacyLabel}</a>
						</>
					)
				}
			</span>
			{
				footer.socials.length > 0 && (
					<span class='ft-soc'>
						{footer.socials.map((s) => (
							<a href={s.href}>{s.label}</a>
						))}
					</span>
				)
			}
		</div>
	</div>
</footer>

<style>
	.ft {
		border-top: 1px solid var(--line);
		padding-block: clamp(56px, 7vw, 88px) 28px;
	}
	.ft-inner {
		display: grid;
		grid-template-columns: minmax(0, 2fr) repeat(var(--cols, 3), minmax(0, 1fr));
		gap: 40px;
	}
	.ft-brand .brand {
		display: inline-block;
		text-align: left;
		font-size: 34px;
	}
	.ft-brand p {
		margin-top: 12px;
		font-family: var(--display);
		font-style: italic;
		font-size: 18px;
		color: var(--ink-3);
		max-width: 28ch;
	}
	.ft-col h3 {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin-bottom: 14px;
	}
	.ft-col a {
		display: block;
		padding: 5px 0;
		font-size: 15px;
		color: var(--ink-2);
		transition: color 0.2s;
	}
	.ft-col a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
	}
	.ft-bot {
		margin-top: 56px;
		padding-top: 20px;
		border-top: 1px solid var(--line-soft);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px 24px;
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--ink-3);
	}
	.ft-bot a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.ft-bot a:hover {
		color: var(--ink);
	}
	.ft-soc {
		display: flex;
		gap: 18px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 600;
	}
	@media (max-width: 780px) {
		.ft-inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.ft-brand {
			grid-column: 1 / -1;
		}
	}
</style>
