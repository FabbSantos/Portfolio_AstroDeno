---
/**
 * Desktop topbar (nav · brand centred in Didone · actions) ≥ 781px, on a
 * hairline; the core MobileNav takes over below that (restyled in styles.css).
 */
import MobileNav from '../../core/MobileNav.astro';
import type { BravaConfig } from '../schema';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { brand, nav, topbar } = config;
const { cart } = topbar;

const cartLabel = cart.count != null ? `${cart.label} (${cart.count})` : cart.label;
const mobileNav = [...nav, ...topbar.links, ...(cart.show ? [{ label: cartLabel, href: cart.href }] : [])];
---

<header class='tb'>
	<div class='tb-inner wrap'>
		<nav class='tb-nav' aria-label='Menu'>
			{nav.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
		<a href={topbar.brandHref} class='brand'>{brand.name}</a>
		<div class='tb-actions'>
			{topbar.links.map((l) => <a href={l.href}>{l.label}</a>)}
			{
				cart.show && (
					<a href={cart.href} class='cart'>
						{cart.label}
						{cart.count != null && <span class='cart-c'>{cart.count}</span>}
					</a>
				)
			}
		</div>
	</div>
</header>

<MobileNav class='tb-mobile' id='brava-nav' brand={brand.name} brandHref={topbar.brandHref} nav={mobileNav} />

<style>
	.tb {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.tb-inner {
		min-height: 68px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
	}
	.tb-nav,
	.tb-actions {
		display: flex;
		gap: 26px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-2);
	}
	.tb-actions {
		justify-content: flex-end;
	}
	.tb-nav a:hover,
	.tb-actions a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 1px;
	}
	.cart {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.cart-c {
		display: inline-grid;
		place-items: center;
		min-width: 18px;
		height: 18px;
		padding: 0 5px;
		background: var(--accent);
		color: #fff;
		font-size: 10px;
		letter-spacing: 0;
	}
	:global(.tb-mobile) {
		display: none;
	}
	@media (max-width: 780px) {
		.tb {
			display: none;
		}
		:global(.tb-mobile) {
			display: block;
		}
	}
</style>
