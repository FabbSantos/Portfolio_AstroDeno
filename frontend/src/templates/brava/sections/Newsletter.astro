---
/**
 * Newsletter: title and sub on the left, the core LeadForm (`mini`) on the
 * right as one row: a hairline field (plus the optional name) and the button.
 */
import LeadForm from '../../core/LeadForm.astro';
import type { LeadField } from '../../core/schema';
import type { BravaConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { newsletter } = config;

const fields: LeadField[] = [
	...(newsletter.name ? [{ name: 'name', label: newsletter.name.label, type: 'text' as const, required: true, placeholder: newsletter.name.placeholder, autocomplete: 'name' }] : []),
	{ name: 'email', label: newsletter.email.label, type: 'email', required: true, placeholder: newsletter.email.placeholder },
];
---

<section class='news sec' aria-labelledby='news-title'>
	<div class='wrap news-in'>
		<div class='news-copy'>
			<h2 id='news-title' class='display' set:html={md(newsletter.title)} />
			<p>{newsletter.sub}</p>
		</div>
		<div class='news-form'>
			<LeadForm site={config} id='newsletter' variant='mini' fields={fields} cta={newsletter.cta} foot={newsletter.foot} />
		</div>
	</div>
</section>

<style>
	.news-in {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: center;
	}
	.news h2 {
		font-size: clamp(44px, 5.6vw, 88px);
		max-width: 10ch;
	}
	.news-copy p {
		margin-top: 18px;
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink-2);
		max-width: 44ch;
	}
	@media (max-width: 900px) {
		.news-in {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
