---
/** Story: a narrow column between two hairlines; the first paragraph set larger. */
import type { BravaConfig } from '../schema';
import { md } from './_md';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { story } = config;
---

<section class='story' id='story' aria-labelledby='story-title'>
	<div class='wrap story-in'>
		<p class='eyebrow'>{story.eyebrow}</p>
		<h2 id='story-title' class='display' set:html={md(story.title)} />
		<div class='story-text'>{story.paragraphs.map((p) => <p>{p}</p>)}</div>
		{
			story.link && (
				<a href={story.link.href} class='link'>
					{story.link.label}
				</a>
			)
		}
	</div>
</section>

<style>
	.story {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding-block: clamp(72px, 9vw, 128px);
	}
	.story-in {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: start;
	}
	.story .eyebrow {
		grid-column: 1 / -1;
	}
	.story h2 {
		font-size: clamp(44px, 5.6vw, 88px);
		max-width: 10ch;
	}
	.story-text {
		display: grid;
		gap: 18px;
		max-width: 56ch;
	}
	.story-text p {
		font-size: 17px;
		line-height: 1.65;
		color: var(--ink-2);
	}
	.story-text p:first-child {
		font-family: var(--display);
		font-size: clamp(22px, 2.2vw, 30px);
		line-height: 1.3;
		color: var(--ink);
	}
	.story .link {
		grid-column: 2;
	}
	@media (max-width: 900px) {
		.story-in {
			grid-template-columns: minmax(0, 1fr);
		}
		.story .link {
			grid-column: auto;
		}
	}
</style>
