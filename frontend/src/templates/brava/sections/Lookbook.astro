---
/** Lookbook: 4 tiles (1 tall left, 2 small right, 1 wide below) + caption. */
import { Image } from 'astro:assets';
import type { BravaConfig } from '../schema';

interface Props {
	config: BravaConfig;
}
const { config } = Astro.props;
const { lookbook } = config;

const layout = [
	{ widths: [640, 1000], sizes: '(max-width: 780px) 66vw, 780px' },
	{ widths: [400, 800], sizes: '(max-width: 780px) 33vw, 380px' },
	{ widths: [400, 800], sizes: '(max-width: 780px) 33vw, 380px' },
	{ widths: [800, 1000], sizes: '(max-width: 780px) 100vw, 1180px' },
];
---

<section class='lookbook' id='lookbook' aria-labelledby='lookbook-title'>
	<h2 id='lookbook-title' class='sr-only'>{lookbook.title}</h2>
	<div class='lb-grid'>
		{
			lookbook.tiles.map((t, i) => (
				<figure class={`lb lb-${i + 1}`}>
					<Image
						src={t.image}
						alt={t.alt}
						widths={layout[i]?.widths}
						sizes={layout[i]?.sizes}
						format='webp'
						loading='lazy'
						decoding='async'
					/>
					{t.caption && <figcaption>{t.caption}</figcaption>}
				</figure>
			))
		}
	</div>
	<p class='lb-caption'>
		<span class='eyebrow'>{lookbook.eyebrow}</span>
		{lookbook.caption}
	</p>
</section>

<style>
	.lookbook {
		max-width: 1240px;
		margin: 60px auto 0;
		padding: 0 32px;
	}
	.lb-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		grid-template-rows: 240px 240px;
		gap: 12px;
	}
	.lb {
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, #fff), color-mix(in srgb, var(--accent) 45%, #fff));
	}
	.lb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.lb figcaption {
		position: absolute;
		left: 12px;
		bottom: 12px;
		padding: 4px 8px;
		background: var(--ink);
		color: #fff;
		font-family: var(--mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.lb-1 {
		grid-row: 1 / 3;
		background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 85%, #000), color-mix(in srgb, var(--accent) 70%, #000));
	}
	.lb-4 {
		grid-column: 1 / 3;
		grid-row: auto;
	}
	.lb-caption {
		margin-top: 18px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
		display: flex;
		gap: 16px;
		align-items: center;
		flex-wrap: wrap;
	}
	.lb-caption .eyebrow {
		margin-bottom: 0;
		color: var(--accent);
	}
</style>
