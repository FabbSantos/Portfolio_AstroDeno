---
/**
 * /templates/<slug> (and /en/templates/<slug>) — the sales page of one template.
 * Hero (meta, name, price, CTAs, measured Lighthouse scores) → the real demo in
 * a browser frame or a phone chassis (Desktop / Celular toggle) → what's in it /
 * what's included / how it works → other templates → CTA band.
 */
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/site/TopBar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import TemplateCard from '../components/templates/TemplateCard.astro';
import PhoneFrame from '../components/templates/PhoneFrame.astro';
import ScoreGauge from '../components/templates/ScoreGauge.astro';
import { lighthouse, scoresFor } from '../data/lighthouse';
import { SITE, whatsappUrl } from '../data/site';
import { demoPath, formatBRL, templates, type TemplateMeta } from '../data/templates';
import { fmt, localeOf, localePath, pick, useT } from '../i18n';

interface Props {
	tpl: TemplateMeta;
}
const { tpl } = Astro.props;
const locale = localeOf(Astro);
const t = useT(locale);

const months = SITE.promises.adjustmentsMonths;
const name = `${tpl.name} ${tpl.accent}`;
const index = templates.findIndex((x) => x.slug === tpl.slug) + 1;
const others = templates.filter((x) => x.slug !== tpl.slug);

const title = fmt(t.meta.templateDetail.title, { name: tpl.name, accent: tpl.accent });
const description = pick(tpl.lead, locale);
const meta = fmt(t.templates.detail.meta, {
	n: index,
	total: templates.length,
	cat: pick(tpl.cat, locale),
	days: tpl.days,
});
const sections = pick(tpl.sections, locale);
const included = t.templates.included.items.map((s) => fmt(s, { months }));
const steps = t.templates.steps.items.map((s) => ({ title: s.title, desc: fmt(s.desc, { months }) }));

const demo = demoPath(tpl.slug);
const demoTitle = fmt(t.templates.detail.demoTitle, { name });
const device = t.templates.detail.device;
const demoUrlLabel = `${new URL(SITE.url).host}${demo}`;
const wantHref = localePath(locale, `/?template=${tpl.slug}#contato`);
const wa = whatsappUrl(locale, fmt(t.templates.cta.whatsappDetail, { name }));

const scores = scoresFor(tpl.slug);
const sc = t.templates.detail.scores;
const gauges = scores
	? [
			{ label: sc.mobile, score: scores.mobile },
			{ label: sc.desktop, score: scores.desktop },
			{ label: sc.accessibility, score: scores.accessibility },
			{ label: sc.bestPractices, score: scores.bestPractices },
		]
	: [];
const measuredOn = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-BR' : 'en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(
	new Date(`${lighthouse.measuredAt}T12:00:00Z`)
);
const scoresNote = fmt(sc.note, { version: lighthouse.lighthouse, runs: lighthouse.runs, date: measuredOn });
// even count: two columns, so the last row is never a lone card
const relatedCols = others.length % 2 === 0 ? 2 : 3;
---

<Layout title={title} description={description}>
	<TopBar active='templates' />

	<main id='main-content'>
		<section class='detail-hero'>
			<div class='hero-main'>
				<a href={localePath(locale, '/templates')} class='back'>← {t.templates.detail.back}</a>
				<p class='eyebrow accent'>{meta}</p>
				<h1>{tpl.name} <span class='hl'>{tpl.accent}</span></h1>
				<p class='lead'>{description}</p>
				<p class='price'>
					<span class='from'>{t.common.from}</span>
					<strong>{formatBRL(tpl.priceFrom)}</strong>
				</p>
				<div class='actions'>
					<a href={wantHref} class='btn btn-primary shine'>{t.templates.detail.want}</a>
					<a href={demo} class='btn btn-ghost shine' target='_blank' rel='noopener'>
						{t.templates.detail.fullDemo} <span class='arrow' aria-hidden='true'>↗</span>
						<span class='sr-only'>({t.common.openInNewTab})</span>
					</a>
				</div>
			</div>
			{
				scores && (
					<div class='scores' role='group' aria-labelledby='scores-title'>
						<p class='scores-title' id='scores-title'>
							{sc.title}
						</p>
						<ul class='gauges' role='list'>
							{gauges.map((g, i) => (
								<li style={`--gauge-delay:${(0.25 + i * 0.12).toFixed(2)}s`}>
									<ScoreGauge score={g.score} size={68} draw />
									<span class='g-label'>
										{g.label}
										<span class='sr-only'>
											: {g.score} {sc.outOf}
										</span>
									</span>
								</li>
							))}
						</ul>
						<p class='scores-note'>{scoresNote}</p>
					</div>
				)
			}
		</section>

		<section class='demo' data-device='desktop'>
			<div class='device-row'>
				<div class='seg' role='group' aria-label={device.label} data-device-toggle>
					<span class='seg-knob' aria-hidden='true'></span>
					<button type='button' data-device='desktop' aria-pressed='true'>{device.desktop}</button>
					<button type='button' data-device='mobile' aria-pressed='false'>{device.mobile}</button>
				</div>
			</div>
			<div class='stage'>
				{/* Only the active device loads its demo: src lives in data-src until first activation. */}
				<div class='browser' data-frame='desktop'>
					<div class='chrome' aria-hidden='true'>
						<span class='dots'><i></i><i></i><i></i></span>
						<span class='url'>{demoUrlLabel}</span>
					</div>
					<iframe data-src={demo} title={demoTitle} loading='lazy'></iframe>
					<noscript>
						<iframe src={demo} title={demoTitle} loading='lazy'></iframe>
					</noscript>
				</div>
				<div class='phone-stage' data-frame='mobile'>
					<PhoneFrame src={demo} title={demoTitle} />
				</div>
			</div>
			<p class='demo-note'>{t.templates.detail.demoNote}</p>
		</section>

		<section class='section info'>
			<div class='info-grid'>
				<div class='col reveal'>
					<h2>{t.templates.detail.sectionsTitle}</h2>
					<ol class='sections'>
						{sections.map((s) => <li>{s}</li>)}
					</ol>
				</div>
				<div class='col reveal d1'>
					<h2>{t.templates.included.title}</h2>
					<ul class='included'>
						{included.map((s) => <li>{s}</li>)}
					</ul>
				</div>
				<div class='col reveal d2'>
					<h2>{t.templates.steps.title}</h2>
					<ol class='steps'>
						{
							steps.map((s, i) => (
								<li>
									<span class='num' aria-hidden='true'>{String(i + 1).padStart(2, '0')}</span>
									<div>
										<h3>{s.title}</h3>
										<p>{s.desc}</p>
									</div>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>

		<section class='section related' aria-labelledby='related-title'>
			<div class='sec-head reveal'>
				<h2 id='related-title'>{t.templates.detail.related}</h2>
			</div>
			<ul class='related-grid' role='list' style={`--cols:${relatedCols}`}>
				{
					others.map((o, i) => (
						<li class:list={['reveal', i > 0 && `d${Math.min(i, 3)}`]}>
							<TemplateCard tpl={o} locale={locale} heading='h3' />
						</li>
					))
				}
			</ul>
		</section>

		<section class='cta-band'>
			<h2>{t.templates.cta.head} <span class='hl'>{t.templates.cta.headAccent}</span></h2>
			<p class='sub'>{t.templates.cta.sub}</p>
			<div class='actions'>
				<a href={wantHref} class='btn btn-primary'>{t.templates.detail.want}</a>
				{
					wa && (
						<a href={wa} class='btn btn-whatsapp' target='_blank' rel='noopener'>
							{t.common.ctaWhatsapp}
						</a>
					)
				}
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script>
	/**
	 * Desktop / phone switch. The demo iframe src lives in data-src and is set
	 * the first time a device is shown, so only one demo loads. Under 780px the
	 * phone is the default.
	 */
	document.querySelectorAll<HTMLElement>('.demo[data-device]').forEach((demo) => {
		const toggle = demo.querySelector<HTMLElement>('[data-device-toggle]');
		const frames = Array.from(demo.querySelectorAll<HTMLElement>('[data-frame]'));
		const set = (dev: string) => {
			demo.dataset.device = dev;
			toggle?.querySelectorAll<HTMLButtonElement>('[data-device]').forEach((b) => {
				b.setAttribute('aria-pressed', String(b.dataset.device === dev));
			});
			const frame = frames.find((f) => f.dataset.frame === dev);
			const iframe = frame?.querySelector<HTMLIFrameElement>('iframe[data-src]');
			if (iframe && !iframe.getAttribute('src')) iframe.src = iframe.dataset.src ?? '';
		};
		toggle?.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-device]');
			if (btn?.dataset.device) set(btn.dataset.device);
		});
		set(window.matchMedia('(max-width: 780px)').matches ? 'mobile' : 'desktop');
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Hero */
	.detail-hero {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 48px 32px 40px;
	}
	.back {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
		transition: color 0.2s;
	}
	.back:hover {
		color: var(--ink);
	}
	.detail-hero .eyebrow {
		display: block;
		margin: 20px 0 16px;
	}
	.detail-hero h1 {
		font-size: var(--fs-h1);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.98;
		max-width: 14ch;
		text-wrap: balance;
	}
	.detail-hero .lead {
		margin-top: 24px;
		max-width: 60ch;
		font-size: var(--fs-lead);
		line-height: 1.5;
		color: var(--ink-2);
	}
	.price {
		margin-top: 28px;
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	.price .from {
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.price strong {
		font-size: 28px;
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.detail-hero .actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 28px;
	}

	/* Lighthouse panel: beside the copy from 1000px, under the CTAs below that */
	.detail-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 40px 56px;
	}
	.scores {
		align-self: end;
		width: 100%;
		max-width: 480px;
		padding: 22px 24px 18px;
		border: 1px solid var(--rule-2);
		border-radius: 18px;
		background: var(--bg-3);
	}
	.scores-title {
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.gauges {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		margin-top: 18px;
	}
	.gauges li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		text-align: center;
	}
	.g-label {
		font-size: 12px;
		line-height: 1.3;
		color: var(--ink-2);
		text-wrap: balance;
	}
	.scores-note {
		margin-top: 16px;
		padding-top: 12px;
		border-top: 1px solid var(--rule);
		font-size: 12px;
		line-height: 1.5;
		color: var(--ink-3);
	}
	@media (min-width: 1000px) {
		.detail-hero {
			grid-template-columns: minmax(0, 1fr) minmax(400px, 460px);
		}
	}
	@media (max-width: 460px) {
		.scores {
			padding: 20px 18px 16px;
		}
		.gauges {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 20px 12px;
		}
	}
	/* Shine sweep across the CTAs on hover */
	.shine {
		position: relative;
		overflow: hidden;
	}
	.shine::after {
		content: '';
		position: absolute;
		top: -20%;
		left: -60%;
		width: 45%;
		height: 140%;
		background: linear-gradient(115deg, transparent 0%, rgba(255, 255, 255, 0.55) 50%, transparent 100%);
		transform: skewX(-20deg);
		opacity: 0;
		pointer-events: none;
	}
	.shine.btn-ghost::after {
		background: linear-gradient(115deg, transparent 0%, rgba(255, 89, 100, 0.28) 50%, transparent 100%);
	}
	.shine:hover::after {
		animation: shine 0.9s var(--ease-out-expo) forwards;
	}
	@keyframes shine {
		0% {
			left: -60%;
			opacity: 1;
		}
		100% {
			left: 130%;
			opacity: 0;
		}
	}
	.btn .arrow {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-expo);
	}
	.btn:hover .arrow {
		transform: translate(2px, -2px);
	}

	/* Demo: device toggle + browser frame (subtle 3D tilt on hover) or phone */
	.demo {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 32px;
	}
	.device-row {
		display: flex;
		justify-content: center;
		margin-bottom: 20px;
	}
	/* Segmented control: the knob slides on transform */
	.seg {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 4px;
		border: 1px solid var(--rule-2);
		border-radius: 999px;
		background: var(--bg-2);
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.seg-knob {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc(50% - 4px);
		border-radius: 999px;
		background: var(--bg-3);
		box-shadow:
			0 1px 2px rgba(26, 26, 28, 0.12),
			0 6px 16px -8px rgba(26, 26, 28, 0.3);
		transition: transform 0.4s var(--ease-out-expo);
	}
	.demo[data-device='mobile'] .seg-knob {
		transform: translateX(100%);
	}
	.seg button {
		position: relative;
		z-index: 1;
		min-height: 44px;
		min-width: 120px;
		padding: 0 18px;
		border-radius: 999px;
		color: var(--ink-3);
		white-space: nowrap;
		transition: color 0.25s;
	}
	.seg button[aria-pressed='true'],
	.seg button:hover {
		color: var(--ink);
	}
	.stage {
		perspective: 1200px;
		/* desktop frame a touch narrower than the page so it doesn't dominate large screens */
		max-width: 1040px;
		margin: 0 auto;
	}
	/* only the active device is in the layout */
	.demo[data-device='mobile'] [data-frame='desktop'],
	.demo[data-device='desktop'] [data-frame='mobile'] {
		display: none;
	}
	.phone-stage {
		padding: 12px 8px 24px;
	}
	.browser {
		border: 1px solid var(--rule-2);
		border-radius: 18px;
		overflow: hidden;
		background: var(--bg-3);
		box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.25);
		transform-origin: 50% 100%;
		transition:
			transform 0.7s var(--ease-out-expo),
			box-shadow 0.7s var(--ease-out-expo),
			border-color 0.4s;
	}
	.browser:hover {
		transform: rotateX(2deg) translateY(-4px);
		border-color: rgba(255, 89, 100, 0.35);
		box-shadow:
			0 60px 100px -40px rgba(0, 0, 0, 0.32),
			0 24px 48px -32px rgba(255, 89, 100, 0.25);
	}
	@media (hover: none) {
		.browser:hover {
			transform: none;
		}
	}
	.chrome {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 10px 16px;
		background: var(--bg-2);
		border-bottom: 1px solid var(--rule);
	}
	.dots {
		display: flex;
		gap: 6px;
	}
	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--ink-4);
	}
	.url {
		flex: 1;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
		background: var(--bg-3);
		border-radius: 8px;
		padding: 6px 12px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.browser iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		border: 0;
		background: #fff;
	}
	.demo-note {
		margin-top: 14px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
		text-align: center;
	}

	/* Info columns */
	.info {
		padding-top: 100px;
		padding-bottom: 20px;
	}
	.info-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 48px;
		padding-top: 64px;
		border-top: 1px solid var(--rule);
	}
	.col h2 {
		font-size: 24px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 24px;
	}
	.sections,
	.included,
	.steps {
		list-style: none;
	}
	.sections li {
		display: flex;
		gap: 12px;
		padding: 12px 0;
		border-top: 1px solid var(--rule);
		font-size: 15px;
		color: var(--ink-2);
		counter-increment: sec;
	}
	.sections li::before {
		content: counter(sec, decimal-leading-zero);
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--accent-text);
		padding-top: 3px;
		min-width: 24px;
	}
	.included li {
		position: relative;
		padding: 12px 0 12px 32px;
		border-top: 1px solid var(--rule);
		font-size: 15px;
		color: var(--ink-2);
		line-height: 1.5;
	}
	.included li::before {
		content: '✓';
		position: absolute;
		left: 0;
		top: 12px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 700;
	}
	.steps li {
		display: grid;
		grid-template-columns: 32px 1fr;
		gap: 12px;
		padding: 14px 0;
		border-top: 1px solid var(--rule);
	}
	.steps .num {
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--accent-text);
		padding-top: 4px;
	}
	.steps h3 {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 4px;
	}
	.steps p {
		font-size: 14px;
		color: var(--ink-2);
		line-height: 1.55;
	}

	/* Other templates */
	.related {
		padding-top: 80px;
		padding-bottom: 20px;
	}
	.related .sec-head {
		margin-bottom: 36px;
	}
	.related-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
		gap: 24px;
	}
	.related-grid li {
		display: flex;
	}
	.related-grid li > :global(.tpl-card) {
		width: 100%;
	}

	@media (max-width: 1000px) {
		.info-grid {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 780px) {
		.browser iframe {
			aspect-ratio: auto;
			height: min(72vh, 640px);
		}
	}
	@media (max-width: 640px) {
		.related-grid {
			grid-template-columns: 1fr;
			max-width: 560px;
		}
	}
	@media (max-width: 600px) {
		.detail-hero,
		.demo,
		.info,
		.related {
			padding-left: 20px;
			padding-right: 20px;
		}
		.detail-hero {
			padding-top: 24px;
		}
		.info {
			padding-top: 72px;
		}
		.price strong {
			font-size: 24px;
		}
	}
</style>
