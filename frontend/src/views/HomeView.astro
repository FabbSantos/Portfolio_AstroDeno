---
/**
 * Home page (rendered by /  and /en). Locale comes from the URL — never
 * hardcode it here. Sections in sales order: hero → proof → services →
 * work → templates → process → testimonials → about → contact.
 */
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/site/TopBar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import Hero from '../components/home/Hero.astro';
import ProofBand from '../components/home/ProofBand.astro';
import Services from '../components/home/Services.astro';
import WorksList from '../components/home/WorksList.astro';
import Templates from '../components/home/Templates.astro';
import Process from '../components/home/Process.astro';
import Testimonials from '../components/home/Testimonials.astro';
import AboutShort from '../components/home/AboutShort.astro';
import Contact from '../components/home/Contact.astro';
import { localeOf, useT } from '../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
---

<Layout title={t.meta.home.title} description={t.meta.home.description}>
	<TopBar />
	<main id='main-content'>
		<Hero />
		<ProofBand />
		<Services />
		<WorksList />
		<Templates />
		<Process />
		<Testimonials />
		<AboutShort />
		<Contact />
	</main>
	<SiteFooter />
</Layout>
