---
/**
 * /orcamento-enviado (and /en/orcamento-enviado): where the "Pedir orçamento"
 * form sends people after a successful submit. Confirms the request and the
 * reply time, with a WhatsApp button and a way back home. noindex, and kept
 * out of the sitemap in astro.config. Its page view doubles as the "lead sent"
 * goal in the analytics.
 */
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/site/TopBar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { SITE, whatsappUrl } from '../data/site';
import { fmt, localeOf, localePath, pick, useT } from '../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
const s = t.contact.sentPage;
const wa = whatsappUrl(locale);
---

<Layout title={s.title} description={s.description} noindex>
	<!-- Google Ads conversion "Pedido de orçamento" + Umami "orcamento_enviado": only after a real send (flag set by the
	     contact form), once (the flag is cleared, so a reload doesn't count again). -->
	<script is:inline>
		try {
			if (sessionStorage.getItem('fab-lead-sent') === '1') {
				sessionStorage.removeItem('fab-lead-sent');
				if (typeof window.gtag === 'function') window.gtag('event', 'conversion', { send_to: 'AW-18535408880/leZJCJjztKodEPDJr4ZF' });
				// Same moment in Umami, to check the Ads count and see leads from organic and AI search.
				// Queued until Umami loads (components/site/UmamiLoader flushes window.__umq).
				const ev = ['orcamento_enviado', { locale: document.documentElement.lang }];
				if (window.umami) window.umami.track(ev[0], ev[1]);
				else (window.__umq = window.__umq || []).push(ev);
			}
		} catch {
			/* storage blocked: nothing to do */
		}
	</script>
	<TopBar />

	<main id='main-content'>
		<section class='page-hero sent'>
			<h1>{s.heading}</h1>
			<p class='lead'>{fmt(s.body, { time: pick(SITE.responseTime, locale) })}</p>
			<div class='actions'>
				{
					wa && (
						<a href={wa} class='btn btn-whatsapp' target='_blank' rel='noopener'>
							{t.common.ctaWhatsapp}
						</a>
					)
				}
				<a href={localePath(locale, '/')} class='btn btn-ghost'>
					{s.home}
				</a>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
	.sent {
		padding-top: clamp(80px, 12vw, 140px);
		padding-bottom: clamp(96px, 14vw, 160px);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 32px;
	}
	@media (max-width: 540px) {
		.actions .btn {
			width: 100%;
		}
	}
</style>
