---
/**
 * /about · /en/about — the recruiter/CTO page. Honest, specific, chronological.
 * Rendered by src/pages/about.astro and src/pages/en/about.astro.
 */
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/site/TopBar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { SITE, whatsappUrl } from '../data/site';
import { fmt, localeOf, localePath, pick, useT } from '../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
const a = t.about;

const stats = [
	{ v: SITE.stats.years, l: a.stats.years },
	{ v: SITE.stats.products, l: a.stats.products },
	{ v: SITE.stats.clients, l: a.stats.clients },
	{ v: pick(SITE.responseTime, locale), l: a.stats.response, text: true },
];

/** The timeline is chronological; the last row is the current position. */
const currentRow = a.career.rows.length - 1;

const contactHref = localePath(locale, '/#contato');
const wa = whatsappUrl(locale);
---

<Layout title={t.meta.about.title} description={t.meta.about.description}>
	<TopBar active='about' />
	<main id='main-content'>
		<!-- Hero -->
		<section class='page-hero'>
			<p class='eyebrow accent'>
				<span class='dot' aria-hidden='true'></span>
				{a.hero.eyebrow}
			</p>
			<h1>{a.hero.head1} <span class='hl'>{a.hero.head2}</span></h1>
			<p class='role'>
				{pick(SITE.role, locale)}
				<span class='pipe' aria-hidden='true'>·</span>
				{fmt(a.hero.since, { year: SITE.since })}
			</p>
			<p class='lead'>{a.hero.lead}</p>
		</section>

		<!-- Stats strip -->
		<ul class='stats'>
			{
				stats.map((s) => (
					<li class:list={['stat', { text: s.text }]}>
						<span class='v'>{s.v}</span>
						<span class='l'>{s.l}</span>
					</li>
				))
			}
		</ul>

		<!-- Story -->
		<section class='story'>
			<blockquote class='story-quote reveal'>
				<p>{a.story.quote}</p>
				<footer class='by'>{a.story.by}</footer>
			</blockquote>
			<p class='lead-p reveal'>{a.story.p1}</p>
			<p class='reveal'>{a.story.p2}</p>
			<p class='reveal'>{a.story.p3}</p>
			<p class='human reveal'>{a.story.human}</p>
		</section>

		<!-- Career timeline -->
		<section class='section career'>
			<div class='sec-head reveal'>
				<span class='eyebrow accent'>{a.career.eyebrow}</span>
				<h2>{a.career.head1} <span class='hl'>{a.career.head2}</span></h2>
				<p>{a.career.lead}</p>
			</div>
			<ol class='career-rows'>
				{
					a.career.rows.map((c, i) => {
						const now = i === currentRow;
						return (
							<li class:list={['career-row', 'reveal', `d${Math.min(i + 1, 3)}`, { now }]} aria-current={now ? 'true' : undefined}>
								<span class='yr'>
									{c.period}
									{now && <span class='now-tag'>{a.career.current}</span>}
								</span>
								<h3 class='role'>{c.role}</h3>
								<p class='desc'>{c.desc}</p>
								<ul class='tags' aria-label='Stack'>
									{c.tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</li>
						);
					})
				}
			</ol>
		</section>

		<!-- How I work -->
		<section class='how-band'>
			<div class='how-inner'>
				<div class='sec-head reveal'>
					<span class='eyebrow accent'>{a.how.eyebrow}</span>
					<h2>{a.how.head1} <span class='hl'>{a.how.head2}</span></h2>
					<p>{a.how.lead}</p>
				</div>

				<div class='principles'>
					{
						a.how.principles.map((p, i) => (
							<article class:list={['principle', 'reveal', `d${Math.min(i + 1, 3)}`]}>
								<span class='num' aria-hidden='true'>{String(i + 1).padStart(2, '0')}</span>
								<h3>{p.title}</h3>
								<p>{p.desc}</p>
							</article>
						))
					}
				</div>

				{/* Availability — no .reveal: this is the block a buyer scans for. */}
				<div class='availability'>
					<span class='eyebrow accent'>{a.how.availabilityLabel}</span>
					<p class='avail-line'>
						<span class='dot' aria-hidden='true'></span>
						{pick(SITE.availability, locale)}
					</p>
					{/* TODO(fab): confirmar formato/horas dado o vínculo com a NTT Data antes de publicar. */}
					<p class='avail-format'>{a.how.format}</p>
				</div>

				<p class='stack-line'>
					<span class='stack-label'>{a.stack.label}</span>
					<span class='stack-items'>{a.stack.line}</span>
				</p>
			</div>
		</section>

		<!-- CTA -->
		<section class='cta-band'>
			<h2>{a.cta.head1} <span class='hl'>{a.cta.head2}</span></h2>
			<p class='sub'>{a.cta.sub}</p>
			<div class='actions'>
				<a href={contactHref} class='btn btn-primary'>{t.common.ctaContact}</a>
				{
					wa && (
						<a href={wa} class='btn btn-whatsapp' target='_blank' rel='noopener'>
							{t.common.ctaWhatsapp}
						</a>
					)
				}
			</div>
		</section>
	</main>
	<SiteFooter />
</Layout>

<style>
	/* Hero extras (base .page-hero comes from site.css) */
	.page-hero .role {
		margin-top: 22px;
		font-family: var(--mono);
		font-size: clamp(13px, 1.4vw, 15px);
		color: var(--ink-2);
	}
	.page-hero .role .pipe {
		color: var(--ink-4);
		margin: 0 10px;
	}

	/* Stats strip */
	.stats {
		list-style: none;
		max-width: var(--maxw);
		margin: 64px auto 0;
		padding: 40px 32px;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.stat .v {
		font-size: clamp(36px, 4vw, 48px);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1;
	}
	.stat.text .v {
		font-size: clamp(22px, 2.4vw, 30px);
		letter-spacing: -0.02em;
		line-height: 1.1;
		/* keeps the baseline aligned with the numeric tiles */
		min-height: 1em;
		display: flex;
		align-items: flex-end;
		flex: 1;
	}
	.stat .l {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
		letter-spacing: 0.02em;
	}

	/* Story */
	.story {
		padding: 80px 32px 0;
		max-width: 880px;
		margin: 0 auto;
	}
	.story-quote {
		margin-bottom: 48px;
	}
	.story-quote::before {
		content: '\201C';
		color: var(--accent);
		font-size: clamp(40px, 5vw, 60px);
		font-weight: 800;
		display: block;
		line-height: 0.6;
		margin-bottom: 10px;
	}
	.story-quote p {
		font-size: var(--fs-h3);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-wrap: balance;
	}
	.story-quote .by {
		margin-top: 14px;
		font-family: var(--mono);
		font-size: 13px;
		font-weight: 500;
		color: var(--ink-3);
	}
	.story > p {
		font-size: 19px;
		line-height: 1.7;
		color: var(--ink-2);
		margin-bottom: 20px;
	}
	.story .lead-p::first-letter {
		font-size: 64px;
		font-weight: 800;
		line-height: 0.8;
		float: left;
		padding: 6px 14px 0 0;
		color: var(--accent);
	}
	.story .human {
		color: var(--ink);
		font-weight: 500;
		border-left: 3px solid var(--accent);
		padding-left: 18px;
	}

	/* Career timeline */
	.career-rows {
		list-style: none;
		border-top: 1px solid var(--rule);
	}
	.career-row {
		display: grid;
		grid-template-columns: 170px 1fr 1.4fr auto;
		gap: 32px;
		padding: 26px 0;
		border-bottom: 1px solid var(--rule);
		align-items: center;
		transition:
			padding-left 0.4s cubic-bezier(0.7, 0, 0.3, 1),
			background 0.25s;
	}
	.career-row:hover {
		padding-left: 16px;
		background: var(--bg-2);
	}
	.career-row .yr {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
	}
	.career-row.now .yr {
		color: var(--accent-text);
		font-weight: 600;
	}
	.now-tag {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent-text);
	}
	.career-row .role {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.15;
	}
	.career-row .desc {
		font-size: 14px;
		color: var(--ink-2);
		line-height: 1.55;
	}
	.career-row .tags {
		list-style: none;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
		text-align: right;
		line-height: 1.7;
	}

	/* How I work */
	.how-band {
		background: var(--bg-2);
		padding: 120px 32px;
		margin-top: 40px;
	}
	.how-inner {
		max-width: var(--maxw);
		margin: 0 auto;
	}
	.principles {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}
	.principle {
		background: var(--bg-3);
		border: 1px solid var(--rule);
		border-radius: 18px;
		padding: 28px;
		transition:
			transform 0.35s,
			box-shadow 0.35s;
	}
	.principle:hover {
		transform: translateY(-4px);
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.12);
	}
	.principle .num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-family: var(--mono);
		font-weight: 700;
		font-size: 13px;
		margin-bottom: 18px;
	}
	.principle h3 {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}
	.principle p {
		font-size: 15px;
		color: var(--ink-2);
		line-height: 1.55;
	}

	.availability {
		margin-top: 56px;
		padding: 28px 32px;
		background: var(--bg-3);
		border: 1px solid var(--rule);
		border-radius: 18px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.avail-line {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.avail-line .dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #16a34a;
		flex: none;
	}
	.avail-format {
		font-size: 15px;
		color: var(--ink-2);
		line-height: 1.5;
	}

	.stack-line {
		margin-top: 28px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		align-items: baseline;
		font-family: var(--mono);
		font-size: 13px;
		line-height: 1.7;
	}
	.stack-label {
		font-weight: 600;
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.stack-items {
		color: var(--ink-2);
	}

	@media (max-width: 1100px) {
		.principles {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 900px) {
		.career-row {
			grid-template-columns: 1fr;
			gap: 8px;
			padding: 22px 0;
		}
		.career-row .tags {
			text-align: left;
			display: flex;
			flex-wrap: wrap;
			gap: 4px 12px;
		}
	}
	@media (max-width: 780px) {
		.stats {
			grid-template-columns: 1fr 1fr;
			padding: 32px 20px;
			margin-top: 48px;
		}
		.story {
			padding: 64px 20px 0;
		}
		.section.career {
			padding: 80px 20px;
		}
		.how-band {
			padding: 80px 20px;
		}
		.availability {
			padding: 24px 20px;
		}
	}
	@media (max-width: 560px) {
		.principles {
			grid-template-columns: 1fr;
		}
	}
</style>
