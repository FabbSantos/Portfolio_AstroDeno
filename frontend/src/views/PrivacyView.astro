---
/**
 * /privacidade (pt) and /en/privacy (en) — plain-language LGPD notice.
 * All prose lives in t.privacy (readonly string arrays per section).
 */
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/site/TopBar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { SITE } from '../data/site';
import { localeOf, useT } from '../i18n';

const locale = localeOf(Astro);
const t = useT(locale);
const p = t.privacy;
const umamiOn = Boolean(import.meta.env.PUBLIC_UMAMI_WEBSITE_ID);
---

<Layout title={t.meta.privacy.title} description={t.meta.privacy.description}>
	<TopBar />
	<main id='main-content'>
		<header class='page-hero'>
			<span class='eyebrow accent'><span class='dot'></span>{p.eyebrow}</span>
			<h1>{p.title}</h1>
			<p class='lead'>{p.lead}</p>
			<p class='updated'>{p.updated}</p>
		</header>

		<article class='policy'>
			{p.sections.map((s) => (
				<section>
					<h2>{s.h}</h2>
					{s.p.map((par) => <p>{par}</p>)}
					{s.id === 'processors' && umamiOn && <p>{p.umami}</p>}
				</section>
			))}
			<p class='contact-line'>
				{p.contactLabel} <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
			</p>
		</article>
	</main>
	<SiteFooter />
</Layout>

<style>
	.updated {
		margin-top: 18px;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.policy {
		max-width: 680px;
		margin: 0 auto;
		padding: 32px 32px 120px;
	}
	.policy section {
		padding: 28px 0;
		border-top: 1px solid var(--rule);
	}
	.policy h2 {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 12px;
	}
	.policy p {
		color: var(--ink-2);
		line-height: 1.6;
	}
	.policy p + p {
		margin-top: 12px;
	}
	.contact-line {
		padding-top: 28px;
		border-top: 1px solid var(--rule);
	}
	.contact-line a {
		font-family: var(--mono);
		font-weight: 600;
		color: var(--accent-text);
	}
	.contact-line a:hover {
		text-decoration: underline;
	}
	@media (max-width: 600px) {
		.policy {
			padding: 24px 24px 96px;
		}
	}
</style>
