---
/**
 * /templates (and /en/templates) — the gallery.
 * Hero → compare strip ("qual é o meu?") → grid of cards (each links to its
 * sales page) → how it works + what's included → CTA band.
 */
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/site/TopBar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import TemplateCard from '../components/templates/TemplateCard.astro';
import { hueVars } from '../components/templates/hues';
import { SITE, whatsappUrl } from '../data/site';
import { formatBRL, templates } from '../data/templates';
import { fmt, localeOf, localePath, pick, useT } from '../i18n';

const locale = localeOf(Astro);
const t = useT(locale);

const months = SITE.promises.adjustmentsMonths;
const n = templates.length;
const nWord = t.templates.numberWords[n] ?? String(n);
const NWord = nWord.charAt(0).toUpperCase() + nWord.slice(1);

const lead = fmt(t.templates.gallery.lead, { N: NWord, n: nWord, months });
const included = t.templates.included.items.map((s) => fmt(s, { months }));
const steps = t.templates.steps.items.map((s) => ({ title: s.title, desc: fmt(s.desc, { months }) }));

// Compare strip rows — everything comes from data/templates.ts + templates.solves.
const solves = t.templates.solves as Record<string, string | undefined>;
const cmp = t.templates.compare;
const cols = templates.map((tpl) => ({
	tpl,
	href: localePath(locale, `/templates/${tpl.slug}`),
	style: hueVars(tpl.kind),
	who: solves[tpl.slug] ?? pick(tpl.desc, locale),
	sections: pick(tpl.sections, locale).length,
}));

// TODO(fab): the contact form should read `?assunto=template` and preselect the subject.
const wantHref = localePath(locale, '/?assunto=template#contato');
const wa = whatsappUrl(locale, t.templates.cta.whatsappGallery);
---

<Layout title={t.meta.templates.title} description={t.meta.templates.description}>
	<TopBar active='templates' />

	<main id='main-content'>
		<section class='page-hero'>
			<p class='eyebrow accent'><span class='dot'></span>{t.templates.gallery.eyebrow}</p>
			<h1>{t.templates.gallery.head} <span class='hl'>{t.templates.gallery.headAccent}</span></h1>
			<p class='lead'>{lead}</p>
		</section>

		<section class='compare reveal' aria-labelledby='compare-title'>
			<div class='cmp-head'>
				<p class='eyebrow accent'>{cmp.eyebrow}</p>
				<h2 id='compare-title'>{cmp.title}</h2>
				<p class='cmp-sub'>{cmp.sub}</p>
			</div>
			<div class='cmp-scroll'>
				<table class='cmp'>
					<thead>
						<tr>
							<th scope='col' class='lbl'><span class='sr-only'>{cmp.criterion}</span></th>
							{
								cols.map((c) => (
									<th scope='col' style={c.style}>
										<a href={c.href}>
											<i class='dot' aria-hidden='true' />
											{c.tpl.name} <span class='hl'>{c.tpl.accent}</span>
										</a>
									</th>
								))
							}
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope='row'>{cmp.rows.who}</th>
							{cols.map((c) => <td style={c.style}>{c.who}</td>)}
						</tr>
						<tr>
							<th scope='row'>{cmp.rows.days}</th>
							{
								cols.map((c) => (
									<td style={c.style}>
										<strong>{c.tpl.days}</strong> {t.common.businessDays}
									</td>
								))
							}
						</tr>
						<tr>
							<th scope='row'>{cmp.rows.price}</th>
							{
								cols.map((c) => (
									<td style={c.style}>
										<strong>{formatBRL(c.tpl.priceFrom)}</strong>
									</td>
								))
							}
						</tr>
						<tr>
							<th scope='row'>{cmp.rows.sections}</th>
							{
								cols.map((c) => (
									<td style={c.style}>
										<strong>{c.sections}</strong>
									</td>
								))
							}
						</tr>
						<tr class='go'>
							<th scope='row'><span class='sr-only'>{t.templates.card.open}</span></th>
							{
								cols.map((c) => (
									<td style={c.style}>
										<a class='cmp-go' href={c.href}>
											{t.templates.card.open}
										</a>
									</td>
								))
							}
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class='gallery' aria-label={t.templates.gallery.listLabel}>
			<ul class='grid' role='list'>
				{
					templates.map((tpl, i) => (
						<li class:list={['reveal', i > 0 && `d${Math.min(i, 3)}`]}>
							<TemplateCard tpl={tpl} locale={locale} heading='h2' />
						</li>
					))
				}
			</ul>
		</section>

		<section class='section how'>
			<div class='how-grid'>
				<div class='col reveal'>
					<h2>{t.templates.steps.title}</h2>
					<ol class='steps'>
						{
							steps.map((s, i) => (
								<li>
									<span class='num' aria-hidden='true'>{String(i + 1).padStart(2, '0')}</span>
									<div>
										<h3>{s.title}</h3>
										<p>{s.desc}</p>
									</div>
								</li>
							))
						}
					</ol>
				</div>
				<div class='col reveal d1'>
					<h2>{t.templates.included.title}</h2>
					<ul class='included'>
						{included.map((s) => <li>{s}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<section class='cta-band'>
			<h2>{t.templates.cta.head} <span class='hl'>{t.templates.cta.headAccent}</span></h2>
			<p class='sub'>{t.templates.cta.sub}</p>
			<div class='actions'>
				<a href={wantHref} class='btn btn-primary'>{t.templates.cta.button}</a>
				{
					wa && (
						<a href={wa} class='btn btn-whatsapp' target='_blank' rel='noopener'>
							{t.common.ctaWhatsapp}
						</a>
					)
				}
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script>
	// Compare strip: highlight the whole column under the pointer (CSS can't select a column).
	document.querySelectorAll<HTMLTableElement>('table.cmp').forEach((table) => {
		const set = (i: number | null) => {
			if (i == null) delete table.dataset.hot;
			else table.dataset.hot = String(i);
		};
		table.addEventListener('pointerover', (e) => {
			const cell = (e.target as HTMLElement).closest<HTMLTableCellElement>('td, th');
			set(cell && cell.cellIndex > 0 ? cell.cellIndex : null);
		});
		table.addEventListener('pointerleave', () => set(null));
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* ---- Compare strip ---- */
	.compare {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 16px 32px 0;
	}
	.cmp-head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 6px 18px;
		margin-bottom: 18px;
	}
	.cmp-head .eyebrow {
		flex-basis: 100%;
	}
	.cmp-head h2 {
		font-size: 24px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.cmp-sub {
		font-size: 15px;
		color: var(--ink-3);
	}
	.cmp-scroll {
		overflow-x: auto;
		border: 1px solid var(--rule);
		border-radius: 16px;
		background: var(--bg-3);
		scrollbar-width: thin;
	}
	.cmp {
		width: 100%;
		min-width: 760px;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 14px;
		line-height: 1.4;
	}
	.cmp th,
	.cmp td {
		text-align: left;
		vertical-align: top;
		padding: 12px 16px;
		border-bottom: 1px solid var(--rule);
		transition:
			background 0.25s,
			color 0.25s;
	}
	.cmp tr:last-child th,
	.cmp tr:last-child td {
		border-bottom: 0;
	}
	/* first column: mono criteria, sticky when the strip scrolls */
	.cmp th[scope='row'],
	.cmp th.lbl {
		position: sticky;
		left: 0;
		z-index: 1;
		width: 132px;
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
		background: var(--bg-3);
		padding-top: 15px;
		white-space: nowrap;
	}
	/* header: template names with their hue dot */
	.cmp thead th {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: var(--bg-2);
		border-bottom-color: var(--rule-2);
	}
	.cmp thead th.lbl {
		background: var(--bg-2);
	}
	.cmp thead th a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border-radius: 6px;
	}
	.cmp thead th a .hl {
		color: var(--accent-text);
	}
	.cmp thead th .dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--hue);
		box-shadow: 0 0 0 0 var(--hue-soft);
		transition: box-shadow 0.35s var(--ease-out-expo);
	}
	.cmp td {
		color: var(--ink-2);
	}
	.cmp td strong {
		color: var(--ink);
		font-weight: 700;
	}
	.cmp .go td {
		padding-top: 10px;
		padding-bottom: 14px;
	}
	.cmp-go {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 600;
		color: var(--accent-text);
		border-radius: 6px;
	}
	.cmp-go::after {
		content: '→';
		display: inline-block;
		transition: transform 0.3s var(--ease-out-expo);
	}
	.cmp-go:hover::after {
		transform: translateX(5px);
	}
	/* column highlight (JS sets data-hot = cellIndex); a plain cell hover as fallback */
	.cmp td:hover {
		background: var(--bg-2);
	}
	.cmp[data-hot='1'] :is(th, td):nth-child(2),
	.cmp[data-hot='2'] :is(th, td):nth-child(3),
	.cmp[data-hot='3'] :is(th, td):nth-child(4),
	.cmp[data-hot='4'] :is(th, td):nth-child(5),
	.cmp[data-hot='5'] :is(th, td):nth-child(6),
	.cmp[data-hot='6'] :is(th, td):nth-child(7) {
		background: var(--hue-soft);
	}
	.cmp[data-hot='1'] thead th:nth-child(2),
	.cmp[data-hot='2'] thead th:nth-child(3),
	.cmp[data-hot='3'] thead th:nth-child(4),
	.cmp[data-hot='4'] thead th:nth-child(5),
	.cmp[data-hot='5'] thead th:nth-child(6),
	.cmp[data-hot='6'] thead th:nth-child(7) {
		color: var(--hue-text);
	}
	.cmp[data-hot='1'] thead th:nth-child(2) .dot,
	.cmp[data-hot='2'] thead th:nth-child(3) .dot,
	.cmp[data-hot='3'] thead th:nth-child(4) .dot,
	.cmp[data-hot='4'] thead th:nth-child(5) .dot,
	.cmp[data-hot='5'] thead th:nth-child(6) .dot,
	.cmp[data-hot='6'] thead th:nth-child(7) .dot {
		box-shadow: 0 0 0 4px var(--hue-soft);
	}

	/* ---- Gallery grid ---- */
	.gallery {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 56px 32px 0;
	}
	.grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px;
	}
	.grid li {
		display: flex;
	}
	.grid li > :global(.tpl-card) {
		width: 100%;
	}

	/* How it works + what's included */
	.how {
		padding-top: 100px;
		padding-bottom: 40px;
	}
	.how-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 64px;
		padding-top: 64px;
		border-top: 1px solid var(--rule);
	}
	.col h2 {
		font-size: var(--fs-h3);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
		margin-bottom: 32px;
	}
	.steps,
	.included {
		list-style: none;
	}
	.steps li {
		display: grid;
		grid-template-columns: 40px 1fr;
		gap: 16px;
		padding: 20px 0;
		border-top: 1px solid var(--rule);
	}
	.steps .num {
		font-family: var(--mono);
		font-size: 13px;
		font-weight: 600;
		color: var(--accent-text);
		padding-top: 4px;
	}
	.steps h3 {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 6px;
	}
	.steps p {
		font-size: 15px;
		color: var(--ink-2);
		line-height: 1.55;
	}
	.included li {
		position: relative;
		padding: 14px 0 14px 32px;
		border-top: 1px solid var(--rule);
		font-size: 16px;
		color: var(--ink-2);
		line-height: 1.5;
	}
	.included li::before {
		content: '✓';
		position: absolute;
		left: 0;
		top: 14px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 700;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			max-width: 560px;
			margin: 0 auto;
		}
		.how-grid {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}
	@media (max-width: 600px) {
		.compare,
		.gallery,
		.how {
			padding-left: 20px;
			padding-right: 20px;
		}
		.gallery {
			padding-top: 40px;
		}
		.how {
			padding-top: 72px;
		}
		.cmp th[scope='row'],
		.cmp th.lbl {
			width: 104px;
		}
	}
</style>
