---
/** Footer: one hairline with the business name and where it is, and the Instagram link if any. Nothing decorative. */
import type { PreviaData } from '../../data/previas/types';

interface Props {
	data: PreviaData;
}
const { name, location, instagram } = Astro.props.data;
const a = location.address;
---

<footer class='ft'>
	<div class='wrap'>
		<p>{name} · {a.district}, {a.city}</p>
		{
			instagram && (
				<a href={instagram} target='_blank' rel='noopener noreferrer'>
					Instagram
				</a>
			)
		}
	</div>
</footer>

<style>
	.ft {
		padding-block: 28px;
		border-top: 1px solid var(--line);
		font-size: 14px;
		color: var(--ink-2);
	}
	.ft .wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
	}
	.ft a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	/* Room for the floating WhatsApp button on phones. */
	@media (max-width: 780px) {
		.ft {
			padding-bottom: 96px;
		}
	}
</style>
