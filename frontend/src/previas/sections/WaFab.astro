---
/**
 * Floating WhatsApp button for previews (bottom-right corner), louder than the
 * core one: bigger, with two rings pulsing out of it, the glyph giving a small
 * nudge every few seconds, and (desktop only) the booking label sliding out
 * beside it a few seconds after load and on hover. Phones get the round button
 * alone, since the label would cover the text. Animations are transform/opacity only.
 * Reduced motion: no rings, no nudge, the label stays put.
 */
interface Props {
	href: string;
	label: string;
}
const { href, label } = Astro.props;
---

<a class='wafab' href={href} target='_blank' rel='noopener noreferrer' aria-label={label} data-wafab>
	<span class='wafab-label' aria-hidden='true'>{label}</span>
	<span class='wafab-btn'>
		<span class='wafab-ring' aria-hidden='true'></span>
		<span class='wafab-ring is-late' aria-hidden='true'></span>
		<svg class='wafab-glyph' viewBox='0 0 24 24' width='30' height='30' aria-hidden='true' fill='currentColor' focusable='false'>
			<path d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z'></path>
		</svg>
	</span>
</a>

<style>
	.wafab {
		position: fixed;
		right: 18px;
		bottom: 18px;
		z-index: 900;
		display: flex;
		align-items: center;
		gap: 10px;
		-webkit-tap-highlight-color: transparent;
	}
	.wafab-btn {
		position: relative;
		width: 64px;
		height: 64px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #25d366;
		color: #fff;
		box-shadow:
			0 14px 30px -10px rgba(18, 140, 70, 0.75),
			0 3px 8px rgba(0, 0, 0, 0.18);
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.wafab:hover .wafab-btn {
		transform: scale(1.08);
	}
	.wafab:focus-visible {
		outline: none;
	}
	.wafab:focus-visible .wafab-btn {
		box-shadow:
			0 0 0 3px #fff,
			0 0 0 6px #128c46;
	}
	/* Two rings pulsing out, half a beat apart. */
	.wafab-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid #25d366;
		animation: wafab-ring 2.4s cubic-bezier(0.2, 0.6, 0.35, 1) infinite;
	}
	.wafab-ring.is-late {
		animation-delay: 1.2s;
	}
	@keyframes wafab-ring {
		0% {
			transform: scale(1);
			opacity: 0.85;
		}
		100% {
			transform: scale(1.75);
			opacity: 0;
		}
	}
	/* The glyph gives a short nudge every few seconds. */
	.wafab-glyph {
		position: relative;
		animation: wafab-nudge 4s ease-in-out infinite;
	}
	@keyframes wafab-nudge {
		0%,
		76%,
		100% {
			transform: rotate(0deg);
		}
		80% {
			transform: rotate(-16deg) scale(1.08);
		}
		86% {
			transform: rotate(13deg) scale(1.08);
		}
		92% {
			transform: rotate(-6deg);
		}
	}
	/* The label slides out beside the button. */
	.wafab-label {
		padding: 11px 16px;
		border-radius: 999px;
		background: #fff;
		color: #0b5d2c;
		font-family: var(--text, system-ui, sans-serif);
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.35);
		opacity: 0;
		transform: translateX(14px) scale(0.92);
		transform-origin: right center;
		pointer-events: none;
		transition:
			opacity 0.35s ease,
			transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.wafab:hover .wafab-label,
	.wafab:focus-visible .wafab-label,
	.wafab.is-shown .wafab-label {
		opacity: 1;
		transform: none;
	}
	/* Phones: just the round button. The label would sit over the text. */
	@media (max-width: 780px) {
		.wafab {
			right: 14px;
			bottom: 14px;
		}
		.wafab-label {
			display: none;
		}
		.wafab-btn {
			width: 58px;
			height: 58px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.wafab-ring {
			display: none;
		}
		.wafab-glyph {
			animation: none;
		}
		.wafab-label {
			transition: none;
		}
	}
</style>

<script>
	// Show the label once, a few seconds after load, then tuck it back in.
	const fab = document.querySelector<HTMLElement>('[data-wafab]');
	if (fab) {
		window.setTimeout(() => {
			fab.classList.add('is-shown');
			window.setTimeout(() => fab.classList.remove('is-shown'), 5000);
		}, 2500);
	}
</script>
