---
/**
 * Services: a portrait in an arch on one side, the one-word label and the
 * names in very large serif on hairlines on the other. Hovering (or focusing)
 * a name swaps the photo in the arch for another of the client's photos, with
 * a crossfade; on touch screens the arch just shows its own photo.
 */
import { Image } from 'astro:assets';
import type { PreviaPhoto } from '../photos';

interface Props {
	label: string;
	items: string[];
	photo: PreviaPhoto | null;
	/** Photos shown while a name is hovered, one per item (cycled). */
	swap?: PreviaPhoto[];
	/** Business name, for the alt text. */
	name: string;
}
const { label, items, photo, swap = [], name } = Astro.props;
const base = photo ?? swap[0] ?? null;
---

<section class='services sec' id='servicos' aria-labelledby='services-title' data-svc>
	<div class:list={['wrap', 'svc-grid', { 'has-photo': !!base }]}>
		{
			base && (
				<figure class='svc-photo'>
					<Image src={base.src} alt={`${label}, ${name}`} width={base.width} height={base.height} widths={[480, 640, 800, 960]} sizes='(max-width: 900px) 70vw, 34vw' quality={72} loading='lazy' decoding='async' />
					{swap.length > 0 &&
						items.map((_, i) => {
							const p = swap[i % swap.length] as PreviaPhoto;
							return <Image class='svc-swap' data-svc-img={i} src={p.src} alt='' width={p.width} height={p.height} widths={[480, 640, 800]} sizes='34vw' quality={72} loading='lazy' decoding='async' />;
						})}
				</figure>
			)
		}
		<div class='svc-copy'>
			<h2 id='services-title' class='display sec-title'>{label}</h2>
			<ul class='svc-list'>
				{
					items.map((item, i) => (
						<li class='display' data-svc-item={i} tabindex='0'>
							{item}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.services {
		background: var(--bg-2);
	}
	.svc-grid.has-photo {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(32px, 7vw, 120px);
		align-items: center;
	}
	.svc-photo {
		position: relative;
		margin: 0;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 999px 999px 0 0;
		background: var(--bg);
	}
	.svc-photo :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.svc-photo :global(.svc-swap) {
		opacity: 0;
		transform: scale(1.05);
		transition:
			opacity 0.5s ease,
			transform 0.9s var(--ease);
	}
	.svc-photo :global(.svc-swap.is-on) {
		opacity: 1;
		transform: none;
	}
	.svc-list {
		list-style: none;
		border-top: 1px solid var(--line);
	}
	.svc-list li {
		padding-block: clamp(18px, 2.6vw, 34px);
		border-bottom: 1px solid var(--line);
		font-size: clamp(28px, 3.9vw, 60px);
		line-height: 1.04;
		letter-spacing: -0.02em;
		transition:
			padding-left 0.5s var(--ease),
			color 0.3s;
	}
	.svc-list li:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}
	@media (hover: hover) {
		.svc-list li:hover,
		.svc-list li:focus-visible {
			padding-left: 18px;
			color: var(--accent-text);
		}
	}
	@media (max-width: 900px) {
		.svc-grid.has-photo {
			grid-template-columns: minmax(0, 1fr);
		}
		.svc-photo {
			width: 70%;
		}
	}
</style>

<script>
	// Hover or focus a service name → its photo fades into the arch.
	document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
		const imgs = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-img]'));
		if (!imgs.length) return;
		const show = (i: number | null) => imgs.forEach((img) => img.classList.toggle('is-on', img.dataset.svcImg === String(i)));
		root.querySelectorAll<HTMLElement>('[data-svc-item]').forEach((li) => {
			const i = Number(li.dataset.svcItem);
			li.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && show(i));
			li.addEventListener('pointerleave', () => show(null));
			li.addEventListener('focus', () => show(i));
			li.addEventListener('blur', () => show(null));
		});
	});
</script>
