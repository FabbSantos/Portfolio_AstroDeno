---
/**
 * Services, from the client's own posts (public/previas/<slug>/servico-N.*,
 * texts in data.servicePosts), as an index of names that open one at a time.
 *
 * Desktop: the index on the left (the open service shows its description and a
 * bar that fills while it is on) and the matching post large on the right,
 * crossfading. It advances on its own once on screen and pauses on hover.
 *
 * Phones: no side viewer. Each service opens with its own post inside it,
 * right above its text, and the page scrolls so the opened name sits at the
 * top (under the ribbon and topbar, via html's scroll-padding-top). No
 * autoplay there: content moving under a thumb is not a feature.
 *
 * Without posts, the section shows the label and the general list.
 */
import { Image } from 'astro:assets';
import type { PreviaData } from '../../data/previas/types';
import type { PreviaPhoto } from '../photos';

interface Props {
	label: string;
	items: string[];
	posts: PreviaPhoto[];
	texts?: PreviaData['servicePosts'];
	/** Business name, for the alt text. */
	name: string;
}
const { label, items, posts, texts = [], name } = Astro.props;
const entries = posts.map((p, i) => ({ photo: p, title: texts[i]?.title ?? `${label} ${i + 1}`, text: texts[i]?.text ?? '' }));
---

<section class='services sec' id='servicos' aria-labelledby='services-title' data-svc>
	<div class:list={['wrap', 'svc-grid', { 'has-posts': entries.length > 0 }]}>
		<div class='svc-side'>
			<h2 id='services-title' class='display sec-title'>{label}</h2>
			{entries.length === 0 && <p class='svc-line'>{items.join(' · ')}</p>}
			{
				entries.length > 0 && (
					<ul class='svc-index'>
						{entries.map((e, i) => (
							<li class:list={['svc-item', { 'is-on': i === 0 }]} data-svc-item={i}>
								<button type='button' class='svc-tab' id={`svc-tab-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`svc-body-${i}`} data-svc-tab>
									<span class='svc-name display'>{e.title}</span>
								</button>
								<div class='svc-body' id={`svc-body-${i}`}>
									<div class='svc-body-in'>
										<figure class='svc-mimg'>
											<Image src={e.photo.src} alt={`${e.title}, ${name}`} width={e.photo.width} height={e.photo.height} widths={[480, 640, 800]} sizes='calc(100vw - 40px)' quality={78} loading='lazy' decoding='async' />
										</figure>
										{e.text && <p class='svc-desc'>{e.text}</p>}
									</div>
								</div>
								<span class='svc-bar' aria-hidden='true'>
									<i />
								</span>
							</li>
						))}
					</ul>
				)
			}
		</div>
		{
			entries.length > 0 && (
				<div class='svc-view'>
					{entries.map((e, i) => (
						<figure class:list={['svc-slide', { 'is-on': i === 0 }]} data-svc-slide aria-hidden={i === 0 ? undefined : 'true'}>
							<Image src={e.photo.src} alt={`${e.title}, ${name}`} width={e.photo.width} height={e.photo.height} widths={[480, 640, 800, 960]} sizes='44vw' quality={78} loading='lazy' decoding='async' />
						</figure>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.services {
		--t: 6s;
		background: var(--bg-2);
	}
	.svc-grid.has-posts {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(32px, 6vw, 96px);
		align-items: start;
	}
	.svc-line {
		font-size: 17px;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 44ch;
	}
	.svc-index {
		list-style: none;
		border-top: 1px solid var(--line);
	}
	.svc-item {
		position: relative;
		border-bottom: 1px solid var(--line);
	}
	.svc-tab {
		display: block;
		width: 100%;
		padding: 18px 0;
		border: 0;
		background: none;
		color: var(--ink);
		text-align: left;
		cursor: pointer;
	}
	.svc-tab:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}
	.svc-name {
		display: block;
		font-size: clamp(26px, 2.8vw, 40px);
		line-height: 1.06;
		letter-spacing: -0.02em;
		color: color-mix(in srgb, var(--ink) 72%, var(--bg));
		transition:
			color 0.3s,
			transform 0.5s var(--ease);
	}
	.svc-tab:hover .svc-name,
	.svc-item.is-on .svc-name {
		color: var(--ink);
	}
	.svc-item.is-on .svc-name {
		transform: translateX(10px);
	}
	/* Body (the post on phones + the description): closed rows have zero height. */
	.svc-body {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.6s var(--ease);
	}
	.svc-item.is-on .svc-body {
		grid-template-rows: 1fr;
	}
	/* Shut at once (phones, the service closing while another opens). */
	.svc-item.is-snap .svc-body {
		transition: none;
	}
	.svc-body-in {
		min-height: 0;
		overflow: hidden;
	}
	.svc-desc {
		max-width: 52ch;
		padding: 0 0 22px 10px;
		font-size: 16px;
		line-height: 1.55;
		color: var(--ink-2);
	}
	/* The post inside each service is for phones only. */
	.svc-mimg {
		display: none;
		margin: 0;
	}
	/* Time left on the open service, along its foot. */
	.svc-bar {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		overflow: hidden;
	}
	.svc-bar i {
		display: block;
		height: 100%;
		background: var(--accent-text);
		transform: scaleX(0);
		transform-origin: left;
	}
	.services:global(.is-running) .svc-item.is-on .svc-bar i {
		animation: svc-fill var(--t) linear both;
	}
	.services:global(.is-held) .svc-item.is-on .svc-bar i {
		animation-play-state: paused;
	}
	@keyframes svc-fill {
		to {
			transform: scaleX(1);
		}
	}

	/* ---- desktop viewer ---- */
	.svc-view {
		position: sticky;
		top: calc(var(--previa-ribbon, 0px) + 100px);
		aspect-ratio: 1;
		border-radius: 24px;
		overflow: hidden;
		background: var(--ink);
		box-shadow: 0 40px 70px -40px rgba(42, 31, 26, 0.6);
	}
	.svc-slide {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		transform: scale(1.04);
		transition:
			opacity 0.7s ease,
			transform 1.2s var(--ease);
	}
	.svc-slide.is-on {
		opacity: 1;
		transform: none;
	}
	.svc-slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ---- phones: the post inside each service, above its text ---- */
	@media (max-width: 900px) {
		.svc-grid.has-posts {
			grid-template-columns: minmax(0, 1fr);
		}
		.svc-view,
		.svc-bar {
			display: none;
		}
		.svc-mimg {
			display: block;
			aspect-ratio: 1;
			margin: 2px 0 18px;
			overflow: hidden;
			border-radius: 18px;
			background: var(--ink);
		}
		.svc-mimg :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.svc-desc {
			padding-left: 0;
		}
		.svc-item.is-on .svc-name {
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.svc-body,
		.svc-slide,
		.svc-name {
			transition: none;
		}
		.services:global(.is-running) .svc-item.is-on .svc-bar i {
			animation: none;
			transform: scaleX(1);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
		const items = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-item]'));
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-slide]'));
		const n = items.length;
		if (n === 0) return;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const phone = window.matchMedia('(max-width: 900px)');
		let at = 0;

		const restart = () => {
			root.classList.remove('is-running');
			void root.offsetWidth;
			// Autoplay drives the desktop viewer only.
			if (!reduced && !phone.matches && n > 1) root.classList.add('is-running');
		};
		/** Open service i (-1 closes all, phones only). */
		const show = (i: number) => {
			at = i < 0 ? -1 : (i + n) % n;
			items.forEach((el, k) => {
				const on = k === at;
				// On phones the one closing shuts at once, so the opened name is already
				// where it will stay when the page scrolls to it.
				if (phone.matches && !on && el.classList.contains('is-on')) {
					el.classList.add('is-snap');
					requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('is-snap')));
				}
				el.classList.toggle('is-on', on);
				el.querySelector('[data-svc-tab]')?.setAttribute('aria-expanded', String(on));
			});
			slides.forEach((s, k) => {
				s.classList.toggle('is-on', k === at);
				if (k === at) s.removeAttribute('aria-hidden');
				else s.setAttribute('aria-hidden', 'true');
			});
			restart();
		};
		root.addEventListener('animationend', (e) => {
			if ((e.target as HTMLElement).closest('.svc-bar')) show(at + 1);
		});
		items.forEach((el, k) =>
			el.querySelector('[data-svc-tab]')?.addEventListener('click', () => {
				if (!phone.matches) return show(k);
				// Phones: a tap on the open one closes it; any other opens and comes to the top.
				if (at === k) return show(-1);
				show(k);
				requestAnimationFrame(() => el.scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' }));
			}),
		);
		const grid = root.querySelector<HTMLElement>('.svc-grid') ?? root;
		const hold = () => root.classList.toggle('is-held', grid.matches(':hover') || document.hidden);
		grid.addEventListener('mouseenter', hold);
		grid.addEventListener('mouseleave', hold);
		document.addEventListener('visibilitychange', hold);
		phone.addEventListener('change', () => {
			if (at < 0) show(0);
			else restart();
		});
		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						restart();
						io.disconnect();
					}
				},
				{ threshold: 0.3 },
			);
			io.observe(grid);
		} else restart();
	});
</script>
