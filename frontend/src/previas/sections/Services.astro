---
/**
 * Services: the one-word label beside the list of services in large serif on
 * hairlines; under them, when the client has service posts
 * (public/previas/<slug>/servico-N.*), a carousel of those square posts that
 * bleeds to the right edge, with the same controls as the work carousel.
 * The text printed on each post is repeated in its alt text.
 */
import { Image } from 'astro:assets';
import type { PreviaPhoto } from '../photos';
import CarouselNav from './CarouselNav.astro';

interface Props {
	label: string;
	items: string[];
	posts: PreviaPhoto[];
	/** Alt text for each post (what is written on it), by position. */
	postAlts?: string[];
	/** Business name, for alt text fallback. */
	name: string;
}
const { label, items, posts, postAlts = [], name } = Astro.props;
---

<section class='services sec' id='servicos' aria-labelledby='services-title' data-carousel>
	<div class='wrap svc-grid'>
		<div class='svc-head'>
			<h2 id='services-title' class='display sec-title'>{label}</h2>
			{posts.length > 0 && <CarouselNav total={posts.length} />}
		</div>
		<ul class='svc-list'>
			{items.map((item) => <li class='display'>{item}</li>)}
		</ul>
	</div>
	{
		posts.length > 0 && (
			<ul class='posts' data-carousel-track tabindex='0' aria-label={label}>
				{posts.map((p, i) => (
					<li class='post'>
						<Image src={p.src} alt={postAlts[i] ?? `${label} ${i + 1}, ${name}`} width={p.width} height={p.height} widths={[320, 480, 640, 800]} sizes='(max-width: 780px) 78vw, 30vw' quality={78} loading='lazy' decoding='async' draggable='false' />
					</li>
				))}
			</ul>
		)
	}
</section>

<style>
	.services {
		background: var(--bg-2);
	}
	.svc-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(24px, 6vw, 96px);
		align-items: start;
	}
	.svc-head {
		display: grid;
		gap: 28px;
		justify-items: start;
	}
	.svc-head :global(.sec-title) {
		margin-bottom: 0;
	}
	.svc-list {
		list-style: none;
		border-top: 1px solid var(--line);
	}
	.svc-list li {
		padding-block: clamp(18px, 2.4vw, 30px);
		border-bottom: 1px solid var(--line);
		font-size: clamp(28px, 3.6vw, 54px);
		line-height: 1.04;
		letter-spacing: -0.02em;
	}

	/* ---- service posts carousel ---- */
	.posts {
		--edge: max(var(--pad-x), calc((100vw - var(--wrap)) / 2 + var(--pad-x)));
		list-style: none;
		display: flex;
		gap: clamp(12px, 1.6vw, 24px);
		margin-top: clamp(48px, 6vw, 88px);
		padding-inline: var(--edge);
		scroll-padding-inline: var(--edge);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		cursor: grab;
	}
	.posts::-webkit-scrollbar {
		display: none;
	}
	.posts:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 4px;
	}
	.posts:global(.is-dragging) {
		cursor: grabbing;
		scroll-snap-type: none;
	}
	.post {
		flex: 0 0 clamp(260px, 30vw, 440px);
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 18px;
		background: var(--ink);
		scroll-snap-align: start;
		box-shadow: 0 30px 60px -36px rgba(42, 31, 26, 0.55);
	}
	.post :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}
	@media (max-width: 900px) {
		.svc-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.svc-head {
			display: flex;
			flex-wrap: wrap;
			align-items: end;
			justify-content: space-between;
			gap: 16px;
		}
		.svc-list {
			order: 2;
		}
		.post {
			flex-basis: 78vw;
		}
	}
</style>
