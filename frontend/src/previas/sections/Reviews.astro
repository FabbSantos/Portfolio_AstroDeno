---
/**
 * Google reviews, after the home's Testimonials marquee (components/home/
 * Testimonials.astro): quote cards drifting in two rows that move in opposite
 * directions on the deep colour block. Each card has the big quote mark, the
 * five stars, the client's words and the Google mark. The rows are filled by
 * repeating the quotes; only the first copy is exposed to assistive tech.
 * Hover pauses a row. Reduced motion: no animation, one static wrapped row.
 */
import type { PreviaData } from '../../data/previas/types';

interface Props {
	label: string;
	rating: PreviaData['rating'];
	quotes: string[];
}
const { label, rating, quotes } = Astro.props;
// Enough cards to fill a wide screen: the quotes repeated up to at least 6 per row.
const fill = (list: string[]) => Array.from({ length: Math.max(6, list.length) }, (_, i) => list[i % list.length] as string);
const rows = [
	{ items: fill(quotes), reverse: false },
	{ items: fill([...quotes].reverse()), reverse: true },
];
---

<section class='reviews' id='avaliacoes' aria-labelledby='reviews-title'>
	<div class='wrap rv-head'>
		<h2 id='reviews-title' class='display'>{label}</h2>
		<p class='rv-score'>
			<span class='rv-num display'>{rating.value}</span>
			<span class='rv-meta'>
				<span class='rv-stars' aria-hidden='true'>★★★★★</span>
				<span>{rating.source} · {rating.count}</span>
			</span>
		</p>
	</div>

	<div class='marquee'>
		{
			rows.map((row, r) => (
				<div class:list={['mq-track', { reverse: row.reverse }]}>
					{[false, true].map((dup) => (
						<ul class='mq-row' aria-hidden={dup || r > 0 ? 'true' : undefined}>
							{row.items.map((q, i) => (
								<li class='card' aria-hidden={!dup && r === 0 && i >= quotes.length ? 'true' : undefined}>
									<figure>
										<span class='q display' aria-hidden='true'>
											“
										</span>
										<blockquote class='display'>{q}</blockquote>
										<figcaption>
											<svg class='g' viewBox='0 0 48 48' aria-hidden='true' focusable='false'>
												<path fill='#EA4335' d='M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z' />
												<path fill='#4285F4' d='M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z' />
												<path fill='#FBBC05' d='M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z' />
												<path fill='#34A853' d='M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z' />
											</svg>
											<span class='src'>{rating.source}</span>
											<span class='stars' aria-hidden='true'>
												★★★★★
											</span>
										</figcaption>
									</figure>
								</li>
							))}
						</ul>
					))}
				</div>
			))
		}
	</div>
</section>

<style>
	.reviews {
		background: var(--accent-text);
		color: #fff;
		padding-block: clamp(72px, 9vw, 128px);
		overflow: hidden;
	}
	.rv-head {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 20px 48px;
		margin-bottom: clamp(36px, 5vw, 64px);
	}
	h2 {
		font-size: clamp(40px, 5.4vw, 80px);
	}
	.rv-score {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.rv-num {
		font-size: clamp(64px, 8vw, 120px);
		line-height: 0.86;
	}
	.rv-meta {
		display: grid;
		gap: 4px;
		font-size: 15px;
	}
	.rv-stars {
		font-size: 20px;
		letter-spacing: 0.14em;
		color: var(--accent-2);
	}

	/* ---- marquee (same mechanics as the home's testimonials) ---- */
	.marquee {
		--gap: 20px;
		--fade: 80px;
		display: grid;
		gap: var(--gap);
		user-select: none;
		-webkit-mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
		mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
	}
	.mq-track {
		display: flex;
		gap: var(--gap);
		width: max-content;
	}
	.mq-row {
		list-style: none;
		flex-shrink: 0;
		display: flex;
		align-items: stretch;
		gap: var(--gap);
		animation: rv-slide 56s linear infinite;
	}
	.mq-track.reverse .mq-row {
		animation-direction: reverse;
		animation-duration: 68s;
	}
	.mq-track:hover .mq-row {
		animation-play-state: paused;
	}
	@keyframes rv-slide {
		to {
			transform: translateX(calc(-100% - var(--gap)));
		}
	}

	.card {
		width: clamp(300px, 30vw, 420px);
		display: flex;
	}
	.card figure {
		flex: 1;
		margin: 0;
		display: flex;
		flex-direction: column;
		padding: 28px 28px 22px;
		border-radius: 20px;
		background: var(--bg);
		color: var(--ink);
		box-shadow: 0 24px 50px -30px rgba(0, 0, 0, 0.55);
		transition: transform 0.5s var(--ease);
	}
	.card figure:hover {
		transform: translateY(-6px);
	}
	.q {
		display: block;
		height: 38px;
		font-size: 84px;
		line-height: 0.9;
		color: var(--accent-text);
	}
	blockquote {
		flex: 1;
		margin: 10px 0 0;
		font-size: clamp(24px, 2.3vw, 32px);
		font-weight: 400;
		line-height: 1.16;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	figcaption {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 26px;
		padding-top: 16px;
		border-top: 1px solid var(--line);
		font-size: 14px;
		font-weight: 600;
	}
	.g {
		flex: none;
		width: 22px;
		height: 22px;
	}
	.stars {
		margin-left: auto;
		letter-spacing: 0.12em;
		color: var(--accent-text);
	}

	@media (max-width: 780px) {
		.marquee {
			--gap: 14px;
			--fade: 28px;
		}
		.card {
			width: 280px;
		}
		.card figure {
			padding: 22px 22px 18px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee {
			-webkit-mask-image: none;
			mask-image: none;
			padding-inline: var(--pad-x);
		}
		.mq-track {
			width: auto;
		}
		.mq-row {
			animation: none;
			flex-wrap: wrap;
		}
		.mq-track.reverse,
		.mq-row[aria-hidden='true'],
		.card[aria-hidden='true'] {
			display: none;
		}
	}
</style>
