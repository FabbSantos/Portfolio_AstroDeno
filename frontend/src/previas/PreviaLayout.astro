---
/**
 * Layout for client previews (/previas/<slug>): tokens + fonts only, like the
 * template demos. Always `noindex, nofollow` (the page shows a real business
 * that has not approved it yet) and kept out of the sitemap in astro.config.
 * A thin fixed ribbon credits the preview; the page is pushed down by its height.
 * Open Graph tags give the link a proper card when it is sent on WhatsApp:
 * title, description and, when the preview has photos, the image from og.jpg.ts.
 * Umami counts the visit and the taps (scripts/previa-analytics.ts), and the
 * owner gets an e-mail when the preview is opened (api/previa-aberta.ts).
 */
import '../styles/base.css';
import PreviaRibbon from './PreviaRibbon.astro';
import UmamiLoader from '../components/site/UmamiLoader.astro';

interface Props {
	/** The preview's slug, for analytics. */
	slug: string;
	title: string;
	description: string;
	themeColor: string;
	/** Font files to preload (the display face). */
	preload?: readonly string[];
	/** Absolute URL of the page. */
	url: string;
	/** Absolute URL of the 1200×630 link preview image, if any. */
	ogImage?: string;
	/** Alt text for the link preview image. */
	ogImageAlt?: string;
}
const { slug, title, description, themeColor, preload = [], url, ogImage, ogImageAlt = title } = Astro.props;
---

<!doctype html>
<html lang='pt-BR' data-theme='light' data-previa={slug}>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width,initial-scale=1' />
		<title>{title}</title>
		<meta name='description' content={description} />
		<meta name='robots' content='noindex, nofollow' />
		<meta name='theme-color' content={themeColor} />
		<meta property='og:type' content='website' />
		<meta property='og:locale' content='pt_BR' />
		<meta property='og:site_name' content={title} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:url' content={url} />
		{
			ogImage && (
				<Fragment>
					<meta property='og:image' content={ogImage} />
					<meta property='og:image:type' content='image/jpeg' />
					<meta property='og:image:width' content='1200' />
					<meta property='og:image:height' content='630' />
					<meta property='og:image:alt' content={ogImageAlt} />
				</Fragment>
			)
		}
		<meta name='twitter:card' content={ogImage ? 'summary_large_image' : 'summary'} />
		{preload.map((href) => <link rel='preload' as='font' type='font/woff2' href={href} crossorigin />)}
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
		<UmamiLoader />
	</head>
	<body>
		<PreviaRibbon />
		<main id='main-content'>
			<slot />
		</main>
		<script>
			import { initPreviaAnalytics } from '../scripts/previa-analytics';
			initPreviaAnalytics();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--previa-ribbon: 30px;
	}
	body {
		padding-top: var(--previa-ribbon);
	}
	html {
		scroll-padding-top: calc(var(--previa-ribbon) + 84px);
	}
</style>
