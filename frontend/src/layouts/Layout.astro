---
/**
 * Site layout (portfolio pages). Template demos use DemoLayout instead.
 *
 * - Locale comes from the URL (Astro i18n). `lang`, hreflang, og:locale and
 *   canonical are all derived from it — nothing is swapped client-side.
 * - Fonts are self-hosted (@fontsource-variable), no render-blocking third party.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import '../styles/site.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import WhatsAppFab from '../components/site/WhatsAppFab.astro';
import { SITE } from '../data/site';
import { templates } from '../data/templates';
import { LOCALES, LANG_TAG, OG_LOCALE, localeOf, localePath, stripLocale, useT } from '../i18n';

interface Props {
	title: string;
	description: string;
	/** Keep crawlers out (demos, thank-you pages). */
	noindex?: boolean;
	/** Absolute or site-relative path to a 1200×630 image. */
	ogImage?: string;
	/** JSON-LD type override. Default: Person. */
	ogType?: 'website' | 'article';
}

const { title, description, noindex = false, ogImage = '/og.png', ogType = 'website' } = Astro.props;
const locale = localeOf(Astro);
const t = useT(locale);
const path = stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(localePath(locale, path), site).href;
const alternates = LOCALES.map((l) => ({ locale: l, href: new URL(localePath(l, path), site).href }));
const ogImageAbs = new URL(ogImage, site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE.name,
	url: site.href,
	email: `mailto:${SITE.email}`,
	jobTitle: locale === 'pt' ? 'Engenheiro de Software Sênior' : 'Senior Software Engineer',
	address: { '@type': 'PostalAddress', addressLocality: 'Rio de Janeiro', addressRegion: 'RJ', addressCountry: 'BR' },
	sameAs: [SITE.social.github, SITE.social.linkedin, SITE.social.instagram],
	knowsAbout: ['TypeScript', 'JavaScript', 'React', 'Vue', 'Next.js', 'Nuxt', 'Astro', 'Node.js', 'C#', 'AWS', 'LLM integration'],
	makesOffer: templates.map((tpl) => ({
		'@type': 'Offer',
		name: `${tpl.name} ${tpl.accent}`,
		url: new URL(localePath(locale, `/templates/${tpl.slug}`), site).href,
		priceCurrency: 'BRL',
		price: tpl.priceFrom,
		priceSpecification: { '@type': 'PriceSpecification', minPrice: tpl.priceFrom, priceCurrency: 'BRL' },
	})),
};
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width,initial-scale=1' />

		<title>{title}</title>
		<meta name='description' content={description} />
		<meta name='author' content={SITE.name} />
		{noindex && <meta name='robots' content='noindex,follow' />}
		<link rel='canonical' href={canonical} />
		{alternates.map((a) => <link rel='alternate' hreflang={LANG_TAG[a.locale]} href={a.href} />)}
		<link rel='alternate' hreflang='x-default' href={new URL(path, site).href} />

		<!-- Open Graph / LinkedIn / WhatsApp -->
		<meta property='og:type' content={ogType} />
		<meta property='og:url' content={canonical} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:image' content={ogImageAbs} />
		<meta property='og:image:width' content='1200' />
		<meta property='og:image:height' content='630' />
		<meta property='og:locale' content={OG_LOCALE[locale]} />
		{LOCALES.filter((l) => l !== locale).map((l) => <meta property='og:locale:alternate' content={OG_LOCALE[l]} />)}
		<meta property='og:site_name' content={t.meta.siteName} />

		<!-- Twitter -->
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={description} />
		<meta name='twitter:image' content={ogImageAbs} />

		<!-- Icons / manifest -->
		<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
		<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
		<link rel='manifest' href='/site.webmanifest' />
		<link rel='mask-icon' href='/safari-pinned-tab.svg' color='#FF5964' />
		<meta name='msapplication-TileColor' content='#FF5964' />
		<meta name='theme-color' content='#FBFBFD' />
		<meta name='generator' content={Astro.generator} />

		<!-- JS gate for scroll-reveal (content stays visible without JS) -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<!-- Vercel Web Analytics + Speed Insights: drop beacons when this document is
		     embedded in an iframe (template previews), so a home visit counts once. -->
		<script is:inline>
			(function () {
				let framed = false;
				try { framed = window.self !== window.top; } catch { framed = true; }
				if (!framed) return;
				window.speedInsightsBeforeSend = function () { return null; };
				window.va = window.va || function (...args) { (window.vaq = window.vaq || []).push(args); };
				window.va('beforeSend', function () { return null; });
			})();
		</script>

		<script type='application/ld+json' is:inline set:html={JSON.stringify(jsonLd)} />
	</head>

	<body>
		<a href='#main-content' class='skip-link'>{t.common.skip}</a>
		<slot />
		<WhatsAppFab />
		<SpeedInsights />
		<script>
			import { initSite } from '../scripts/site';
			initSite();
		</script>
	</body>
</html>
