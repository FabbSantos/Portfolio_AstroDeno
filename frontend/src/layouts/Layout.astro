---
/**
 * Site layout (portfolio pages). Template demos use DemoLayout instead.
 *
 * - Locale comes from the URL (Astro i18n). `lang`, hreflang, og:locale and
 *   canonical are all derived from it — nothing is swapped client-side.
 * - Fonts are self-hosted (@fontsource-variable), no render-blocking third party.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import '../styles/site.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import GoogleAdsTag from '../components/site/GoogleAdsTag.astro';
import LangRedirect from '../components/site/LangRedirect.astro';
import UmamiLoader from '../components/site/UmamiLoader.astro';
import WhatsAppFab from '../components/site/WhatsAppFab.astro';
import { PERSON_ID, SITE, whatsappUrl } from '../data/site';
import { servicePages } from '../data/servicePages';
import { TEMPLATE_PROMO, fullName, promoOn, promoPrice, templates } from '../data/templates';
import { LOCALES, LANG_TAG, OG_LOCALE, localeOf, localePath, pick, stripLocale, useT } from '../i18n';

interface Props {
	title: string;
	description: string;
	/** Keep crawlers out (demos, thank-you pages). */
	noindex?: boolean;
	/** Absolute or site-relative path to a 1200×630 image. */
	ogImage?: string;
	/** JSON-LD type override. Default: Person. */
	ogType?: 'website' | 'article';
	/** Extra JSON-LD blocks for this page (e.g. Service + FAQPage on a service page). */
	structuredData?: readonly Record<string, unknown>[];
	/** Pre-filled message for the floating WhatsApp button on this page. */
	whatsappMessage?: string;
}

const { title, description, noindex = false, ogImage = '/og.png', ogType = 'website', structuredData = [], whatsappMessage } = Astro.props;
const locale = localeOf(Astro);
const t = useT(locale);
const path = stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(localePath(locale, path), site).href;
const alternates = LOCALES.map((l) => ({ locale: l, href: new URL(localePath(l, path), site).href }));
const ogImageAbs = new URL(ogImage, site).href;

const waUrl = whatsappUrl(locale);
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	// Stable id: service pages point their provider here.
	'@id': PERSON_ID,
	name: SITE.name,
	url: site.href,
	email: `mailto:${SITE.email}`,
	...(SITE.whatsapp.number ? { telephone: SITE.whatsapp.number } : {}),
	...(waUrl ? { contactPoint: { '@type': 'ContactPoint', contactType: 'WhatsApp', url: waUrl, availableLanguage: ['pt-BR', 'en', 'es'], areaServed: 'BR' } } : {}),
	jobTitle: pick({ pt: 'Engenheiro de Software Sênior', en: 'Senior Software Engineer', es: 'Ingeniero de software sénior' }, locale),
	address: { '@type': 'PostalAddress', addressLocality: 'Rio de Janeiro', addressRegion: 'RJ', addressCountry: 'BR' },
	sameAs: [
		SITE.social.github,
		SITE.social.linkedin,
		SITE.social.instagram,
		// TODO(fab): link do Perfil da Empresa no Google, quando existir. Ex.: 'https://maps.app.goo.gl/...'
	],
	knowsAbout: ['TypeScript', 'JavaScript', 'React', 'Vue', 'Next.js', 'Nuxt', 'Astro', 'Node.js', 'C#', 'AWS', 'LLM integration'],
	// Premium templates are "sob consulta": offered, with no price.
	makesOffer: templates.map((tpl) => {
		const offer = { '@type': 'Offer', name: fullName(tpl), url: new URL(localePath(locale, `/templates/${tpl.slug}`), site).href };
		if (tpl.priceFrom === undefined) return offer;
		const promo = promoOn();
		const price = promo ? promoPrice(tpl.priceFrom) : tpl.priceFrom;
		return {
			...offer,
			priceCurrency: 'BRL',
			price,
			...(promo ? { priceValidUntil: TEMPLATE_PROMO.until } : {}),
			priceSpecification: { '@type': 'PriceSpecification', minPrice: price, priceCurrency: 'BRL' },
		};
	}),
};
// Service pages are offers too.
(jsonLd.makesOffer as Record<string, unknown>[]).push(
	...servicePages.map((sp) => ({
		'@type': 'Offer',
		name: pick(sp.name, locale),
		url: new URL(localePath(locale, `/servicos/${sp.slug}`), site).href,
		priceCurrency: 'BRL',
		price: sp.priceFrom,
		priceSpecification: { '@type': 'PriceSpecification', minPrice: sp.priceFrom, priceCurrency: 'BRL' },
	})),
);
// `<` escaped so no string can ever close the script tag.
const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width,initial-scale=1' />
		{!noindex && <LangRedirect />}
		<!-- Template promo: the page is built ahead of time, so after its last day (São Paulo)
		     the browser swaps the promo prices for the full ones (.promo-only / .promo-off-only). -->
		<script is:inline define:vars={{ promoUntil: TEMPLATE_PROMO.until }}>
			try {
				if (new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date()) > promoUntil) document.documentElement.classList.add('promo-over');
			} catch {
				/* old browser: keep what was built */
			}
		</script>

		<title>{title}</title>
		<meta name='description' content={description} />
		<meta name='author' content={SITE.name} />
		{noindex && <meta name='robots' content='noindex,follow' />}
		<link rel='canonical' href={canonical} />
		{alternates.map((a) => <link rel='alternate' hreflang={LANG_TAG[a.locale]} href={a.href} />)}
		<link rel='alternate' hreflang='x-default' href={new URL(localePath('pt', path), site).href} />

		<!-- Open Graph / LinkedIn / WhatsApp -->
		<meta property='og:type' content={ogType} />
		<meta property='og:url' content={canonical} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:image' content={ogImageAbs} />
		<meta property='og:image:width' content='1200' />
		<meta property='og:image:height' content='630' />
		<meta property='og:locale' content={OG_LOCALE[locale]} />
		{LOCALES.filter((l) => l !== locale).map((l) => <meta property='og:locale:alternate' content={OG_LOCALE[l]} />)}
		<meta property='og:site_name' content={t.meta.siteName} />

		<!-- Twitter -->
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={description} />
		<meta name='twitter:image' content={ogImageAbs} />

		<!-- Icons / manifest -->
		<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
		<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
		<link rel='manifest' href='/site.webmanifest' />
		<link rel='mask-icon' href='/safari-pinned-tab.svg' color='#FF5964' />
		<meta name='msapplication-TileColor' content='#FF5964' />
		<meta name='theme-color' content='#FBFBFD' />
		<meta name='generator' content={Astro.generator} />

		<!-- JS gate for scroll-reveal (content stays visible without JS) + the stored theme,
		     applied before the first paint so a dark visitor never sees a light flash. -->
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				const t = localStorage.getItem('theme');
				if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
			} catch {}
		</script>

		<!-- Vercel Web Analytics + Speed Insights: drop beacons when this document is
		     embedded in an iframe (template previews), so a home visit counts once. -->
		<script is:inline>
			(function () {
				let framed = false;
				try { framed = window.self !== window.top; } catch { framed = true; }
				if (!framed) return;
				window.speedInsightsBeforeSend = function () { return null; };
				window.va = window.va || function (...args) { (window.vaq = window.vaq || []).push(args); };
				window.va('beforeSend', function () { return null; });
			})();
		</script>

		<UmamiLoader />
		<GoogleAdsTag />

		<script type='application/ld+json' is:inline set:html={ldJson(jsonLd)} />
		{structuredData.map((block) => <script type='application/ld+json' is:inline set:html={ldJson(block)} />)}
	</head>

	<body>
		<a href='#main-content' class='skip-link'>{t.common.skip}</a>
		<slot />
		<WhatsAppFab message={whatsappMessage} />
		<SpeedInsights />
		<script>
			import { initSite } from '../scripts/site';
			initSite();
		</script>
	</body>
</html>
