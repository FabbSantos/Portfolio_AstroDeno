# Email (Resend) — required for /api/contact. Set in Vercel project settings too.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form leads are delivered (defaults to SITE.leadInbox in src/data/site.ts)
CONTACT_TO=

# Optional: Cloudflare Turnstile (free bot check). Leave both empty to disable.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
